<Project>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'QS3D.BricsCAD.V25'">
    <QS3DV25ReferenceSnapshotDir>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)qs3d-v25-compile-reference-snapshot</QS3DV25ReferenceSnapshotDir>
    <QS3DV25ReferenceStatePath>$(QS3DV25ReferenceSnapshotDir)\reference-state.json</QS3DV25ReferenceStatePath>
  </PropertyGroup>

  <Target Name="QS3DBindStableV25CompileReferences"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(MSBuildProjectName)' == 'QS3D.BricsCAD.V25' and '$(DesignTimeBuild)' != 'true' and '$(BRICSCAD_V25_DIR)' != ''">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\snapshot-v25-compile-references.ps1&quot; -BricsCadDir &quot;$(BRICSCAD_V25_DIR)&quot; -SnapshotDir &quot;$(QS3DV25ReferenceSnapshotDir)&quot; -StatePath &quot;$(QS3DV25ReferenceStatePath)&quot;" />
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\assert-v25-compile-reference-state.ps1&quot; -StatePath &quot;$(QS3DV25ReferenceStatePath)&quot; -BricsCadDir &quot;$(QS3DV25ReferenceSnapshotDir)&quot;" />
    <ItemGroup>
      <Reference Update="BrxMgd">
        <HintPath>$(QS3DV25ReferenceSnapshotDir)\BrxMgd.dll</HintPath>
      </Reference>
      <Reference Update="TD_Mgd">
        <HintPath>$(QS3DV25ReferenceSnapshotDir)\TD_Mgd.dll</HintPath>
      </Reference>
      <Reference Update="TD_MgdBrep">
        <HintPath>$(QS3DV25ReferenceSnapshotDir)\TD_MgdBrep.dll</HintPath>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="QS3DRevalidateStableV25CompileReferences"
          AfterTargets="ResolveAssemblyReferences"
          Condition="'$(MSBuildProjectName)' == 'QS3D.BricsCAD.V25' and '$(DesignTimeBuild)' != 'true' and '$(BRICSCAD_V25_DIR)' != ''">
    <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)scripts\assert-v25-compile-reference-state.ps1&quot; -StatePath &quot;$(QS3DV25ReferenceStatePath)&quot; -BricsCadDir &quot;$(QS3DV25ReferenceSnapshotDir)&quot;" />
  </Target>
</Project>
