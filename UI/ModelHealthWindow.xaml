<Window x:Class="QS3D.BricsCAD.V25.UI.ModelHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Kiểm tra mô hình" Width="860" Height="560"
        MinWidth="700" MinHeight="440" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KIỂM TRA MÔ HÌNH" FontWeight="Bold" FontSize="18"/>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="HEALTH REVIEW" Foreground="{StaticResource LuxuryBrush}" FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Định vị" Style="{StaticResource AccentButton}"
                        Click="OnLocateClick" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="12,10">
            <DataGrid x:Name="IssueGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" MouseDoubleClick="OnGridDoubleClick" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mức" Binding="{Binding Severity}" Width="80"/>
                    <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="140"/>
                    <DataGridTextColumn Header="Cấu kiện" Binding="{Binding ElementId}" Width="150"/>
                    <DataGridTextColumn Header="Nội dung" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="11,7">
            <DockPanel>
                <Border Background="{StaticResource WarningBrush}" CornerRadius="5" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Text="Nhấp đúp một lỗi hoặc dùng Định vị để chọn cấu kiện tương ứng trong DWG."
                           Style="{StaticResource Caption}"/>
                <TextBlock DockPanel.Dock="Right" Text="ISSUE → CAD LOCATE" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>