<Window x:Class="QS3D.BricsCAD.V25.UI.RecognitionWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QS3D • Nhận dạng cấu kiện" Height="620" Width="1120" MinHeight="480" MinWidth="820" WindowStartupLocation="CenterScreen"><Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources><Grid Background="{StaticResource Bg0Brush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,0,0,1"><DockPanel><StackPanel><TextBlock Text="NHẬN DẠNG THEO QUY TẮC" FontWeight="Bold" FontSize="15"/><TextBlock Text="Layer + text/block + loại entity • kết quả độ tin cậy thấp hoặc gần nhau cần kiểm tra" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Định vị" Click="OnLocateClick"/><Button Content="Áp dụng dòng chọn" Click="OnApplyClick"/><Button Content="Áp dụng chắc chắn" Style="{StaticResource AccentButton}" Click="OnApplyConfidentClick"/></StackPanel></DockPanel></Border><DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Extended" MouseDoubleClick="OnGridDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="85"/><DataGridTextColumn Header="Entity" Binding="{Binding Snapshot.EntityType}" Width="100"/><DataGridTextColumn Header="Layer" Binding="{Binding Snapshot.Layer}" Width="180"/><DataGridTextColumn Header="Gợi ý" Binding="{Binding SuggestedCategory}" Width="130"/><DataGridTextColumn Header="Độ tin cậy" Binding="{Binding Confidence, StringFormat=P0}" Width="95"/><DataGridTextColumn Header="Biên" Binding="{Binding Margin, StringFormat=P0}" Width="70"/><DataGridCheckBoxColumn Header="Cần duyệt" Binding="{Binding RequiresReview}" Width="75"/><DataGridTextColumn Header="Căn cứ" Binding="{Binding Evidence}" Width="*"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0"><TextBlock x:Name="Status" TextTrimming="CharacterEllipsis"/></Border></Grid></Window>
