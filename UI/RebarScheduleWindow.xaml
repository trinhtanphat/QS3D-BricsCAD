<Window x:Class="QS3D.BricsCAD.V25.UI.RebarScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QS3D • Bảng thống kê cốt thép (BBS)" Height="650" Width="1120" WindowStartupLocation="CenterScreen" Background="#17191C"><Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources><Grid Background="{StaticResource Bg0Brush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,0,0,1"><DockPanel><StackPanel><TextBlock Text="BẢNG THỐNG KÊ CỐT THÉP" FontWeight="Bold" FontSize="15"/><TextBlock Text="Review bar mark • notation • cutting length • weight trước khi xuất" Foreground="{StaticResource MutedBrush}"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Locate" Click="OnLocateClick"/><Button Content="Xuất XLSX" Style="{StaticResource AccentButton}" Click="OnExportClick"/></StackPanel></DockPanel></Border><DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="OnGridDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Element" Binding="{Binding ElementId}" Width="135"/><DataGridTextColumn Header="Mark" Binding="{Binding BarMark}" Width="100"/><DataGridTextColumn Header="Shape" Binding="{Binding ShapeCode}" Width="70"/><DataGridTextColumn Header="Notation" Binding="{Binding Notation}" Width="95"/><DataGridTextColumn Header="Ø (mm)" Binding="{Binding DiameterMm, StringFormat=0.#}" Width="70"/><DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="55"/><DataGridTextColumn Header="L cắt (m)" Binding="{Binding CuttingLengthM, StringFormat=0.###}" Width="85"/><DataGridTextColumn Header="ΣL (m)" Binding="{Binding TotalLengthM, StringFormat=0.###}" Width="85"/><DataGridTextColumn Header="kg/m" Binding="{Binding UnitWeightKgM, StringFormat=0.###}" Width="75"/><DataGridTextColumn Header="Net kg" Binding="{Binding NetWeightKg, StringFormat=0.###}" Width="80"/><DataGridTextColumn Header="Waste %" Binding="{Binding WastePercent, StringFormat=0.##}" Width="75"/><DataGridTextColumn Header="Σ kg" Binding="{Binding TotalWeightKg, StringFormat=0.###}" Width="90"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0"><TextBlock x:Name="Totals" FontWeight="SemiBold"/></Border></Grid></Window>
