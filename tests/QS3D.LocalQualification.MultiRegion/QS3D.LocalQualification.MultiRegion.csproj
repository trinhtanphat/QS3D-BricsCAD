<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>QS3D.LocalQualification.MultiRegion</AssemblyName>
    <RootNamespace>QS3D.LocalQualification.MultiRegion</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ProductDir Condition="'$(ProductDir)' == ''"></ProductDir>
    <BricsCadDir Condition="'$(BricsCadDir)' == ''">$(BRICSCAD_V25_DIR)</BricsCadDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="QS3D.Core"><HintPath>$(ProductDir)\QS3D.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="QS3D.BricsCAD.V25"><HintPath>$(ProductDir)\QS3D.BricsCAD.V25.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BrxMgd"><HintPath>$(BricsCadDir)\BrxMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TD_Mgd"><HintPath>$(BricsCadDir)\TD_Mgd.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateLocal005References" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ProductDir)' == '' Or !Exists('$(ProductDir)\QS3D.BricsCAD.V25.dll') Or !Exists('$(ProductDir)\QS3D.Core.dll')" Text="ProductDir must name the exact frozen V25 product payload." />
    <Error Condition="'$(BricsCadDir)' == '' Or !Exists('$(BricsCadDir)\BrxMgd.dll') Or !Exists('$(BricsCadDir)\TD_Mgd.dll')" Text="BricsCadDir must name a BricsCAD V25 installation with managed references." />
  </Target>
</Project>
