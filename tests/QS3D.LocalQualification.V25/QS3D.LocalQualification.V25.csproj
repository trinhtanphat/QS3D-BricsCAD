<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>QS3D.LocalQualification.V25</AssemblyName>
    <RootNamespace>QS3D.LocalQualification.V25</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ProductDir Condition="'$(ProductDir)' == ''"></ProductDir>
    <BricsCadDir Condition="'$(BricsCadDir)' == ''">$(BRICSCAD_V25_DIR)</BricsCadDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- The test runner must also build on local V25 hosts that have the .NET
         runtime but not the machine-wide developer targeting pack. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="QS3D.Core"><HintPath>$(ProductDir)\QS3D.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="QS3D.BricsCAD.V25"><HintPath>$(ProductDir)\QS3D.BricsCAD.V25.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BrxMgd"><HintPath>$(BricsCadDir)\BrxMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TD_Mgd"><HintPath>$(BricsCadDir)\TD_Mgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TD_MgdBrep"><HintPath>$(BricsCadDir)\TD_MgdBrep.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateLocal022References" BeforeTargets="ResolveReferences">
    <Error Condition="'$(ProductDir)' == ''" Text="ProductDir must name the frozen published V25 package directory." />
    <Error Condition="!Exists('$(ProductDir)\QS3D.BricsCAD.V25.dll')" Text="ProductDir must contain the published QS3D.BricsCAD.V25.dll." />
    <Error Condition="!Exists('$(ProductDir)\QS3D.Core.dll')" Text="ProductDir must contain the published QS3D.Core.dll." />
    <Error Condition="'$(BricsCadDir)' == '' Or !Exists('$(BricsCadDir)\BrxMgd.dll') Or !Exists('$(BricsCadDir)\TD_Mgd.dll') Or !Exists('$(BricsCadDir)\TD_MgdBrep.dll')" Text="BricsCadDir must name a BricsCAD V25 installation with managed references." />
  </Target>
</Project>
