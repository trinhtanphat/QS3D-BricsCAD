<Window x:Class="QS3D.BricsCAD.V25.UI.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Nhật ký thay đổi" Height="560" Width="980"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="NHẬT KÝ THAY ĐỔI" FontWeight="Bold" FontSize="15"/>
                    <TextBlock Text="Theo dõi thao tác project, template và workflow QS3D" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="260" Margin="10,0,0,0" ToolTip="Tìm action, element, nội dung, actor hoặc correlation id" TextChanged="OnSearchChanged"/>
            </DockPanel>
        </Border>
        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thời gian UTC" Binding="{Binding Utc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
                <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="150"/>
                <DataGridTextColumn Header="Element" Binding="{Binding ElementId}" Width="120"/>
                <DataGridTextColumn Header="Nội dung" Binding="{Binding Detail}" Width="*" MinWidth="240"/>
                <DataGridTextColumn Header="Người thực hiện" Binding="{Binding Actor}" Width="120"/>
                <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="135"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="8">
            <DockPanel><TextBlock x:Name="Summary" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="Mới nhất hiển thị trước" Style="{StaticResource Caption}"/></DockPanel>
        </Border>
    </Grid>
</Window>
