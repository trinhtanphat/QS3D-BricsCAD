<Window x:Class="QS3D.BricsCAD.V25.UI.WallQuantityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Khối lượng Tường"
        Width="1260" Height="820"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>
            <Style x:Key="FactLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,10,4"/>
            </Style>
            <Style x:Key="FactValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="1.45*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KHỐI LƯỢNG TƯỜNG" FontSize="18" FontWeight="Bold"/>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="WALL TAKEOFF" Foreground="{StaticResource LuxuryBrush}" FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tường • vách • tường kính • trụ tường — dữ liệu QS3D hiện hành"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoRevealCheck" Content="Bám 3D" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="Khi bật, chọn một dòng Tường sẽ revalidate semantic hiện hành rồi chọn + zoom đối tượng tương ứng trong View 3D."/>
                    <Button Content="Định vị 3D" Click="OnLocateClick" Style="{StaticResource DenseButton}"
                            ToolTip="Revalidate dòng Tường hiện hành rồi chọn và zoom đối tượng CAD nguồn."/>
                    <Button Content="Tính lại" Click="OnRefreshClick" Style="{StaticResource DenseButton}" Margin="8,0,0,0"/>
                    <Button Content="Xuất Excel" Click="OnExportClick" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" Margin="12,10,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tìm tường" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                             ToolTip="Tìm theo tên, ID, tầng, loại, family, vật liệu hoặc handle"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tầng" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="FloorFilter" SelectionChanged="OnFilterChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Loại tường" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CategoryFilter" DisplayMemberPath="Label" SelectionChanged="OnFilterChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="12,10,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="260"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource Bg1Brush}" Padding="10,8" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="DANH SÁCH TƯỜNG" FontWeight="SemiBold"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="7" Padding="7,1">
                                <TextBlock x:Name="WallCountBadge" Text="0" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ListBox x:Name="WallList" Grid.Row="1" SelectionChanged="OnWallSelectionChanged"
                             MouseDoubleClick="OnWallListDoubleClick"
                             BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderStrongBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11">
                                            <Run Text="{Binding Floor}"/><Run Text="  •  "/><Run Text="{Binding CategoryLabel}"/>
                                        </TextBlock>
                                        <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding LengthText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding NetText}" Foreground="{StaticResource LuxuryBrush}"
                                                       FontWeight="SemiBold" FontSize="11"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="THÔNG TIN TƯỜNG ĐANG CHỌN" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedSubtitleText" Text="Chọn một dòng ở danh sách hoặc bảng chi tiết"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="8,2" VerticalAlignment="Top">
                            <TextBlock x:Name="SelectedCategoryBadge" Text="—" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SelectedNameText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Tầng" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="SelectedFloorText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Element ID" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SelectedIdText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Family" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" x:Name="SelectedFamilyText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Vật liệu" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SelectedMaterialText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="CAD Handle" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" x:Name="SelectedHandleText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Chiều dài" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SelectedLengthText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Chiều dày" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="3" Grid.Column="4" x:Name="SelectedThicknessText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Chiều cao" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SelectedHeightText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="Cốp pha" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="4" Grid.Column="4" x:Name="SelectedFormworkText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="BT gộp" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SelectedGrossText" Text="—" Style="{StaticResource FactValue}"/>
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="Trừ / BT còn" Style="{StaticResource FactLabel}"/>
                        <TextBlock Grid.Row="5" Grid.Column="4" x:Name="SelectedNetBreakdownText" Text="—" Style="{StaticResource FactValue}"/>
                    </Grid>

                    <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" CornerRadius="5" Padding="10"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                        <TextBlock x:Name="SelectedNoteText"
                                   Text="Khối lượng dùng pipeline chung. Bật Bám 3D để chọn một dòng và đối chiếu trực tiếp trong View 3D."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="12,10,12,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{StaticResource Bg1Brush}" Padding="10,8" BorderThickness="0,0,0,1">
                    <TextBlock Text="BẢNG CHI TIẾT KHỐI LƯỢNG TƯỜNG" FontWeight="SemiBold"/>
                </Border>
                <DataGrid x:Name="TakeoffGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" SelectionMode="Single" SelectionChanged="OnGridSelectionChanged"
                          MouseDoubleClick="OnGridDoubleClick"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" FrozenColumnCount="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="42"/>
                        <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="95"/>
                        <DataGridTextColumn Header="Loại" Binding="{Binding CategoryLabel}" Width="125"/>
                        <DataGridTextColumn Header="Tên tường" Binding="{Binding DisplayName}" Width="170"/>
                        <DataGridTextColumn Header="Vật liệu" Binding="{Binding Material}" Width="125"/>
                        <DataGridTextColumn Header="Dài (m)" Binding="{Binding LengthM, StringFormat=0.###}" Width="80"/>
                        <DataGridTextColumn Header="Dày (mm)" Binding="{Binding ThicknessMm, StringFormat=0.###}" Width="85"/>
                        <DataGridTextColumn Header="Cao (m)" Binding="{Binding HeightM, StringFormat=0.###}" Width="80"/>
                        <DataGridTextColumn Header="BT gộp (m³)" Binding="{Binding GrossConcreteM3, StringFormat=0.###}" Width="95"/>
                        <DataGridTextColumn Header="Trừ giao/mở (m³)" Binding="{Binding DeductionM3, StringFormat=0.###}" Width="110"/>
                        <DataGridTextColumn Header="BT còn (m³)" Binding="{Binding NetConcreteM3, StringFormat=0.###}" Width="95"/>
                        <DataGridTextColumn Header="Cốp pha (m²)" Binding="{Binding FormworkM2, StringFormat=0.###}" Width="95"/>
                        <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource Bg1Brush}" Padding="11,7" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SuccessBrush}" CornerRadius="5" Width="7" Height="7" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SL " Style="{StaticResource Caption}" Margin="12,0,3,0"/><TextBlock x:Name="TotalCountText" Text="0" FontWeight="SemiBold"/>
                    <TextBlock Text=" • Dài " Style="{StaticResource Caption}" Margin="8,0,3,0"/><TextBlock x:Name="TotalLengthText" Text="0 m" FontWeight="SemiBold"/>
                    <TextBlock Text=" • BT gộp " Style="{StaticResource Caption}" Margin="8,0,3,0"/><TextBlock x:Name="TotalGrossText" Text="0 m³" FontWeight="SemiBold"/>
                    <TextBlock Text=" • Trừ " Style="{StaticResource Caption}" Margin="8,0,3,0"/><TextBlock x:Name="TotalDeductionText" Text="0 m³" FontWeight="SemiBold"/>
                    <TextBlock Text=" • BT còn " Style="{StaticResource Caption}" Margin="8,0,3,0"/><TextBlock x:Name="TotalNetText" Text="0 m³" FontWeight="SemiBold"/>
                    <TextBlock Text=" • Cốp pha " Style="{StaticResource Caption}" Margin="8,0,3,0"/><TextBlock x:Name="TotalFormworkText" Text="0 m²" FontWeight="SemiBold"/>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>