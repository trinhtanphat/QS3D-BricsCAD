<Window x:Class="QS3D.BricsCAD.V25.UI.CurtainWallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Vách Kính" Width="680" Height="720"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VÁCH KÍNH / CURTAIN WALL" FontWeight="Bold" FontSize="19"/>
                    <TextBlock Text="Family • panel grid • khung • kính net • Excel" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Margin="8,0,0,0" Click="OnRefreshClick"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="FAMILY" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="FamilyCombo" DisplayMemberPath="Name" SelectionChanged="OnFamilyChanged" Margin="0,0,0,12"/>

                <TextBlock Text="HÌNH HỌC HOST" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Bề dày kính (m)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ThicknessBox"/></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Chiều cao vách (m)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="HeightBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Vật liệu kính" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="GlassMaterialBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Vật liệu khung" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="FrameMaterialBox"/></StackPanel>
                </Grid>

                <TextBlock Text="PANEL GRID" Style="{StaticResource SectionLabel}"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Panel rộng tối đa (m)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MaxPanelWidthBox"/></StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Panel cao tối đa (m)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MaxPanelHeightBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Khung biên (m)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="PerimeterFrameBox"/></StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Mullion đứng (m)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MullionBox"/></StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Transom ngang (m)" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="TransomBox"/></StackPanel>
                    <Button Grid.Row="2" Grid.Column="1" Content="Lưu Family" Style="{StaticResource AccentButton}" Margin="8,18,0,0" Click="OnSaveClick"/>
                </Grid>

                <TextBlock Text="TỔNG HỢP HIỆN TẠI" Style="{StaticResource SectionLabel}"/>
                <Border Background="{StaticResource Bg1Brush}" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Vách" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="WallCountText" FontSize="20" FontWeight="SemiBold" Text="0"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Panel" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PanelCountText" FontSize="20" FontWeight="SemiBold" Text="0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Kính net" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="GlassAreaText" FontSize="20" FontWeight="SemiBold" Text="0 m²"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Khung" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="FrameLengthText" FontSize="20" FontWeight="SemiBold" Text="0 m"/></StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="WORKFLOW" Style="{StaticResource SectionLabel}"/>
                <WrapPanel>
                    <Button Content="1. Bóc Vách Kính" Tag="QS3DGLASSWALL" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="2. Tính lại" Click="OnRecalculateClick"/>
                    <Button Content="3. Vẽ/Cập nhật 3D host" Tag="QS3DBUILD3D" Click="OnCommandClick"/>
                    <Button Content="4. Auto Host Cửa/Lỗ" Tag="QS3DAUTOLINKHOSTS" Click="OnCommandClick"/>
                    <Button Content="5. Khoét thẳng" Tag="QS3DCUTOPENINGS" Click="OnCommandClick"/>
                    <Button Content="6. Khoét cong" Tag="QS3DCUTOPENINGSCURVED" Click="OnCommandClick"/>
                    <Button Content="7. Xuất Excel" Tag="QS3DCURTAINXLSX" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                </WrapPanel>
                <TextBlock Text="Native curtain panel/frame solids là bước riêng sau semantic schedule; nút 3D hiện dựng host Vách Kính theo source Tường KT hiện có." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
