<Window x:Class="QS3D.BricsCAD.V25.UI.ModelHealthWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QS3D — Model Health" Width="820" Height="520" WindowStartupLocation="CenterOwner"><Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources><Grid Background="{StaticResource Bg0Brush}"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{StaticResource Bg1Brush}" BorderThickness="0,0,0,1" Padding="10"><DockPanel><StackPanel><TextBlock Text="MODEL HEALTH" FontWeight="Bold" FontSize="15"/><TextBlock x:Name="SummaryText" Style="{StaticResource Caption}"/></StackPanel><Button DockPanel.Dock="Right" Content="Locate" Style="{StaticResource AccentButton}" Click="OnLocateClick"/></DockPanel></Border><DataGrid Grid.Row="1" x:Name="IssueGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="OnGridDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Mức" Binding="{Binding Severity}" Width="80"/><DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="140"/><DataGridTextColumn Header="Element" Binding="{Binding ElementId}" Width="150"/><DataGridTextColumn Header="Nội dung" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="8"><TextBlock Text="Double-click một lỗi để Locate cấu kiện trong DWG." Style="{StaticResource Caption}"/></Border></Grid></Window>
