<Window x:Class="QS3D.BricsCAD.V25.UI.StartCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Start Center" Width="1120" Height="780"
        MinWidth="920" MinHeight="640" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="StartCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="12"/>
            </Style>
            <Style x:Key="StartActionButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Padding" Value="9,5"/>
            </Style>
            <Style x:Key="StartAccentButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="Margin" Value="0,0,6,6"/>
                <Setter Property="Padding" Value="9,5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1Brush}" Padding="18,14"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="QS3D" FontSize="22" FontWeight="Bold"/>
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" Padding="8,3" Margin="9,0,0,0">
                            <TextBlock Text="START CENTER" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Project • Direct Draw • Quantity • Review • Diagnostics"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="PREMIUM CAD WORKFLOW" Foreground="{StaticResource LuxuryBrush}"
                               FontWeight="SemiBold" FontSize="10"/>
                    <TextBlock Text="BricsCAD V25 vẫn là CAD host" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource StartCard}" Margin="14,12,14,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BẢN VẼ / PROJECT HIỆN TẠI" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DrawingNameText" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock x:Name="DrawingPathText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ProjectNameText" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    <TextBlock x:Name="ProjectSummaryText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock x:Name="ProjectStatusText" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Width="360">
                    <TextBlock Text="FILE &amp; PROJECT ACTIONS" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,7,0,0">
                        <Button Content="Bản vẽ mới" Style="{StaticResource StartActionButton}" Click="OnNewDrawingClick"/>
                        <Button Content="Mở DWG…" Style="{StaticResource StartActionButton}" Click="OnOpenDrawingClick"/>
                        <Button Content="Lưu DWG" Style="{StaticResource StartActionButton}" Click="OnSaveDrawingClick"/>
                        <Button Content="Lưu thành…" Style="{StaticResource StartActionButton}" Click="OnSaveAsDrawingClick"/>
                        <Button Content="Workspace" Tag="QS3D" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                        <Button Content="Project Tools" Tag="QS3DPROJECTTOOLS" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                        <Button x:Name="SaveProjectButton" Content="Lưu QS3D" Tag="QS3DSAVE"
                                Style="{StaticResource StartAccentButton}" Click="OnAllowlistedCommandClick"/>
                        <Button Content="Refresh" Style="{StaticResource StartActionButton}" Click="OnRefreshClick"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="14,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource StartCard}" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="QUICK WORKFLOW" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,7,0,0">
                            <Button Content="Family / Type" Tag="QS3DFAMILIES" Style="{StaticResource StartAccentButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Vẽ Tường" Tag="QS3DDRAWWALL" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Vẽ Dầm" Tag="QS3DDRAWBEAM" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Vẽ Cột" Tag="QS3DDRAWCOLUMN" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Vẽ Sàn" Tag="QS3DDRAWSLAB" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Vẽ Cửa" Tag="QS3DDRAWDOOR" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Vẽ Cửa Sổ" Tag="QS3DDRAWWINDOW" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Vẽ Tương Tự" Tag="QS3DCREATESIMILAR" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="BQ" Tag="QS3DBQ" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Health All" Tag="QS3DHEALTHALL" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" MinHeight="32" ToolTip="Tìm theo tên, command, nhóm hoặc từ khóa" TextChanged="OnSearchChanged"/>
                    <ComboBox x:Name="GroupFilter" Grid.Column="1" Margin="8,0,0,0" SelectionChanged="OnGroupChanged"/>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource StartCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="COMMAND LAUNCHER" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CommandCountText" Grid.Column="1" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                        <ListBox x:Name="CommandList" Grid.Row="1" Margin="0,8" MouseDoubleClick="OnCommandDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1" Margin="8,0">
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Command}" Foreground="{StaticResource AccentHoverBrush}" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Group}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2">
                            <Button Content="Chạy lệnh" Style="{StaticResource StartAccentButton}" Click="OnRunSelectedCommandClick"/>
                            <Button Content="★ Ghim / Bỏ ghim" Style="{StaticResource StartActionButton}" Click="OnToggleFavoriteClick"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StartCard}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="★ FAVORITES" FontWeight="SemiBold"/>
                            <ListBox x:Name="FavoriteList" Grid.Row="1" Margin="0,6,0,0" DisplayMemberPath="Title" MouseDoubleClick="OnFavoriteDoubleClick"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource StartCard}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="GẦN ĐÂY" FontWeight="SemiBold"/>
                            <ListBox x:Name="RecentCommandList" Grid.Row="1" Margin="0,6,0,0" DisplayMemberPath="Title" MouseDoubleClick="OnRecentCommandDoubleClick"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource StartCard}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="RECENT PROJECTS / DWG" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Ghim, mở nhanh, phát hiện file thiếu. Remove/Clear không xóa DWG."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <ListBox x:Name="RecentProjectList" Grid.Row="2" MouseDoubleClick="OnRecentProjectDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,5">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StateLabel}" Foreground="{StaticResource LuxuryBrush}" FontSize="9"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Path}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button Content="Mở" Style="{StaticResource StartAccentButton}" Click="OnOpenRecentProjectClick"/>
                            <Button Content="Ghim / Bỏ ghim" Style="{StaticResource StartActionButton}" Click="OnToggleRecentProjectPinClick"/>
                            <Button Content="Bỏ khỏi lịch sử" Style="{StaticResource StartActionButton}" Click="OnRemoveRecentProjectClick"/>
                            <Button Content="Clear all" Style="{StaticResource StartActionButton}" Click="OnClearRecentProjectsClick"/>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource StartCard}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="REVIEW &amp; DIAGNOSTICS" FontWeight="SemiBold"/>
                        <WrapPanel Margin="0,7,0,0">
                            <Button Content="Rule Preview" Tag="QS3DRULEPREVIEW" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Regen Preview" Tag="QS3DREGENPREVIEW" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Model Health" Tag="QS3DHEALTHALL" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Diagnostic Summary" Tag="QS3DDIAGSUMMARY" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                            <Button Content="Release Check" Tag="QS3DRELEASECHECK" Style="{StaticResource StartActionButton}" Click="OnAllowlistedCommandClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" Padding="14,8"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Sẵn sàng." Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Ctrl+F: tìm • Enter: chạy • Esc: đóng" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
            </Grid>
        </Border>
    </Grid>
</Window>