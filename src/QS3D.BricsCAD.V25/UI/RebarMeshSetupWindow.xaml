<Window x:Class="QS3D.BricsCAD.V25.UI.RebarMeshSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Thiết lập lưới cốt thép" Height="500" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize" Background="#17191C">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ContextText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Grid.Row="1" Text="QS3D chỉ dựng geometry từ thông số explicit. Cửa sổ này không tính toán hay đề xuất thiết kế kết cấu." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,14"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Direction1Label" VerticalAlignment="Center"/>
            <TextBox x:Name="Direction1Text" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Direction2Label" VerticalAlignment="Center"/>
            <TextBox x:Name="Direction2Text" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Cover (m)" VerticalAlignment="Center"/>
            <TextBox x:Name="CoverText" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Face(s)" VerticalAlignment="Center"/>
            <ComboBox x:Name="FacesCombo" Grid.Column="1"/>
        </Grid>
        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <CheckBox x:Name="ClosestToFaceCheck" Content="Phương 1 nằm gần mặt bê tông hơn phương 2"/>
            <TextBlock Text="Notation phải là một nhóm count hoặc spacing, ví dụ cú pháp dự án hỗ trợ như D10@200 hoặc 20D10. Native mesh hiện yêu cầu hai phương cùng đường kính." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            <TextBlock x:Name="ValidationText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="7" Margin="0,14,0,0" LastChildFill="False">
            <Button Content="Hủy" Width="100" Click="OnCancel"/>
            <Button Content="Lưu thông số" Width="130" Margin="10,0,0,0" Style="{StaticResource AccentButton}" Click="OnSave"/>
        </DockPanel>
    </Grid>
</Window>
