<Window x:Class="QS3D.BricsCAD.V25.UI.RebarMeshSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Thiết lập lưới cốt thép" Height="540" Width="600"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="CanMinimize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="MeshFieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ContextText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                    <Border Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="EXPLICIT INPUT" Foreground="{StaticResource LuxuryBrush}"
                                   FontWeight="SemiBold" FontSize="9"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="QS3D chỉ dựng geometry từ thông số explicit. Cửa sổ này không tính toán hay đề xuất thiết kế kết cấu."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <Border Style="{StaticResource Card}" Padding="11" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="LƯỚI CỐT THÉP" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Direction1Label" Style="{StaticResource MeshFieldLabel}"/>
                            <TextBox x:Name="Direction1Text" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="Direction2Label" Style="{StaticResource MeshFieldLabel}"/>
                            <TextBox x:Name="Direction2Text" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Cover (m)" Style="{StaticResource MeshFieldLabel}"/>
                            <TextBox x:Name="CoverText" Grid.Column="1"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Face(s)" Style="{StaticResource MeshFieldLabel}"/>
                            <ComboBox x:Name="FacesCombo" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="11">
                    <StackPanel>
                        <TextBlock Text="THỨ TỰ / VALIDATION" Style="{StaticResource PanelTitle}"/>
                        <CheckBox x:Name="ClosestToFaceCheck" Content="Phương 1 nằm gần mặt bê tông hơn phương 2"/>
                        <TextBlock Text="Mỗi phương dùng một notation độc lập (count hoặc spacing), ví dụ D10@200 hoặc 20D10. Hai phương có thể dùng đường kính, số lượng hoặc bước khác nhau; native planner sẽ validate từng phương và envelope/cover trước khi tạo 3D."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,9,0,0">
                            <TextBlock x:Name="ValidationText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="11,8" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Không tự suy luận thiết kế kết cấu"
                           Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button DockPanel.Dock="Right" Content="Hủy" Width="100" Click="OnCancel"/>
                <Button DockPanel.Dock="Right" Content="Lưu thông số" Width="130"
                        Margin="8,0,0,0" Style="{StaticResource AccentButton}" Click="OnSave"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>