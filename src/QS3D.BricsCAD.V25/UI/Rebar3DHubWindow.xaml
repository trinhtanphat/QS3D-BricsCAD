<Window x:Class="QS3D.BricsCAD.V25.UI.Rebar3DHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Cốt thép 3D" Height="720" Width="760"
        MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="RebarCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="RebarCommand" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
            <Style x:Key="RebarAccentCommand" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CỐT THÉP 3D" FontWeight="Bold" FontSize="18"/>
                    <Border Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                        <TextBlock Text="REBAR WORKFLOW" Foreground="{StaticResource LuxuryBrush}"
                                   FontWeight="SemiBold" FontSize="9"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="BBS • thanh dọc • đai • lưới sàn/vách/móng • health"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource RebarCard}">
                        <StackPanel>
                            <TextBlock Text="CỘT / DẦM" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="Generated solids có ownership/stale metadata riêng."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <Button Content="Thanh dọc cột 3D" Tag="QS3DREBAR3D" Style="{StaticResource RebarAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Đai cột 3D" Tag="QS3DREBARTIES3D" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Thép dọc dầm 3D" Tag="QS3DBEAMREBAR3D" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Đai dầm 3D" Tag="QS3DREBARSTIRRUP3D" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RebarCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="SÀN / VÁCH / MÓNG" Style="{StaticResource PanelTitle}"/>
                            <Button Content="Thiết lập lưới cho selection" Tag="QS3DREBARMESHSETUP" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Lưới thép sàn X/Y 3D" Tag="QS3DSLABREBAR3D" Style="{StaticResource RebarAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Lưới thép vách H/V 3D" Tag="QS3DWALLREBAR3D" Style="{StaticResource RebarAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Lưới thép móng X/Y 3D" Tag="QS3DFOUNDATIONREBAR3D" Style="{StaticResource RebarAccentCommand}" Click="OnCommandClick"/>
                            <TextBlock Text="Sàn và Móng dùng cùng RectangularSlabMeshPlanner. Hai phương có thể dùng diameter, count hoặc spacing độc lập."
                                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource RebarCard}">
                        <StackPanel>
                            <TextBlock Text="BBS SHAPE / BẢNG" Style="{StaticResource PanelTitle}"/>
                            <Button Content="Cốt thép theo BBS shape 3D" Tag="QS3DREBAR3DSHAPE" Style="{StaticResource RebarAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Xem BBS" Tag="QS3DBBSVIEW" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Xuất BBS Excel" Tag="QS3DBBS" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Xuất BBS CSV" Tag="QS3DBBSCSV" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource RebarCard}" Margin="0">
                        <StackPanel>
                            <Grid x:Name="RebarHubHealthHeaderGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="HEALTH"
                                           Style="{StaticResource PanelTitle}"
                                           MinWidth="0"
                                           Margin="0,0,8,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="FAIL-CLOSED"
                                           Foreground="{StaticResource LuxuryBrush}"
                                           FontSize="9" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </Grid>
                            <Button Content="Health toàn mô hình" Tag="QS3DHEALTHALL" Style="{StaticResource RebarAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Health toàn bộ cốt thép" Tag="QS3DREBARHEALTHALL" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Health lưới thép móng" Tag="QS3DFOUNDATIONREBARHEALTH" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Health đai cột" Tag="QS3DREBARTIEHEALTH" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Health đai dầm" Tag="QS3DREBARSTIRRUPHEALTH" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                            <Button Content="Health BBS shape" Tag="QS3DREBARSHAPEHEALTH" Style="{StaticResource RebarCommand}" Click="OnCommandClick"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="11,7" BorderThickness="0,1,0,0">
            <Grid x:Name="RebarHubStatusGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource WarningBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Chọn cấu kiện semantic/source CAD trước khi chạy lệnh tạo hình học."
                           Foreground="{StaticResource MutedBrush}"
                           MinWidth="0"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2"
                           Text="EXPLICIT REBAR INPUTS • NATIVE 3D"
                           Style="{StaticResource Caption}"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
