<Window x:Class="QS3D.BricsCAD.V25.UI.CurtainWallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Vách Kính" Width="740" Height="780"
        MinWidth="660" MinHeight="620"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CurtainMetric" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VÁCH KÍNH / CURTAIN WALL" FontWeight="Bold" FontSize="18"/>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="CURTAIN SYSTEM" Foreground="{StaticResource LuxuryBrush}" FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Family • panel grid • khung 3D • kính net • Excel"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Click="OnRefreshClick"
                        Style="{StaticResource DenseButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <Border Style="{StaticResource Card}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="FAMILY / HOST" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Family" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="FamilyCombo" DisplayMemberPath="Name" SelectionChanged="OnFamilyChanged" Margin="0,0,0,9"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Bề dày kính (m)" Style="{StaticResource Caption}"/><TextBox x:Name="ThicknessBox"/></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Chiều cao vách (m)" Style="{StaticResource Caption}"/><TextBox x:Name="HeightBox"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Vật liệu kính" Style="{StaticResource Caption}"/><TextBox x:Name="GlassMaterialBox"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Vật liệu khung" Style="{StaticResource Caption}"/><TextBox x:Name="FrameMaterialBox"/></StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="PANEL / FRAME GRID" Style="{StaticResource PanelTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Panel rộng tối đa (m)" Style="{StaticResource Caption}"/><TextBox x:Name="MaxPanelWidthBox"/></StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Panel cao tối đa (m)" Style="{StaticResource Caption}"/><TextBox x:Name="MaxPanelHeightBox"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Khung biên (m)" Style="{StaticResource Caption}"/><TextBox x:Name="PerimeterFrameBox"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Mullion đứng (m)" Style="{StaticResource Caption}"/><TextBox x:Name="MullionBox"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,8"><TextBlock Text="Transom ngang (m)" Style="{StaticResource Caption}"/><TextBox x:Name="TransomBox"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,8"><TextBlock Text="Độ sâu khung 3D (m)" Style="{StaticResource Caption}"/><TextBox x:Name="FrameDepthBox"/></StackPanel>
                            <Button Grid.Row="3" Grid.ColumnSpan="2" Content="Lưu Family + Regenerate"
                                    Style="{StaticResource AccentButton}" Margin="0,4,0,0" Click="OnSaveClick"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="10" CornerRadius="5" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="TỔNG HỢP HIỆN TẠI" Style="{StaticResource PanelTitle}" Margin="0"/>
                            <TextBlock DockPanel.Dock="Right" Text="LIVE SCHEDULE"
                                       Foreground="{StaticResource LuxuryBrush}" FontSize="9" FontWeight="SemiBold"/>
                        </DockPanel>
                        <Grid Margin="-3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CurtainMetric}"><StackPanel><TextBlock Text="VÁCH" Style="{StaticResource Caption}"/><TextBlock x:Name="WallCountText" FontSize="18" FontWeight="SemiBold" Text="0" Foreground="{StaticResource AccentHoverBrush}" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource CurtainMetric}"><StackPanel><TextBlock Text="PANEL" Style="{StaticResource Caption}"/><TextBlock x:Name="PanelCountText" FontSize="18" FontWeight="SemiBold" Text="0" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource CurtainMetric}"><StackPanel><TextBlock Text="KÍNH NET" Style="{StaticResource Caption}"/><TextBlock x:Name="GlassAreaText" FontSize="18" FontWeight="SemiBold" Text="0 m²" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource CurtainMetric}"><StackPanel><TextBlock Text="KHUNG" Style="{StaticResource Caption}"/><TextBlock x:Name="FrameLengthText" FontSize="18" FontWeight="SemiBold" Text="0 m" Margin="0,2,0,0"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="10" CornerRadius="5">
                    <StackPanel>
                        <TextBlock Text="WORKFLOW" Style="{StaticResource PanelTitle}"/>
                        <WrapPanel>
                            <Button Content="1. Bóc Vách Kính" Tag="QS3DGLASSWALL" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                            <Button Content="2. Tính lại" Click="OnRecalculateClick"/>
                            <Button Content="3. Dựng host 3D" Tag="QS3DBUILD3D" Click="OnCommandClick"/>
                            <Button Content="4. Dựng mullion/transom 3D" Tag="QS3DCURTAINFRAMES3D" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                            <Button Content="5. Health khung" Tag="QS3DCURTAINFRAMEHEALTH" Click="OnCommandClick"/>
                            <Button Content="6. Auto Host Cửa/Lỗ" Tag="QS3DAUTOLINKHOSTS" Click="OnCommandClick"/>
                            <Button Content="7. Khoét thẳng" Tag="QS3DCUTOPENINGS" Click="OnCommandClick"/>
                            <Button Content="8. Khoét cong" Tag="QS3DCUTOPENINGSCURVED" Click="OnCommandClick"/>
                            <Button Content="9. Xuất Excel" Tag="QS3DCURTAINXLSX" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                        </WrapPanel>
                        <TextBlock Text="Khung 3D hiện hỗ trợ GlassWall semantic có source LINE nằm ngang. Open/curved POLYLINE vẫn dùng host 3D chung cho tới khi Gate V25 chứng minh frame sweep theo curve."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="11,7" BorderThickness="0,1,0,0">
            <Grid x:Name="CurtainWallStatusGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource WarningBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Sẵn sàng"
                           MinWidth="0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Text="CURVE FRAME = V25 GATE"
                           HorizontalAlignment="Right" TextWrapping="NoWrap"
                           Style="{StaticResource Caption}" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>