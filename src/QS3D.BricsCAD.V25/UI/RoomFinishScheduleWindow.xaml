<Window x:Class="QS3D.BricsCAD.V25.UI.RoomFinishScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • HT_Phòng" Width="1120" Height="700"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="14" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="HT_PHÒNG SCHEDULE" FontSize="19" FontWeight="Bold"/><TextBlock Text="Sàn • chống thấm • chân tường • tường • trần" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                <WrapPanel Grid.Column="1"><Button Content="Làm mới" Click="OnRefreshClick"/><Button Content="Xuất Excel" Style="{StaticResource AccentButton}" Click="OnExportClick" Margin="8,0,0,0"/></WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource Bg1Brush}" Padding="10" Margin="12,10,12,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="OnSearchChanged" ToolTip="Tìm phòng, tầng, loại hoàn thiện, family, material..."/>
                <Grid Grid.Column="1" Margin="14,0,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="Nhóm" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="GroupCountText" Text="0" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Finish elements" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ElementCountText" Text="0" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Dài" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="LengthText" Text="0 m" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Diện tích" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="AreaText" Text="0 m²" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Grid>
        </Border>
        <DataGrid x:Name="ScheduleGrid" Grid.Row="2" Margin="12,10,12,10" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="110"/>
                <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="150"/>
                <DataGridTextColumn Header="Loại hoàn thiện" Binding="{Binding Category}" Width="125"/>
                <DataGridTextColumn Header="Family / Loại" Binding="{Binding FamilyName}" Width="170"/>
                <DataGridTextColumn Header="Vật liệu" Binding="{Binding Material}" Width="130"/>
                <DataGridTextColumn Header="Đơn vị" Binding="{Binding UnitHint}" Width="70"/>
                <DataGridTextColumn Header="SL" Binding="{Binding Count}" Width="55"/>
                <DataGridTextColumn Header="KL chính" Binding="{Binding PrimaryQuantity, StringFormat=0.###}" Width="85"/>
                <DataGridTextColumn Header="Dài" Binding="{Binding LengthM, StringFormat=0.###}" Width="75"/>
                <DataGridTextColumn Header="Diện tích" Binding="{Binding AreaM2, StringFormat=0.###}" Width="85"/>
                <DataGridTextColumn Header="Room IDs" Binding="{Binding RoomIdsText}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
