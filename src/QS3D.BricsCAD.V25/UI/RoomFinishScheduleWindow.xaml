<Window x:Class="QS3D.BricsCAD.V25.UI.RoomFinishScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • HT_Phòng" Width="1160" Height="720"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="FinishMetric" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="3,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HT_PHÒNG SCHEDULE" FontSize="18" FontWeight="Bold"/>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="ROOM FINISH" Foreground="{StaticResource LuxuryBrush}" FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Sàn • chống thấm • chân tường • tường • trần"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource DenseButton}"/>
                    <Button Content="Xuất Excel" Style="{StaticResource AccentButton}" Click="OnExportClick" Margin="8,0,0,0"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="9" Margin="12,10,12,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Tìm trong HT_Phòng" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                             ToolTip="Tìm phòng, tầng, loại hoàn thiện, family, material..."/>
                </StackPanel>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource FinishMetric}"><StackPanel><TextBlock Text="NHÓM" Style="{StaticResource Caption}"/><TextBlock x:Name="GroupCountText" Text="0" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource AccentHoverBrush}" Margin="0,2,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource FinishMetric}"><StackPanel><TextBlock Text="FINISH ELEMENTS" Style="{StaticResource Caption}"/><TextBlock x:Name="ElementCountText" Text="0" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource FinishMetric}"><StackPanel><TextBlock Text="DÀI" Style="{StaticResource Caption}"/><TextBlock x:Name="LengthText" Text="0 m" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel></Border>
                    <Border Grid.Column="3" Style="{StaticResource FinishMetric}"><StackPanel><TextBlock Text="DIỆN TÍCH" Style="{StaticResource Caption}"/><TextBlock x:Name="AreaText" Text="0 m²" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel></Border>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="12,10">
            <DataGrid x:Name="ScheduleGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="110"/>
                    <DataGridTextColumn Header="Phòng" Binding="{Binding Room}" Width="150"/>
                    <DataGridTextColumn Header="Loại hoàn thiện" Binding="{Binding Category}" Width="125"/>
                    <DataGridTextColumn Header="Family / Loại" Binding="{Binding FamilyName}" Width="170"/>
                    <DataGridTextColumn Header="Vật liệu" Binding="{Binding Material}" Width="130"/>
                    <DataGridTextColumn Header="Đơn vị" Binding="{Binding UnitHint}" Width="70"/>
                    <DataGridTextColumn Header="SL" Binding="{Binding Count}" Width="55"/>
                    <DataGridTextColumn Header="KL chính" Binding="{Binding PrimaryQuantity, StringFormat=0.###}" Width="85"/>
                    <DataGridTextColumn Header="Dài" Binding="{Binding LengthM, StringFormat=0.###}" Width="75"/>
                    <DataGridTextColumn Header="Diện tích" Binding="{Binding AreaM2, StringFormat=0.###}" Width="85"/>
                    <DataGridTextColumn Header="Room IDs" Binding="{Binding RoomIdsText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" Padding="11,7" BorderThickness="0,1,0,0">
            <Grid x:Name="RoomFinishScheduleStatusGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource SuccessBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Sẵn sàng"
                           Foreground="{StaticResource MutedBrush}"
                           MinWidth="0"
                           TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2"
                           Text="ROOM FINISH SCHEDULE • EXPORT XLSX"
                           Style="{StaticResource Caption}"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>