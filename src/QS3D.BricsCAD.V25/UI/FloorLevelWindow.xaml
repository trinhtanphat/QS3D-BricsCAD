<Window x:Class="QS3D.BricsCAD.V25.UI.FloorLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D — Thiết lập dự án" Width="1180" Height="720"
        MinWidth="900" MinHeight="560"
        Background="#1E1E1E"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner"
        Loaded="OnBltSetupLoaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BltBg" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="BltBg2" Color="#202020"/>
            <SolidColorBrush x:Key="BltBg3" Color="#252525"/>
            <SolidColorBrush x:Key="BltBorder" Color="#3A3A3A"/>
            <SolidColorBrush x:Key="BltText" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="BltMuted" Color="#C7C7C7"/>
            <SolidColorBrush x:Key="BltBlue" Color="#1D78D5"/>
            <SolidColorBrush x:Key="BltBlue2" Color="#1C365F"/>

            <Style x:Key="BltToolbarButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource BltText}"/>
                <Setter Property="Background" Value="#242424"/>
                <Setter Property="BorderBrush" Value="#2D2D2D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Margin" Value="2,2,2,2"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#343434"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#151515"/></Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BltToolbarIcon" TargetType="Path">
                <Setter Property="Stroke" Value="#F3F3F3"/>
                <Setter Property="StrokeThickness" Value="1.8"/>
                <Setter Property="StrokeStartLineCap" Value="Square"/>
                <Setter Property="StrokeEndLineCap" Value="Square"/>
                <Setter Property="Stretch" Value="Uniform"/>
            </Style>

            <Style x:Key="BltNavButton" TargetType="Button">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="6,8"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#292929"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BltModePill" TargetType="Border">
                <Setter Property="Background" Value="#0D6EDE"/>
                <Setter Property="CornerRadius" Value="2"/>
                <Setter Property="Padding" Value="12,5"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="BltStatusToggle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F0F0F0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,17,0"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#242424"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#353535"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="7,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="#262626"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="#202020"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="MinHeight" Value="30"/>
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1"><Setter Property="Background" Value="#242424"/></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#252525"/>
                <Setter Property="BorderBrush" Value="#4A4A4A"/>
                <Setter Property="CaretBrush" Value="White"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BltBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#202020" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="181"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Stretch">
                    <Button Width="60" Style="{StaticResource BltNavButton}" Click="OnBltProjectInfoClick">
                        <TextBlock Text="Thông tin&#x0a;dự án" TextAlignment="Center"/>
                    </Button>
                    <Grid Width="60" Background="#242424">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                        <Button Grid.Row="0" Style="{StaticResource BltNavButton}" Click="OnBltFloorSettingsClick">
                            <TextBlock Text="Cài đặt&#x0a;tầng" TextAlignment="Center"/>
                        </Button>
                        <Border Grid.Row="1" Background="{StaticResource BltBlue}"/>
                    </Grid>
                    <Button Width="61" Style="{StaticResource BltNavButton}" Click="OnBltProjectPropertiesClick">
                        <TextBlock Text="Thuộc tính&#x0a;dự án" TextAlignment="Center"/>
                    </Button>
                </StackPanel>
                <TextBlock Grid.Column="0" Text="Dự án" Foreground="#DADADA" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1F1F1F" BorderBrush="#313131" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#222222" VerticalAlignment="Stretch">
                        <Button Style="{StaticResource BltToolbarButton}" Click="OnBltAddZoneClick">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0">
                                    <Path Style="{StaticResource BltToolbarIcon}" Data="M7,1 L7,13 M1,7 L13,7"/>
                                </Grid>
                                <TextBlock Text="Thêm" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BltToolbarButton}" Click="OnBltDeleteZoneClick">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,5,0">
                                    <Path Style="{StaticResource BltToolbarIcon}" Data="M2,4 L12,4 M5,2 L9,2 M4,4 L4.7,13 L9.3,13 L10,4 M6.2,6 L6.2,11 M8.2,6 L8.2,11"/>
                                </Grid>
                                <TextBlock Text="Xóa" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ListBox x:Name="BltZoneList" Grid.Row="1" Background="#202020" BorderThickness="0"
                             Foreground="White" SelectionChanged="OnBltZoneSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="7,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource BltBlue2}"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#29364A"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#1E1E1E">
                <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#222222" VerticalAlignment="Stretch">
                    <Button Style="{StaticResource BltToolbarButton}" Click="OnBltInsertFloorClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,5,0">
                                <Path Style="{StaticResource BltToolbarIcon}" Data="M7,1 L7,13 M1,7 L13,7"/>
                            </Grid>
                            <TextBlock Text="Chèn sàn" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BltToolbarButton}" Click="OnBltInsertFloorBelowClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,5,0">
                                <Path Style="{StaticResource BltToolbarIcon}" Data="M2,3 L12,3 M7,5 L7,12 M4.5,9.5 L7,12 L9.5,9.5"/>
                            </Grid>
                            <TextBlock Text="Chèn sàn xuống dưới" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BltToolbarButton}" Click="OnBltDeleteFloorClick">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,5,0">
                                <Path Style="{StaticResource BltToolbarIcon}" Data="M2,4 L12,4 M5,2 L9,2 M4,4 L4.7,13 L9.3,13 L10,4 M6.2,6 L6.2,11 M8.2,6 L8.2,11"/>
                            </Grid>
                            <TextBlock Text="Xóa sàn" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BltToolbarButton}" Click="OnBltApplyChangesClick" Margin="10,2,2,2">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="14" Height="14" Margin="0,0,5,0">
                                <Path Style="{StaticResource BltToolbarIcon}" Data="M1.5,1.5 L12.5,1.5 L12.5,12.5 L1.5,12.5 Z M3.7,7 L6,9.3 L10.5,4.5"/>
                            </Grid>
                            <TextBlock Text="Áp dụng thay đổi" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <DataGrid x:Name="BltFloorGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="None"
                          AlternationCount="2" Background="#1E1E1E" BorderThickness="0"
                          ColumnHeaderHeight="29" RowHeight="30"
                          SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Tầng tham chiếu" Width="118">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsReference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Tag="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Click="OnBltReferenceClick"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mã hóa" Width="82" Binding="{Binding Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Tên tầng" Width="150" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Chiều cao sàn (m)" Width="135" Binding="{Binding HeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Độ cao đáy (m)" Width="125" Binding="{Binding ElevationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Số tầng điển hình" Width="130" Binding="{Binding TypicalCountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="Nhận xét" Width="*" MinWidth="180" Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#202020" BorderBrush="#343434" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource BltModePill}"><TextBlock Text="Mô hình" Foreground="White" FontWeight="SemiBold"/></Border>
                    <Border Style="{StaticResource BltModePill}"><TextBlock Text="BQ" Foreground="White" FontWeight="SemiBold"/></Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center">
                    <TextBlock Foreground="#DDDDDD" FontSize="12" TextTrimming="CharacterEllipsis">
                        <Run Text="Tầng "/>
                        <Run Text="{Binding SelectedItem.Name, ElementName=BltFloorGrid, TargetNullValue=—}" FontWeight="SemiBold"/>
                        <Run Text="   ·   Cao độ "/>
                        <Run Text="{Binding SelectedItem.ElevationText, ElementName=BltFloorGrid, TargetNullValue=0.000}" FontWeight="SemiBold"/>
                        <Run Text=" m"/>
                    </TextBlock>
                    <TextBlock x:Name="BltStatusText" Foreground="#AFAFAF" FontSize="10.5" Text="Sẵn sàng"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BltStatusToggle}" Text="○ Nền sáng"/>
                    <TextBlock Style="{StaticResource BltStatusToggle}" Text="◐ Tương phản"/>
                    <TextBlock Style="{StaticResource BltStatusToggle}" Text="⌞ Vuông góc"/>
                    <Border Background="#0D6EDE" CornerRadius="2" Padding="9,4" Margin="0,0,6,0">
                        <TextBlock Foreground="White" FontSize="12" FontWeight="SemiBold" Text="⌁ Bắt điểm"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hidden compatibility surface: preserves the canonical Level Picker controls,
             event wiring and lifecycle contract without changing the visible BLT3D layout. -->
        <Grid Visibility="Collapsed" IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="SEMANTIC LEVEL"/>
                <Button Content="Làm mới" Click="OnRefreshClick"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView x:Name="FloorList" SelectionChanged="OnFloorSelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tên tầng" Width="280" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="Cao độ (m)" Width="145" DisplayMemberBinding="{Binding ElevationM}"/>
                            <GridViewColumn Header="ID" Width="190" DisplayMemberBinding="{Binding Id}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FloorNameBox" Grid.Column="0"/>
                    <TextBox x:Name="FloorElevationBox" Grid.Column="1"/>
                    <WrapPanel Grid.Column="2">
                        <Button Content="Mới" Click="OnNewFloorClick"/>
                        <Button Content="Lưu" Style="{StaticResource AccentButton}" Click="OnSaveFloorFirstBootstrapClick"/>
                        <Button Content="Xóa" Style="{StaticResource DangerButton}" Click="OnDeleteFloorClick"/>
                    </WrapPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="ActiveFloorText" Text="—"/>
                    <TextBlock Grid.Column="1" x:Name="SelectedFloorText" Text="—"/>
                    <TextBlock Grid.Column="2" x:Name="ReferenceCountText" Text="0"/>
                    <TextBlock Grid.Column="3" x:Name="SelectionCountText" Text="0"/>
                </Grid>

                <StackPanel Grid.Row="3">
                    <WrapPanel>
                        <Button Content="Đặt làm tầng hoạt động" Click="OnActivateClick"/>
                        <Button Content="Gán tầng cho selection" Style="{StaticResource AccentButton}" Click="OnAssignClick"/>
                        <Button Content="Gán Level đáy" Style="{StaticResource AccentButton}" Click="OnAssignBottomLevelClick"/>
                        <Button Content="Gán Level đỉnh" Style="{StaticResource AccentButton}" Click="OnAssignTopLevelClick"/>
                        <Button Content="Xóa Level đứng" Click="OnClearVerticalLevelsClick"/>
                        <Button Content="Kiểm tra selection" Click="OnInspectSelectionClick"/>
                    </WrapPanel>
                    <TextBlock Text="Bottom/Top Level điều khiển đáy và chiều cao hiệu dụng của host, rebar, opening/cutter và Curtain khi rebuild. Gán/xóa Level hoặc đổi cao độ sẽ đánh dấu output liên quan stale; QS3D KHÔNG tự Move/Translate source CAD. Xóa Level đứng sẽ quay lại Height/Thickness + BottomOffset legacy. Không thể xóa tầng active hoặc tầng còn semantic element tham chiếu."
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" x:Name="FloorLevelStatusGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SuccessBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Sẵn sàng"
                           MinWidth="0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Text="NO CAD MOVE • STALE ON LEVEL CHANGE"
                           HorizontalAlignment="Right" TextWrapping="NoWrap"
                           Style="{StaticResource Caption}" Margin="12,0,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>