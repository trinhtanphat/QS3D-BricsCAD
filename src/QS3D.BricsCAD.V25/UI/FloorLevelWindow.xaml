<Window x:Class="QS3D.BricsCAD.V25.UI.FloorLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Tầng / Cao độ" Width="620" Height="560"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="15" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TẦNG / LEVEL PICKER" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Active floor cho capture • gán FloorId an toàn cho semantic selection" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Click="OnRefreshClick" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="DANH SÁCH TẦNG" Style="{StaticResource SectionLabel}"/>
            <ListView x:Name="FloorList" Grid.Row="1" SelectionChanged="OnFloorSelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Tên tầng" Width="260" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="Cao độ (m)" Width="140" DisplayMemberBinding="{Binding ElevationM}"/>
                        <GridViewColumn Header="ID" Width="150" DisplayMemberBinding="{Binding Id}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="12" Margin="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="Tầng đang active" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActiveFloorText" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Tầng được chọn" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedFloorText" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Semantic selection" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectionCountText" Text="0" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3">
                <WrapPanel>
                    <Button Content="Đặt làm tầng hoạt động" Click="OnActivateClick"/>
                    <Button Content="Gán tầng cho selection" Style="{StaticResource AccentButton}" Click="OnAssignClick"/>
                    <Button Content="Kiểm tra selection" Click="OnInspectSelectionClick"/>
                </WrapPanel>
                <TextBlock Text="Lưu ý: thao tác này đổi liên kết tầng semantic và làm generated geometry liên quan thành stale. QS3D KHÔNG tự Move/Translate source CAD theo cao độ tầng; hãy cập nhật hình học CAD riêng rồi rebuild nếu cần." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
