<Window x:Class="QS3D.BricsCAD.V25.UI.EstimatingRateWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D — Estimating &amp; Rate Build-up" Height="780" Width="1220"
        MinWidth="960" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BgRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ESTIMATING &amp; RATE BUILD-UP" FontWeight="Bold" FontSize="20"/>
                    <TextBlock x:Name="ProjectSummaryText" Text="Loading canonical TBQ workspace..."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="REFRESH" Padding="18,7" Click="OnRefresh"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Margin="12,10,12,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Adjustment %" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="AdjustmentBox" Grid.Column="1" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="Markup %" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="MarkupBox" Grid.Column="3" Margin="0,0,12,0"/>
                <Button Grid.Column="4" Content="PREVIEW" Padding="14,6" Margin="0,0,8,0" Click="OnPreviewAdjustment"/>
                <Button Grid.Column="5" Content="APPLY + SAVE" Padding="14,6" Click="OnApplyAdjustment"/>
                <TextBlock x:Name="PreviewSummaryText" Grid.Column="6" Margin="14,5,0,0"
                           Text="Core preview uses the persisted project baseline." TextWrapping="Wrap"/>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Margin="12,10,12,10">
            <TabItem Header="BILL ITEMS">
                <DataGrid x:Name="BillItemsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="120"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="220"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="80"/>
                        <DataGridTextColumn Header="Trade" Binding="{Binding TradeCode}" Width="120"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="110"/>
                        <DataGridTextColumn Header="Unit rate" Binding="{Binding UnitRate, StringFormat={}{0:N2}}" Width="130"/>
                        <DataGridTextColumn Header="Rate code" Binding="{Binding RateCode}" Width="120"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalCost, StringFormat={}{0:N2}}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="BUILD-UPS">
                <DataGrid x:Name="BuildUpsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Rate code" Binding="{Binding RateCode}" Width="150"/>
                        <DataGridTextColumn Header="Unit rate" Binding="{Binding UnitRate, StringFormat={}{0:N2}}" Width="140"/>
                        <DataGridTextColumn Header="Usage" Binding="{Binding Usage}" Width="110"/>
                        <DataGridTextColumn Header="Bill items" Binding="{Binding BillItems}" Width="*" MinWidth="220"/>
                        <DataGridTextColumn Header="Unit rates" Binding="{Binding UnitRates}" Width="*" MinWidth="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="RATE REFERENCES">
                <DataGrid x:Name="RateReferencesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Source rate" Binding="{Binding SourceRateCode}" Width="180"/>
                        <DataGridTextColumn Header="Target kind" Binding="{Binding TargetKind}" Width="180"/>
                        <DataGridTextColumn Header="Target" Binding="{Binding TargetId}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="BQ LIBRARY">
                <DataGrid x:Name="LibraryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding ItemCode}" Width="120"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="240"/>
                        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryPath}" Width="220"/>
                        <DataGridTextColumn Header="Reference rate" Binding="{Binding ReferenceUnitRate, StringFormat={}{0:N2}}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="TRADE / CFA">
                <DataGrid x:Name="TradesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Trade" Binding="{Binding TradeCode}" Width="*"/>
                        <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="120"/>
                        <DataGridTextColumn Header="Total cost" Binding="{Binding TotalCost, StringFormat={}{0:N2}}" Width="180"/>
                        <DataGridTextColumn Header="Cost / CFA" Binding="{Binding CostPerCfaM2, StringFormat={}{0:N2}}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="3" Background="{StaticResource BgRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock x:Name="StatusText" Text="Ready." TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
