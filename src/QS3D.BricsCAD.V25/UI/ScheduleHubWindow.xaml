<Window x:Class="QS3D.BricsCAD.V25.UI.ScheduleHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Schedule Hub" Width="760" Height="720"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="16" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="SCHEDULE / BÓC KHỐI LƯỢNG" FontSize="20" FontWeight="Bold"/><TextBlock Text="BQ tổng • HT_Phòng • vật liệu • curtain • cửa/lỗ mở • cốt thép" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Click="OnRefreshClick"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="SCHEDULE-SAFE SNAPSHOT" Style="{StaticResource SectionLabel}"/>
                <Border Background="{StaticResource Bg1Brush}" Padding="12" Margin="0,0,0,14">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Cấu kiện BQ" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ElementCountText" Text="0" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="HT_Phòng" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="FinishCountText" Text="0" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Door / Opening" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="DoorCountText" Text="0" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="GlassWall" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CurtainCountText" Text="0" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Vật liệu dùng" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="MaterialCountText" Text="0" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="BẢNG TỔNG HỢP" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="BQ tổng hợp / Excel" Tag="QS3DBQ" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Làm mới quantity" Tag="QS3DREGEN" Click="OnCommandClick"/>
                </UniformGrid>

                <TextBlock Text="HT_PHÒNG / HOÀN THIỆN" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="Xem HT_Phòng Schedule" Tag="QS3DFINISHSCHEDULE" Click="OnCommandClick"/>
                    <Button Content="Xuất HT_Phòng XLSX" Tag="QS3DFINISHXLSX" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Kiểm tra HT_Phòng Health" Tag="QS3DROOMFINISHHEALTH" Click="OnCommandClick"/>
                </UniformGrid>

                <TextBlock Text="VẬT LIỆU" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="Material Catalog" Tag="QS3DMATERIALS" Click="OnCommandClick"/>
                    <Button Content="Xuất Material XLSX" Tag="QS3DMATERIALXLSX" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                </UniformGrid>

                <TextBlock Text="VÁCH KÍNH" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="Curtain Hub" Tag="QS3DCURTAIN" Click="OnCommandClick"/>
                    <Button Content="Xuất Curtain XLSX" Tag="QS3DCURTAINXLSX" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                </UniformGrid>

                <TextBlock Text="CỬA / LỖ MỞ" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="Xem Door/Opening Schedule" Tag="QS3DDOORSCHEDULE" Click="OnCommandClick"/>
                    <Button Content="Xuất Door/Opening XLSX" Tag="QS3DDOORXLSX" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                </UniformGrid>

                <TextBlock Text="CỐT THÉP" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2">
                    <Button Content="Rebar 3D Hub" Tag="QS3DREBARHUB" Click="OnCommandClick"/>
                    <Button Content="BBS" Tag="QS3DBBS" Click="OnCommandClick"/>
                    <Button Content="BBS CSV" Tag="QS3DBBSCSV" Click="OnCommandClick"/>
                </UniformGrid>
                <TextBlock Text="Các badge dùng cùng builder/validation với schedule &amp; export. Hub khóa theo bản vẽ đã mở; khi chuyển sang DWG khác, snapshot cũ được giữ và command bị từ chối cho tới khi kích hoạt lại đúng bản vẽ." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
