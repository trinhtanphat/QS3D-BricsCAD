<UserControl x:Class="QS3D.BricsCAD.V25.UI.RightPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="280" MinHeight="480"><UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources><Grid Background="{StaticResource Bg0Brush}"><Grid.RowDefinitions><RowDefinition Height="255"/><RowDefinition Height="5"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions><Border Grid.Row="0" Background="{StaticResource Bg1Brush}" BorderThickness="0,0,0,1" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="QUẢN LÝ BẢN VẼ" Style="{StaticResource PanelTitle}"/><Button DockPanel.Dock="Right" Content="↻" Click="OnRefreshClick"/></DockPanel><StackPanel Orientation="Horizontal"><Button Content="+ Thêm" Style="{StaticResource AccentButton}" Click="OnAttachXrefClick"/><Button Content="Nạp" Click="OnReloadXrefClick"/><Button Content="Xref" Click="OnOpenXrefManagerClick"/></StackPanel></StackPanel><ListView x:Name="DrawingList" ItemsSource="{Binding Drawings}"><ListView.View><GridView><GridViewColumn Header="Tên" Width="130" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Tỉ lệ" Width="55" DisplayMemberBinding="{Binding Scale}"/></GridView></ListView.View></ListView></DockPanel></Border><GridSplitter Grid.Row="1" Height="5" Background="{StaticResource BorderBrush}"/><Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="QUẢN LÝ LỚP" Style="{StaticResource PanelTitle}"/><TextBox x:Name="LayerSearchBox" ToolTip="Tìm layer" Margin="0,0,0,6" TextChanged="OnLayerSearchChanged"/><StackPanel Orientation="Horizontal"><Button Content="Hiện" Click="OnShowLayersClick"/><Button Content="Ẩn" Click="OnHideLayersClick"/><Button Content="Đảo chọn" Click="OnInvertSelectionClick"/></StackPanel><TextBlock Text="Bỏ tick = ẩn • Ctrl/Shift để chọn nhiều lớp" Style="{StaticResource Caption}" Margin="0,5,0,4"/></StackPanel><ListView x:Name="LayerList" ItemsSource="{Binding Layers}" SelectionMode="Extended"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" Checked="OnLayerChecked" Unchecked="OnLayerUnchecked"/><Border Grid.Column="1" Width="10" Height="10" CornerRadius="2" Background="{StaticResource AccentBrush}" Opacity="0.65"/><TextBlock Grid.Column="2" Text="{Binding Name}"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></DockPanel></Border><Border Grid.Row="3" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="6,2"><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"/></Border></Grid></UserControl>
