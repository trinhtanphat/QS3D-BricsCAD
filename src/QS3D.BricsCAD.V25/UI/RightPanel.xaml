<UserControl x:Class="QS3D.BricsCAD.V25.UI.RightPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="260" MinHeight="480">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<Grid Background="{StaticResource Bg0Brush}"><Grid.RowDefinitions><RowDefinition Height="245"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource Bg1Brush}" BorderThickness="0,0,0,1" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Quản lý bản vẽ" FontWeight="SemiBold" Margin="0,0,0,6"/><StackPanel Orientation="Horizontal" Margin="0,0,0,6"><Button Content="+ Thêm" IsEnabled="False"/><Button Content="Nạp" IsEnabled="False"/><Button Content="Di chuyển" IsEnabled="False"/><Button Content="Xóa" IsEnabled="False"/></StackPanel><Button Content="Khoanh vùng" HorizontalAlignment="Left" IsEnabled="False"/><TextBlock Text="Xref manager sẽ nối dữ liệu thật sau Gate V25." Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><ListView><ListViewItem Content="(chưa nạp dữ liệu bản vẽ)"/></ListView></DockPanel></Border>
<GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
<Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Quản lý lớp" FontWeight="SemiBold"/><TextBlock Text="Bỏ tick = ẩn. Ctrl+click thêm/bớt; Shift+click chọn dải." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,6"/><TextBox ToolTip="Tìm layer" Margin="0,0,0,6" IsEnabled="False"/><StackPanel Orientation="Horizontal"><Button Content="Hiện" IsEnabled="False"/><Button Content="Ẩn" IsEnabled="False"/><Button Content="Đảo" IsEnabled="False"/><Button Content="Bỏ chọn" IsEnabled="False"/></StackPanel><TextBlock Text="Layer manager sẽ lấy LayerTable của DWG sau Gate V25." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,4" TextWrapping="Wrap"/></StackPanel><ListView><ListViewItem Content="(chưa nạp layer thật)"/></ListView></DockPanel></Border>
</Grid></UserControl>
