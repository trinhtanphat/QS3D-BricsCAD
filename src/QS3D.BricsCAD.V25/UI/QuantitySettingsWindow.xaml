<Window x:Class="QS3D.BricsCAD.V25.UI.QuantitySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt thông số tính toán"
        Width="980" Height="700" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B101A" Foreground="#E8EEF9"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="PanelBrush" Color="#111827" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#0E1522" />
        <SolidColorBrush x:Key="BorderBrush" Color="#263247" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2F80ED" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8FA1BA" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EAF1FB" />
            <Setter Property="Background" Value="#172235" />
            <Setter Property="BorderBrush" Value="#31415A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#174C78" />
            <Setter Property="BorderBrush" Value="#2D75A9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#101827" />
            <Setter Property="Foreground" Value="#F2F6FC" />
            <Setter Property="BorderBrush" Value="#2C3A50" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#0D1320" />
            <Setter Property="Foreground" Value="#EAF0F9" />
            <Setter Property="BorderBrush" Value="#253047" />
            <Setter Property="HorizontalGridLinesBrush" Value="#202A3C" />
            <Setter Property="VerticalGridLinesBrush" Value="#202A3C" />
            <Setter Property="RowBackground" Value="#0D1320" />
            <Setter Property="AlternatingRowBackground" Value="#101725" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#141C2B" />
            <Setter Property="Foreground" Value="#A9C7F4" />
            <Setter Property="BorderBrush" Value="#2A354A" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#E5ECF7" />
            <Setter Property="BorderBrush" Value="#202A3C" />
            <Setter Property="Padding" Value="7,4" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D9E3F2" />
            <Setter Property="Background" Value="#111827" />
            <Setter Property="BorderBrush" Value="#263247" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C9D4E5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,18,6" />
        </Style>
        <Style x:Key="FieldHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="14,6,0,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="⚙  CÀI ĐẶT THÔNG SỐ TÍNH TOÁN  (SETUP &amp; RULES)"
                           FontSize="17" FontWeight="Bold" Foreground="#F3F7FD" />
                <TextBlock Margin="0,5,0,0"
                           Text="Thông số cốp pha + luật giao cắt + ngưỡng engine — cấu hình QS3D dùng cho định lượng."
                           Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Padding="10,5" CornerRadius="4" Background="#132238" BorderBrush="#2A4D74" BorderThickness="1">
                <TextBlock Text="Schema v2" Foreground="#86BDF2" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="1">
            <TabControl Background="{StaticResource PanelBrush}" BorderThickness="0">
                <TabItem Header="◇  Thông số Cốp pha">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Chọn bề mặt cốp pha cần lấy cho từng loại cấu kiện và ngưỡng phân loại mặt."
                                   Foreground="{StaticResource MutedBrush}" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding CategoryRows}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" AlternationCount="2"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loại cấu kiện" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" MinWidth="220" />
                                <DataGridCheckBoxColumn Header="Lấy CP Thành" Binding="{Binding ExtractSide, Mode=TwoWay}" Width="125" />
                                <DataGridCheckBoxColumn Header="Lấy CP Đáy" Binding="{Binding ExtractBottom, Mode=TwoWay}" Width="115" />
                                <DataGridTextColumn Header="Góc ngưỡng mặt ngang (°)" Binding="{Binding FaceAngleThresholdDeg, Mode=TwoWay}" Width="190" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="✂  Luật Giao Cắt (Intersection Rules)">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Quy tắc có hướng Nguồn → Bị giao. A → B và B → A là hai luật độc lập."
                                   Foreground="{StaticResource MutedBrush}" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding IntersectionRows}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" RowHeaderWidth="0" AlternationCount="2"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nguồn" Binding="{Binding SourceDisplay}" IsReadOnly="True" Width="150" />
                                <DataGridTextColumn Header="Bị giao" Binding="{Binding TargetDisplay}" IsReadOnly="True" Width="150" />
                                <DataGridCheckBoxColumn Header="Trừ BT" Binding="{Binding SubtractConcrete, Mode=TwoWay}" Width="75" />
                                <DataGridCheckBoxColumn Header="CP Thành ← BT" Binding="{Binding SubtractSideFormworkByConcrete, Mode=TwoWay}" Width="110" />
                                <DataGridCheckBoxColumn Header="CP Đáy ← BT" Binding="{Binding SubtractBottomFormworkByConcrete, Mode=TwoWay}" Width="105" />
                                <DataGridCheckBoxColumn Header="CP Thành ← CP" Binding="{Binding SubtractSideFormworkBySideFormwork, Mode=TwoWay}" Width="110" />
                                <DataGridCheckBoxColumn Header="CP Đáy ← CP" Binding="{Binding SubtractBottomFormworkByBottomFormwork, Mode=TwoWay}" Width="105" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="4" Text="Mẹo: nạp template hiện có để giữ nguyên toàn bộ ma trận luật; QS3D không làm mất mã loại cấu kiện chưa nhận diện."
                                   Foreground="#79A7D7" />
                    </Grid>
                </TabItem>

                <TabItem Header="🛠  Cài đặt nhà phát triển">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Dung sai cốp pha (mm)" /><TextBox x:Name="FormworkToleranceBox" Grid.Row="0" Grid.Column="1" /><TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Dung sai hình học khi nhận diện/so khớp bề mặt." />
                            <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Offset bê tông lót (mm)" /><TextBox x:Name="BlindingConcreteOffsetBox" Grid.Row="1" Grid.Column="1" /><TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Khoảng bù phục vụ lớp bê tông lót." />
                            <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Diện tích trừ tối thiểu (mm²)" /><TextBox x:Name="MinSubtractAreaBox" Grid.Row="2" Grid.Column="1" /><TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Bỏ qua giao cắt có diện tích nhỏ hơn ngưỡng." />
                            <TextBlock Grid.Row="3" Style="{StaticResource FieldLabel}" Text="Diện tích cốp pha tối thiểu (mm²)" /><TextBox x:Name="MinFormworkAreaBox" Grid.Row="3" Grid.Column="1" /><TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Bỏ qua mặt cốp pha quá nhỏ." />
                            <TextBlock Grid.Row="4" Style="{StaticResource FieldLabel}" Text="Thể tích bê tông tối thiểu (m³)" /><TextBox x:Name="MinConcreteVolumeBox" Grid.Row="4" Grid.Column="1" /><TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Ngưỡng nhiễu cho thể tích bê tông." />
                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" Text="Tỷ lệ bao phủ tương đối (%)" /><TextBox x:Name="EngulfRelPercentBox" Grid.Row="5" Grid.Column="1" /><TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Ngưỡng tương đối khi xét bao phủ/giao nhau." />
                            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" Text="Diện tích bao phủ tối thiểu (mm²)" /><TextBox x:Name="EngulfMinAreaBox" Grid.Row="6" Grid.Column="1" /><TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Ngưỡng tuyệt đối cho kiểm tra bao phủ." />
                            <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" Text="Lấp khe Phòng (mm)" /><TextBox x:Name="RoomGapFillBox" Grid.Row="7" Grid.Column="1" /><TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Khoảng hở nhỏ được phép nối khi dò biên phòng." />
                            <TextBlock Grid.Row="8" Style="{StaticResource FieldLabel}" Text="Bán kính tìm Phòng (mm)" /><TextBox x:Name="RoomSearchRadiusBox" Grid.Row="8" Grid.Column="1" /><TextBlock Grid.Row="8" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Giới hạn tìm kiếm hình học phòng." />
                            <TextBlock Grid.Row="9" Style="{StaticResource FieldLabel}" Text="Màu kích thước (#RRGGBB)" /><TextBox x:Name="DimColorBox" Grid.Row="9" Grid.Column="1" /><TextBlock Grid.Row="9" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Màu annotation/kích thước do engine sinh." />
                            <TextBlock Grid.Row="10" Style="{StaticResource FieldLabel}" Text="Chiều cao chữ kích thước" /><TextBox x:Name="DimTextHeightBox" Grid.Row="10" Grid.Column="1" /><TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Chiều cao chữ theo đơn vị bản vẽ." />
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Lưu theo máy:" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock x:Name="SettingsPathText" Foreground="#7188A7" FontSize="11" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="⇧  Xuất template" Click="ExportTemplate_Click" />
                <Button Content="⇩  Nạp template" Click="ImportTemplate_Click" />
                <Button Content="Khôi phục mặc định" Click="RestoreDefaults_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="💾  Lưu Cài Đặt" Click="Save_Click" />
                <Button Content="Đóng" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
