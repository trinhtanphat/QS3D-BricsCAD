<Window x:Class="QS3D.BricsCAD.V25.UI.QuantitySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt thông số tính toán"
        Width="980" Height="700" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg0Brush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="11"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Loaded="QuantitySettingsWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="4,2,0,2" />
                <Setter Property="MinHeight" Value="27" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="Margin" Value="4,2,0,2" />
                <Setter Property="MinHeight" Value="27" />
            </Style>
            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{StaticResource BgInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="RowBackground" Value="{StaticResource BgInputBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{StaticResource Bg1Brush}" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="HeadersVisibility" Value="Column" />
            </Style>
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource BgRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="6,4" />
            </Style>
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                <Setter Property="Background" Value="{StaticResource Bg1Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3,3,0,0"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{StaticResource BgRaisedBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                                    <Setter Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,6,18,6" />
            </Style>
            <Style x:Key="FieldHint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="14,6,0,6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MinWidth="0" Margin="0,0,12,0">
                <TextBlock Text="CÀI ĐẶT THÔNG SỐ TÍNH TOÁN"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Cài đặt thông số tính toán" />
                <TextBlock Margin="0,4,0,0"
                           Text="Thông số cốp pha, luật giao cắt và ngưỡng engine dùng cho định lượng QS3D."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Padding="9,4" CornerRadius="8"
                    Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding SchemaVersionLabel}"
                           Foreground="{StaticResource AccentHoverBrush}"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                CornerRadius="6" Padding="1">
            <TabControl Background="{StaticResource Bg1Brush}" BorderThickness="0">
                <TabItem Header="Thông số cốp pha">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Chọn bề mặt cốp pha cần lấy cho từng loại cấu kiện và ngưỡng phân loại mặt."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Border Grid.Row="2" Background="{StaticResource Bg2Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" MinWidth="0">
                                    <TextBlock Text="Mã có trong luật giao cắt nhưng chưa có quy tắc loại"
                                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="MissingCategoryRuleStatusText" Margin="0,4,10,0"
                                               Text="Đang kiểm tra cấu hình…"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <ComboBox x:Name="MissingCategoryRuleList" Grid.Column="1" Width="220"
                                          Margin="8,0,0,0" VerticalAlignment="Center"
                                          ItemsSource="{Binding MissingCategoryRuleChoices}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="MissingCategoryRuleSelectionChanged"
                                          IsEnabled="False" />
                                <Button x:Name="CreateCategoryRuleButton" Grid.Column="2"
                                        Content="＋  Tạo quy tắc loại"
                                        Click="CreateCategoryRule_Click"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        IsEnabled="False" />
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="4" ItemsSource="{Binding CategoryRows}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  RowHeaderWidth="0" AlternationCount="2"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Loại cấu kiện" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*" MinWidth="190" />
                                <DataGridCheckBoxColumn Header="CP thành" Binding="{Binding ExtractSide, Mode=TwoWay}" Width="105" />
                                <DataGridCheckBoxColumn Header="CP đáy" Binding="{Binding ExtractBottom, Mode=TwoWay}" Width="95" />
                                <DataGridTextColumn Header="Góc ngưỡng mặt ngang (°)" Binding="{Binding FaceAngleThresholdDeg, Mode=TwoWay}" Width="175" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Luật giao cắt">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Quy tắc có hướng: chọn Cấu kiện chính → Cấu kiện tham chiếu. Hai chiều A → B và B → A là hai luật độc lập."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" MinWidth="280" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource Bg2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="6">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top" Margin="3,2,3,7">
                                        <TextBlock Text="Cấu kiện chính" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Bị trừ / nhận tác động" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                    <ListBox x:Name="PrimaryCategoryList"
                                             ItemsSource="{Binding IntersectionCategoryChoices}"
                                             DisplayMemberPath="DisplayName"
                                             SelectionChanged="IntersectionCategorySelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource Bg2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="6">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Top" Margin="3,2,3,7">
                                        <TextBlock Text="Cấu kiện tham chiếu" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="Đối tượng giao với cấu kiện chính" FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ListBox x:Name="ReferenceCategoryList"
                                             ItemsSource="{Binding IntersectionCategoryChoices}"
                                             DisplayMemberPath="DisplayName"
                                             SelectionChanged="IntersectionCategorySelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource BgInputBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="SelectedRuleHeading" Text="Chọn hai loại cấu kiện"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="SelectedRuleStateText" Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                        <Button x:Name="CreateSelectedRuleButton" Content="＋  Tạo luật A → B"
                                                Click="CreateSelectedRule_Click" HorizontalAlignment="Left"
                                                Margin="0,8,0,0" IsEnabled="False" Visibility="Collapsed" />
                                    </StackPanel>
                                    <Border x:Name="SelectedRuleEditor" Grid.Row="2"
                                            Background="{StaticResource Bg2Brush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="5" Padding="10" IsEnabled="False">
                                        <StackPanel>
                                            <TextBlock Text="Lựa chọn của luật đang chọn"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                       Margin="0,0,0,6" />
                                            <CheckBox Content="Trừ khối lượng bê tông giao cắt" IsChecked="{Binding SubtractConcrete, Mode=TwoWay}" Margin="0,3" />
                                            <CheckBox Content="Trừ CP Thành bởi bê tông" IsChecked="{Binding SubtractSideFormworkByConcrete, Mode=TwoWay}" Margin="0,3" />
                                            <CheckBox Content="Trừ CP Đáy bởi bê tông" IsChecked="{Binding SubtractBottomFormworkByConcrete, Mode=TwoWay}" Margin="0,3" />
                                            <CheckBox Content="Trừ CP Thành bởi CP Thành" IsChecked="{Binding SubtractSideFormworkBySideFormwork, Mode=TwoWay}" Margin="0,3" />
                                            <CheckBox Content="Trừ CP Đáy bởi CP Đáy" IsChecked="{Binding SubtractBottomFormworkByBottomFormwork, Mode=TwoWay}" Margin="0,3" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Row="4" Background="{StaticResource LuxurySoftBrush}"
                                            BorderBrush="{StaticResource BorderLuxuryBrush}" BorderThickness="1"
                                            CornerRadius="5" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" MinWidth="0">
                                                <TextBlock Text="Luật đảo ngược" Foreground="{StaticResource LuxuryBrush}" FontWeight="SemiBold" />
                                                <TextBlock x:Name="ReverseRuleSummaryText" Margin="0,4,8,0"
                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Button x:Name="ViewReverseRuleButton" Grid.Column="1"
                                                    Content="Xem chiều ngược" Click="ViewReverseRule_Click"
                                                    VerticalAlignment="Center" IsEnabled="False" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="6"
                                               Text="Chỉ dòng A → B đang chọn được chỉnh. Chuyển sang B → A để chỉnh luật chiều ngược; QS3D không tự sao chép giá trị giữa hai chiều."
                                               Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="4"
                                   Text="Toàn bộ ma trận vẫn được giữ khi lưu/xuất template, kể cả mã cấu kiện tương thích chưa có tên native QS3D."
                                   Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" />
                    </Grid>
                </TabItem>

                <TabItem Header="Cài đặt nhà phát triển">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <Border Background="{StaticResource LuxurySoftBrush}"
                                    BorderBrush="{StaticResource BorderLuxuryBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="10" Margin="0,0,0,10">
                                <TextBlock Text="CẢNH BÁO — Các ngưỡng nội bộ của engine tính khối lượng; chỉ chỉnh khi hiểu rõ tác động."
                                           Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Thông số engine chung" Style="{StaticResource SectionHeading}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Khoảng văng Cốp pha / Tolerance (mm)" />
                                    <TextBox x:Name="FormworkToleranceBox" Grid.Row="0" Grid.Column="1" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Dung sai hình học khi nhận diện/so khớp bề mặt." />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Offset bê tông lót ra ngoài mép móng (mm)" />
                                    <TextBox x:Name="BlindingConcreteOffsetBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Khoảng bù phục vụ lớp bê tông lót." />
                                </Grid>
                            </StackPanel>
                            <Separator Margin="0,1,0,10" />
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Ngưỡng lọc khối lượng" Style="{StaticResource SectionHeading}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Diện tích tấm TRỪ (giao) tối thiểu (mm²)" />
                                    <TextBox x:Name="MinSubtractAreaBox" Grid.Row="0" Grid.Column="1" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Bỏ qua giao cắt có diện tích nhỏ hơn ngưỡng." />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Diện tích tấm cốp pha CÒN LẠI tối thiểu (mm²)" />
                                    <TextBox x:Name="MinFormworkAreaBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Bỏ qua mặt cốp pha quá nhỏ." />
                                    <TextBlock Grid.Row="2" Style="{StaticResource FieldLabel}" Text="Thể tích bê tông tối thiểu (m³)" />
                                    <TextBox x:Name="MinConcreteVolumeBox" Grid.Row="2" Grid.Column="1" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Ngưỡng nhiễu cho thể tích bê tông." />
                                </Grid>
                            </StackPanel>
                            <Separator Margin="0,1,0,10" />
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Ngưỡng ‘nuốt’ tấm trừ" Style="{StaticResource SectionHeading}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Tỷ lệ lệch tối đa so với diện tích tấm (%)" />
                                    <TextBox x:Name="EngulfRelPercentBox" Grid.Row="0" Grid.Column="1" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Ngưỡng tương đối khi xét bao phủ/giao nhau." />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Sàn tuyệt đối tối thiểu (mm²)" />
                                    <TextBox x:Name="EngulfMinAreaBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Ngưỡng tuyệt đối cho kiểm tra bao phủ." />
                                </Grid>
                            </StackPanel>
                            <Separator Margin="0,1,0,10" />
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Pick Room (pick biên phòng trong View 3D)" Style="{StaticResource SectionHeading}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Tự động vá (fill) khe hở ≤ (mm)" />
                                    <TextBox x:Name="RoomGapFillBox" Grid.Row="0" Grid.Column="1" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Khoảng hở nhỏ được phép nối khi dò biên phòng." />
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Bán kính quét quanh điểm pick (mm)" />
                                    <TextBox x:Name="RoomSearchRadiusBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Giới hạn tìm kiếm hình học phòng." />
                                </Grid>
                            </StackPanel>
                            <Separator Margin="0,1,0,10" />
                            <StackPanel>
                                <TextBlock Text="Nhãn kích thước (Dim) khi Diễn giải khối lượng" Style="{StaticResource SectionHeading}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="145" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Style="{StaticResource FieldLabel}" Text="Màu dim (nét + chữ) #RRGGBB" />
                                    <TextBox x:Name="DimColorBox" Grid.Row="0" Grid.Column="1" />
                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="14,4,0,4" VerticalAlignment="Center">
                                        <Border Width="28" Height="24" CornerRadius="3"
                                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                Background="{Binding Text, ElementName=DimColorBox}" />
                                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Text="Xem trước màu hiện tại; chỉ lưu khi #RRGGBB hợp lệ."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Style="{StaticResource FieldLabel}" Text="Cỡ chữ dim (px)" />
                                    <TextBox x:Name="DimTextHeightBox" Grid.Row="1" Grid.Column="1" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource FieldHint}" Text="Chiều cao chữ theo đơn vị bản vẽ/annotation hiện hành." />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" MinWidth="0" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="Lưu theo máy" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
                <TextBlock x:Name="SettingsPathText" Foreground="{StaticResource SubtleTextBrush}"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Xuất template" Click="ExportTemplate_Click" />
                <Button Content="Nạp template" Click="ImportTemplate_Click" />
                <Button Content="Khôi phục mặc định" Click="RestoreDefaults_Click" />
                <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Content="Lưu cài đặt" Click="Save_Click" />
                <Button Content="Đóng" Click="Close_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>