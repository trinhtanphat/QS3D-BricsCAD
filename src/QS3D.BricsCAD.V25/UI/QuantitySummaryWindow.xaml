 kiện" FontWeight="SemiBold" Margin="0,0,0,6"/><ListBox x:Name="CategoryList" SelectionChanged="OnCategoryChanged"/></DockPanel></Border><GridSplitter Grid.Column="1" Width="5" Background="{StaticResource BorderBrush}"/><DataGrid Grid.Column="2" x:Name="QuantityGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" MouseDoubleClick="OnQuantityGridDoubleClick"><DataGrid.Columns><DataGridTextColumn Header="Tầng" Binding="{Binding Floor}" Width="85"/><DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Tên cấu kiện" Binding="{Binding FamilyName}" Width="150"/><DataGridTextColumn Header="SL" Binding="{Binding Count}" Width="55"/><DataGridTextColumn Header="BT gộp (m³)" Binding="{Binding GrossConcreteM3, StringFormat=0.###}" Width="95"/><DataGridTextColumn Header="Trừ giao (m³)" Binding="{Binding DeductionM3, StringFormat=0.###}" Width="95"/><DataGridTextColumn Header="BT còn (m³)" Binding="{Binding NetConcreteM3, StringFormat=0.###}" Width="95"/><DataGridTextColumn Header="Cốp pha (m²)" Binding="{Binding FormworkM2, StringFormat=0.###}" Width="95"/><DataGridTextColumn Header="Dài (m)" Binding="{Binding LengthM, StringFormat=0.###}" Width="85"/><DataGridTextColumn Header="Chu vi ngoài" Binding="{Binding OuterPerimeterM, StringFormat=0.###}" Width="90"/><DataGridTextColumn Header="Chu vi trong" Binding="{Binding InnerPerimeterM, StringFormat=0.###}" Width="90"/><DataGridTextColumn Header="DT cửa" Binding="{Binding DoorAreaM2, StringFormat=0.###}" Width="80"/><DataGridTextColumn Header="Thành bên" Binding="{Binding SideAreaM2, StringFormat=0.###}" Width="85"/><DataGridTextColumn Header="DT đáy" Binding="{Binding BottomAreaM2, StringFormat=0.###}" Width="80"/><DataGridTextColumn Header="DT đỉnh" Binding="{Binding TopAreaM2, StringFormat=0.###}" Width="80"/><DataGridTextColumn Header="DT khác" Binding="{Binding OtherAreaM2, StringFormat=0.###}" Width="80"/></DataGrid.Columns></DataGrid><GridSplitter Grid.Column="3" Width="5" Background="{StaticResource BorderBrush}"/><Border Grid.Column="4" Background="{StaticResource Bg1Brush}" Padding="8" BorderThickness="1,0,0,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Cột hiển thị" FontWeight="SemiBold"/><TextBlock Text="Bật/tắt cột theo nhu cầu" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,8"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><CheckBox Content="Tầng" Tag="0" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="Loại" Tag="1" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="Tên cấu kiện" Tag="2" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="SL" Tag="3" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="BT gộp (m³)" Tag="4" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="Trừ giao (m³)" Tag="5" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="BT còn (m³)" Tag="6" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="Cốp pha (m²)" Tag="7" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="Dài (m)" Tag="8" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="Chu vi ngoài (m)" Tag="9" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="Chu vi trong (m)" Tag="10" IsChecked="True" Checked="OnColumnVisibilityChanged" Unchecked="OnColumnVisibilityChanged"/><CheckBox Content="DT cửa (m²)" Tag="11" IsChecked="True" Checked="OnColumnVisibilityChanged" U