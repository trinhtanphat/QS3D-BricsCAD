<Window x:Class="QS3D.BricsCAD.V25.UI.EstimatingRateBuildUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D Estimating • Rate Build-up"
        Width="1180" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#1E1F22" Foreground="#F0F0F0">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="7,5"/>
                <Setter Property="Background" Value="#2B2D31"/>
                <Setter Property="Foreground" Value="#F0F0F0"/>
                <Setter Property="BorderBrush" Value="#4B4E55"/>
            </Style>
            <Style TargetType="Button">
                <Setter Property="Margin" Value="4"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Background" Value="#34373D"/>
                <Setter Property="Foreground" Value="#F0F0F0"/>
                <Setter Property="BorderBrush" Value="#555A64"/>
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Estimating • Rate Build-up" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Margin="0,4,0,0" Foreground="#B5B8C0"
                       Text="Material • Labour • Plant • Subcontract • quotation provenance • revision approval"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"/><ColumnDefinition Width="180"/>
                <ColumnDefinition Width="90"/><ColumnDefinition Width="150"/>
                <ColumnDefinition Width="70"/><ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="90"/>
                <ColumnDefinition Width="80"/><ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Build-up"/>
            <TextBox x:Name="BuildUpIdBox" Grid.Row="0" Grid.Column="1" Text="EST-CONC-001"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Revision"/>
            <TextBox x:Name="RevisionIdBox" Grid.Row="0" Grid.Column="3" Text="R1"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Cost code"/>
            <TextBox x:Name="CostCodeBox" Grid.Row="0" Grid.Column="5" Text="CONC"/>
            <TextBlock Grid.Row="0" Grid.Column="6" Text="Bill unit"/>
            <TextBox x:Name="BillUnitBox" Grid.Row="0" Grid.Column="7" Text="m3"/>
            <TextBlock Grid.Row="0" Grid.Column="8" Text="Currency"/>
            <TextBox x:Name="CurrencyBox" Grid.Row="0" Grid.Column="9" Text="VND"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Effective UTC"/>
            <TextBox x:Name="EffectiveDateBox" Grid.Row="1" Grid.Column="1" Text="2026-09-11"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Author"/>
            <TextBox x:Name="AuthorBox" Grid.Row="1" Grid.Column="3" Text="QS"/>
            <TextBlock Grid.Row="1" Grid.Column="4" Text="OH %"/>
            <TextBox x:Name="OverheadBox" Grid.Row="1" Grid.Column="5" Text="5"/>
            <TextBlock Grid.Row="1" Grid.Column="6" Text="Profit %"/>
            <TextBox x:Name="ProfitBox" Grid.Row="1" Grid.Column="7" Text="5"/>
            <TextBlock Grid.Row="1" Grid.Column="8" Text="Reason"/>
            <TextBox x:Name="ReasonBox" Grid.Row="1" Grid.Column="9" Grid.ColumnSpan="2" Text="Initial estimate"/>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="11" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ Resource" Click="AddResource_Click"/>
                <Button Content="Remove selected" Click="RemoveResource_Click"/>
                <Button Content="Evaluate" Click="Evaluate_Click"/>
                <Button Content="New revision" Click="NewRevision_Click"/>
            </StackPanel>
        </Grid>

        <DataGrid x:Name="ResourceGrid" Grid.Row="2" ItemsSource="{Binding ResourceRows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="#24262A" Foreground="#F0F0F0" RowBackground="#24262A"
                  AlternatingRowBackground="#292B30" BorderBrush="#454850">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                <DataGridTextColumn Header="Code" Binding="{Binding ResourceCode}" Width="105"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="170"/>
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65"/>
                <DataGridTextColumn Header="Qty / bill unit" Binding="{Binding QuantityPerBillUnit}" Width="100"/>
                <DataGridTextColumn Header="Unit rate" Binding="{Binding UnitRate}" Width="100"/>
                <DataGridTextColumn Header="Wastage %" Binding="{Binding WastagePercent}" Width="80"/>
                <DataGridTextColumn Header="Source ID" Binding="{Binding SourceId}" Width="100"/>
                <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="130"/>
                <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="130"/>
                <DataGridTextColumn Header="Source UTC" Binding="{Binding SourceEffectiveDate}" Width="105"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="0,10,0,6" Padding="10" Background="#25272B" BorderBrush="#454850" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="StatusText" Text="Draft not evaluated" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProvenanceText" Margin="0,3,0,0" Foreground="#B5B8C0" Text="No evaluated revision."/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="Direct" Foreground="#B5B8C0"/>
                    <TextBlock x:Name="DirectCostText" Text="—" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="16,0">
                    <TextBlock Text="Overhead" Foreground="#B5B8C0"/>
                    <TextBlock x:Name="OverheadCostText" Text="—" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="16,0">
                    <TextBlock Text="Profit" Foreground="#B5B8C0"/>
                    <TextBlock x:Name="ProfitCostText" Text="—" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="16,0">
                    <TextBlock Text="Unit rate" Foreground="#B5B8C0"/>
                    <TextBlock x:Name="UnitRateText" Text="—" FontSize="17" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="MessageText" Grid.Column="0" Foreground="#B5B8C0" Text="Enter resources, then Evaluate."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="DecisionByBox" Width="130" Text="QS Manager"/>
                <TextBox x:Name="DecisionNoteBox" Width="220" Text="Checked against quotation"/>
                <Button Content="Mark reviewed" Click="Review_Click"/>
                <Button Content="Approve" Click="Approve_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
