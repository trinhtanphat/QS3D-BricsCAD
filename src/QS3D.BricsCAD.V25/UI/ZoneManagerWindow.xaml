<Window x:Class="QS3D.BricsCAD.V25.UI.ZoneManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Khu vực / Zone" Width="700" Height="640"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ZoneMetric" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KHU VỰC / ZONE" FontSize="18" FontWeight="Bold"/>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="SEMANTIC SCOPE" Foreground="{StaticResource LuxuryBrush}" FontSize="9" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="CRUD • active zone cho capture • gán ZoneId cho semantic selection"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Click="OnRefreshClick" Style="{StaticResource DenseButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="9" CornerRadius="5">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="DANH SÁCH ZONE" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Chọn Zone để xem, đổi tên hoặc đặt scope active."
                                   Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                    </StackPanel>
                    <ListView x:Name="ZoneList" SelectionChanged="OnZoneSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tên Zone" Width="350" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="ID" Width="260" DisplayMemberBinding="{Binding Id}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10" CornerRadius="5" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Tên Zone" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                        <TextBox x:Name="ZoneNameBox"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button Content="Mới" Click="OnNewClick"/>
                        <Button Content="Lưu" Style="{StaticResource AccentButton}" Click="OnSaveClick"/>
                        <Button Content="Xóa" Style="{StaticResource DangerButton}" Click="OnDeleteClick"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="-3,7,-3,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ZoneMetric}"><StackPanel><TextBlock Text="ZONE ACTIVE" Style="{StaticResource Caption}"/><TextBlock x:Name="ActiveZoneText" Text="—" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource ZoneMetric}"><StackPanel><TextBlock Text="ZONE CHỌN" Style="{StaticResource Caption}"/><TextBlock x:Name="SelectedZoneText" Text="—" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource ZoneMetric}"><StackPanel><TextBlock Text="THAM CHIẾU" Style="{StaticResource Caption}"/><TextBlock x:Name="ReferenceCountText" Text="0" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource AccentHoverBrush}" Margin="0,2,0,0"/></StackPanel></Border>
                <Border Grid.Column="3" Style="{StaticResource ZoneMetric}"><StackPanel><TextBlock Text="SELECTION" Style="{StaticResource Caption}"/><TextBlock x:Name="SelectionCountText" Text="0" FontWeight="SemiBold" FontSize="15" Margin="0,2,0,0"/></StackPanel></Border>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10" CornerRadius="5" Margin="0,7,0,0">
                <StackPanel>
                    <WrapPanel>
                        <Button Content="Đặt Zone hoạt động" Click="OnActivateClick"/>
                        <Button Content="Gán Zone cho selection" Style="{StaticResource AccentButton}" Click="OnAssignClick"/>
                        <Button Content="Kiểm tra selection" Click="OnInspectClick"/>
                    </WrapPanel>
                    <TextBlock Text="Đổi/gán Zone chỉ thay semantic scope, không Move CAD source. Generated outputs liên quan sẽ stale qua Relations. Không thể xóa Zone active hoặc Zone còn semantic element tham chiếu."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="11,7" BorderThickness="0,1,0,0">
            <Grid x:Name="ZoneManagerStatusGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SuccessBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="Sẵn sàng"
                           MinWidth="0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Grid.Column="2" Text="SEMANTIC SCOPE ONLY • NO CAD MOVE"
                           HorizontalAlignment="Right" TextWrapping="NoWrap"
                           Style="{StaticResource Caption}" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>