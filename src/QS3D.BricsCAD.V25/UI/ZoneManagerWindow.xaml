<Window x:Class="QS3D.BricsCAD.V25.UI.ZoneManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Khu vực / Zone" Width="660" Height="610"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="15" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="KHU VỰC / ZONE" FontSize="19" FontWeight="Bold"/><TextBlock Text="CRUD • active zone cho capture • gán ZoneId cho semantic selection" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Click="OnRefreshClick"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="DANH SÁCH ZONE" Style="{StaticResource SectionLabel}"/>
            <ListView x:Name="ZoneList" Grid.Row="1" SelectionChanged="OnZoneSelectionChanged"><ListView.View><GridView><GridViewColumn Header="Tên Zone" Width="330" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="ID" Width="250" DisplayMemberBinding="{Binding Id}"/></GridView></ListView.View></ListView>
            <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="12" Margin="0,10,0,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Tên Zone" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="ZoneNameBox"/></StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Bottom"><Button Content="Mới" Click="OnNewClick"/><Button Content="Lưu" Style="{StaticResource AccentButton}" Click="OnSaveClick"/><Button Content="Xóa" Click="OnDeleteClick"/></WrapPanel>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" Padding="12" Margin="0,0,0,10">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"><TextBlock Text="Zone active" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ActiveZoneText" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Zone chọn" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectedZoneText" Text="—" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Đang tham chiếu" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ReferenceCountText" Text="0" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Semantic selection" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="SelectionCountText" Text="0" FontWeight="SemiBold"/></StackPanel>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4"><WrapPanel><Button Content="Đặt Zone hoạt động" Click="OnActivateClick"/><Button Content="Gán Zone cho selection" Style="{StaticResource AccentButton}" Click="OnAssignClick"/><Button Content="Kiểm tra selection" Click="OnInspectClick"/></WrapPanel><TextBlock Text="Đổi/gán Zone chỉ thay semantic scope, không Move CAD source. Generated outputs liên quan sẽ stale qua Relations. Không thể xóa Zone active hoặc Zone còn semantic element tham chiếu." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
