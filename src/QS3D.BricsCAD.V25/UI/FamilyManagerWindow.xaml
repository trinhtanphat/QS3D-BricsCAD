<Window x:Class="QS3D.BricsCAD.V25.UI.FamilyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Family Manager" Width="900" Height="720"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="15" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="FAMILY MANAGER" FontSize="19" FontWeight="Bold"/><TextBlock Text="Create • duplicate • rename • properties • assign semantic selection" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Click="OnRefreshClick"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="FAMILY CATALOG" Style="{StaticResource SectionLabel}"/>
                <ComboBox x:Name="CategoryFilter" Grid.Row="1" Margin="0,0,0,8" SelectionChanged="OnCategoryFilterChanged"/>
                <ListView x:Name="FamilyList" Grid.Row="2" SelectionChanged="OnFamilySelectionChanged">
                    <ListView.View><GridView><GridViewColumn Header="Tên" Width="180" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding Category}"/></GridView></ListView.View>
                </ListView>
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock Text="Family active" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="ActiveFamilyText" Text="—" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Button Content="Đặt Family đang chọn làm active" Click="OnActivateClick" Margin="0,6,0,10"/>
                    <TextBlock Text="Instance tham chiếu" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="ReferenceCountText" Text="0" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN FAMILY" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Tên Family" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="FamilyNameBox"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Category khi tạo mới" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="NewCategoryCombo"/></StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,0,0,16"><Button Content="Mới" Click="OnNewClick"/><Button Content="Duplicate" Click="OnDuplicateClick"/><Button Content="Lưu tên" Style="{StaticResource AccentButton}" Click="OnRenameClick"/><Button Content="Xóa" Click="OnDeleteClick"/></WrapPanel>

                    <TextBlock Text="PROPERTY CỦA FAMILY" Style="{StaticResource SectionLabel}"/>
                    <ListView x:Name="PropertyList" Height="270" SelectionChanged="OnPropertySelectionChanged">
                        <ListView.View><GridView><GridViewColumn Header="Key" Width="210" DisplayMemberBinding="{Binding Key}"/><GridViewColumn Header="Value" Width="300" DisplayMemberBinding="{Binding Value}"/></GridView></ListView.View>
                    </ListView>
                    <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="PropertyKeyBox" Grid.Column="0" Margin="0,0,8,0" ToolTip="Property key"/>
                        <TextBox x:Name="PropertyValueBox" Grid.Column="1" Margin="8,0,0,0" ToolTip="Property value"/>
                    </Grid>
                    <WrapPanel Margin="0,0,0,16"><Button Content="Lưu property" Style="{StaticResource AccentButton}" Click="OnSavePropertyClick"/><Button Content="Xóa property" Click="OnRemovePropertyClick"/></WrapPanel>

                    <TextBlock Text="ÁP DỤNG" Style="{StaticResource SectionLabel}"/>
                    <Button Content="Gán Family đang chọn cho semantic selection" Style="{StaticResource AccentButton}" Click="OnAssignClick"/>
                    <TextBlock Text="QS3D chỉ cho gán Family cùng Category. Khi đổi Family, các giá trị chỉ là inherited-copy của Family cũ được thay bằng default mới; override instance khác biệt được giữ nguyên. Generated outputs được đánh stale để rebuild." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
