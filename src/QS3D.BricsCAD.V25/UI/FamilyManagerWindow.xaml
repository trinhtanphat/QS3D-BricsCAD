<Window x:Class="QS3D.BricsCAD.V25.UI.FamilyManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Family Manager" Width="920" Height="740"
        MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ContentRendered="OnQuickWorkflowContentRendered">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ManagerCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FAMILY MANAGER" FontSize="18" FontWeight="Bold"/>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="PARAMETRIC" Foreground="{StaticResource LuxuryBrush}"
                                       FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Chọn cấu kiện • nhập thông số QS • tạo và vẽ nhanh"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Click="OnRefreshClick"
                        Style="{StaticResource DenseButton}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ManagerCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="FAMILY CATALOG" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Lọc theo category" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                    </StackPanel>

                    <ComboBox x:Name="CategoryFilter" Grid.Row="1" Margin="0,0,0,8"
                              SelectionChanged="OnCategoryFilterChanged"/>

                    <ListView x:Name="FamilyList" Grid.Row="2" SelectionChanged="OnFamilySelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Tên" Width="180" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Category" Width="120" DisplayMemberBinding="{Binding Category}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="3" Background="{StaticResource Bg2Brush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="FAMILY ACTIVE" Style="{StaticResource Caption}"/>
                            <TextBlock x:Name="ActiveFamilyText" Text="—"
                                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Margin="0,2,0,0"/>
                            <Button Content="Đặt Family đang chọn làm active"
                                    Click="OnActivateClick" Style="{StaticResource AccentButton}"
                                    Margin="0,7,0,9"/>
                            <Grid x:Name="FamilyReferenceSummaryGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Instance tham chiếu"
                                           Style="{StaticResource Caption}"
                                           MinWidth="0"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ReferenceCountText"
                                           Grid.Column="1"
                                           Text="0" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentHoverBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource ManagerCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="THÔNG TIN FAMILY" Style="{StaticResource PanelTitle}"/>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Tên Family" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="FamilyNameBox"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Category khi tạo mới" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="NewCategoryCombo"/>
                                </StackPanel>
                            </Grid>
                            <WrapPanel>
                                <Button Content="Mới" Click="OnNewClick"/>
                                <Button Content="Nhân bản" Click="OnDuplicateClick"/>
                                <Button Content="Lưu tên" Style="{StaticResource AccentButton}" Click="OnRenameClick"/>
                                <Button Content="Xóa" Style="{StaticResource DangerButton}" Click="OnDeleteClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="QsQuickWorkflowCard" Style="{StaticResource ManagerCard}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="QS FORM • TẠO NHANH FAMILY" Style="{StaticResource PanelTitle}"/>
                                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                        CornerRadius="7" Padding="6,1">
                                    <TextBlock Text="DIRECT DRAW" Foreground="{StaticResource LuxuryBrush}"
                                               FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="QuickCategoryHintText"
                                       Text="Chọn cấu kiện hoặc Family; QS3D tự quản lý schema kỹ thuật phía sau."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="QuickWidthField" Grid.Row="0" Grid.Column="0" Margin="0,0,6,7">
                                    <TextBlock Text="Bề rộng (mm)" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="QuickWidthBox" ToolTip="Nhập bề rộng theo mm"/>
                                </StackPanel>
                                <StackPanel x:Name="QuickDepthField" Grid.Row="0" Grid.Column="1" Margin="6,0,6,7">
                                    <TextBlock Text="Bề sâu (mm)" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="QuickDepthBox" ToolTip="Nhập bề sâu theo mm"/>
                                </StackPanel>
                                <StackPanel x:Name="QuickHeightField" Grid.Row="0" Grid.Column="2" Margin="6,0,0,7">
                                    <TextBlock Text="Chiều cao (mm)" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="QuickHeightBox" ToolTip="Nhập chiều cao theo mm"/>
                                </StackPanel>
                                <StackPanel x:Name="QuickThicknessField" Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Bề dày (mm)" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="QuickThicknessBox" ToolTip="Nhập bề dày theo mm"/>
                                </StackPanel>
                                <StackPanel x:Name="QuickBottomOffsetField" Grid.Row="1" Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="Offset đáy (mm)" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="QuickBottomOffsetBox" ToolTip="Nhập offset đáy theo mm; có thể âm"/>
                                </StackPanel>
                                <StackPanel x:Name="QuickMaterialField" Grid.Row="1" Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="Vật liệu" Style="{StaticResource Caption}"/>
                                    <ComboBox x:Name="QuickMaterialCombo" IsEditable="True"
                                              ToolTip="Chọn hoặc nhập vật liệu quen thuộc"/>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                                           Text="QS3D tự đổi mm → m, tự đặt tên theo cấu kiện và giữ Key kỹ thuật trong mục nâng cao."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </Grid>

                            <WrapPanel Margin="0,9,0,0">
                                <Button Content="+ Tạo nhanh" Click="OnQuickCreateClick"/>
                                <Button Content="Auto Family" Click="OnAutoFamilyClick"/>
                                <Button Content="Lưu" Click="OnQuickSaveClick"/>
                                <Button Content="Tạo &amp; sử dụng" Style="{StaticResource AccentButton}"
                                        Click="OnCreateAndUseClick"/>
                                <Button Content="Lưu &amp; Vẽ" Style="{StaticResource AccentButton}"
                                        Click="OnSaveAndDrawClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ManagerCard}" Margin="0,0,0,10">
                        <Expander x:Name="AdvancedPropertyExpander" IsExpanded="False"
                                  Background="Transparent" Foreground="{StaticResource TextBrush}">
                            <Expander.Header>
                                <TextBlock Text="Thuộc tính nâng cao (Key/Value)" Style="{StaticResource PanelTitle}"/>
                            </Expander.Header>
                            <StackPanel Margin="0,8,0,0">
                                <Grid x:Name="FamilyPropertyHeaderGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="PROPERTY CỦA FAMILY"
                                               Style="{StaticResource PanelTitle}"
                                               MinWidth="0"
                                               Margin="0,0,8,0"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1"
                                               Text="KEY / VALUE"
                                               Foreground="{StaticResource LuxuryBrush}"
                                               FontSize="9" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"/>
                                </Grid>
                                <ListView x:Name="PropertyList" Height="270"
                                          SelectionChanged="OnPropertySelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Key" Width="210" DisplayMemberBinding="{Binding Key}"/>
                                            <GridViewColumn Header="Value" Width="300" DisplayMemberBinding="{Binding Value}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <Grid Margin="0,8,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PropertyKeyBox" Grid.Column="0" Margin="0,0,8,0"
                                             ToolTip="Property key"/>
                                    <TextBox x:Name="PropertyValueBox" Grid.Column="1" Margin="8,0,0,0"
                                             ToolTip="Property value"/>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="Lưu property" Style="{StaticResource AccentButton}"
                                            Click="OnSavePropertyClick"/>
                                    <Button Content="Xóa property" Style="{StaticResource DangerButton}"
                                            Click="OnRemovePropertyClick"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Style="{StaticResource ManagerCard}">
                        <StackPanel>
                            <TextBlock Text="ÁP DỤNG" Style="{StaticResource PanelTitle}"/>
                            <Button Content="Gán Family đang chọn cho semantic selection"
                                    Style="{StaticResource AccentButton}" Click="OnAssignClick"
                                    HorizontalAlignment="Left"/>
                            <TextBlock Text="QS3D chỉ cho gán Family cùng Category. Khi đổi Family, inherited-copy của Family cũ được thay bằng default mới; override instance khác biệt được giữ nguyên. Generated outputs được đánh stale để rebuild."
                                       Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}"
                Padding="11,7" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border Background="{StaticResource SuccessBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText" Text="Sẵn sàng"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
