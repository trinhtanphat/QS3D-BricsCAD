<Window x:Class="QS3D.BricsCAD.V25.UI.GeometryExtensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Geometry Extensions" Width="620" Height="760"
        MinWidth="560" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GeometryCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="GeometryCommand" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
            <Style x:Key="GeometryAccentCommand" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Margin" Value="0,2"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="GEOMETRY EXTENSIONS" FontWeight="Bold" FontSize="18"/>
                    <Border Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                        <TextBlock Text="REVIEW GATED" Foreground="{StaticResource LuxuryBrush}"
                                   FontWeight="SemiBold" FontSize="9"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Wall topology • opening booleans • generated rebar • health"
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <Border Style="{StaticResource GeometryCard}">
                    <StackPanel>
                        <TextBlock Text="WALL TOPOLOGY" Style="{StaticResource PanelTitle}"/>
                        <Button Content="Phân tích L / T / X + SnapPlan" Tag="QS3DWALLJUNCTIONS"
                                Style="{StaticResource GeometryAccentCommand}" Click="OnCommandClick"/>
                        <Button Content="Preview endpoint snap" Tag="QS3DWALLSNAPPREVIEW"
                                Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                        <Button Content="Apply previewed snap" Tag="QS3DWALLSNAPAPPLY"
                                Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                        <TextBlock Text="Apply chỉ dùng plan đã preview và phải qua source/plan fingerprint guards. Không dùng để blind-trim DWG."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GeometryCard}">
                    <StackPanel>
                        <TextBlock Text="OPENING / DOOR" Style="{StaticResource PanelTitle}"/>
                        <Button Content="Auto match host an toàn" Tag="QS3DAUTOLINKHOSTS"
                                Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                        <Button Content="Khoét host LINE / straight POLYLINE" Tag="QS3DCUTOPENINGS"
                                Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                        <Button Content="Khoét host cong / bulged POLYLINE" Tag="QS3DCUTOPENINGSCURVED"
                                Style="{StaticResource GeometryAccentCommand}" Click="OnCommandClick"/>
                        <TextBlock Text="Curved cut chuẩn bị cutter + fingerprint trước BoolSubtract; rerun cùng solid/fingerprint là idempotent."
                                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource GeometryCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="REBAR 3D" Style="{StaticResource PanelTitle}"/>
                            <Button Content="Cột — thanh dọc" Tag="QS3DREBAR3D" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Cột — đai chữ nhật" Tag="QS3DREBARTIES3D" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Dầm — thanh dọc" Tag="QS3DBEAMREBAR3D" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Dầm — đai chữ nhật" Tag="QS3DREBARSTIRRUP3D" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Sàn — lưới X/Y" Tag="QS3DSLABREBAR3D" Style="{StaticResource GeometryAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Vách BTCT — lưới ngang/dọc" Tag="QS3DWALLREBAR3D" Style="{StaticResource GeometryAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="BBS shape — STRAIGHT / L / U / S" Tag="QS3DREBAR3DSHAPE" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GeometryCard}" Margin="0">
                        <StackPanel>
                            <Grid x:Name="RebarHealthHeaderGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="REBAR HEALTH"
                                           Style="{StaticResource PanelTitle}"
                                           MinWidth="0"
                                           Margin="0,0,8,0"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1"
                                           Text="FAIL-CLOSED"
                                           Foreground="{StaticResource LuxuryBrush}"
                                           FontSize="9" FontWeight="SemiBold"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </Grid>
                            <Button Content="Health — thanh dọc cột/dầm" Tag="QS3DREBARHEALTH" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Health — BBS shape" Tag="QS3DREBARSHAPEHEALTH" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Health — đai cột" Tag="QS3DREBARTIEHEALTH" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Health — đai dầm" Tag="QS3DREBARSTIRRUPHEALTH" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Health — lưới sàn" Tag="QS3DSLABREBARHEALTH" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Health — lưới vách" Tag="QS3DWALLREBARHEALTH" Style="{StaticResource GeometryCommand}" Click="OnCommandClick"/>
                            <Button Content="Health — tất cả generated rebar" Tag="QS3DREBARHEALTHALL" Style="{StaticResource GeometryAccentCommand}" Click="OnCommandClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="11,7" BorderThickness="0,1,0,0">
            <Grid x:Name="GeometryStatusGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Background="{StaticResource WarningBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="1"
                           Text="Các native geometry path vẫn cần Gate C BricsCAD V25 thật trước release."
                           Foreground="{StaticResource MutedBrush}"
                           MinWidth="0"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2"
                           Text="PREVIEW / FINGERPRINT / HEALTH GATES"
                           Style="{StaticResource Caption}"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
