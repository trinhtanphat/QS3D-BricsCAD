<UserControl x:Class="QS3D.BricsCAD.V25.UI.WorkspacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="0" MinHeight="0"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             DataContextChanged="OnWorkspaceDataContextChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="PropertyTextEditor">
                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         MinHeight="24" Padding="6,2"
                         ToolTip="{Binding Value}"/>
            </DataTemplate>
            <DataTemplate x:Key="PropertyBooleanEditor">
                <Border MinHeight="24" Padding="4,0" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsEditable}"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              ToolTip="Bật / Tắt"/>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="PropertyChoiceEditor">
                <ComboBox ItemsSource="{Binding Choices}"
                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                          IsEditable="True" IsEnabled="{Binding IsEditable}"
                          MinHeight="24" Padding="4,0"
                          ToolTip="Chọn giá trị đã dùng hoặc nhập giá trị mới"/>
            </DataTemplate>

            <Style x:Key="WorkspaceCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="8"/>
            </Style>
            <Style x:Key="WorkspaceBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="9"/>
                <Setter Property="Padding" Value="7,2"/>
                <Setter Property="Margin" Value="5,0,0,0"/>
            </Style>
            <Style x:Key="WorkspaceToolbarBand" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
            </Style>
            <Style x:Key="WorkspaceSearchBand" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bg0Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="3"/>
            </Style>
            <Style x:Key="WorkspacePropertyRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="Padding" Value="2,3"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="WorkspaceStatePill" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="Padding" Value="5,0"/>
                <Setter Property="Margin" Value="0,2,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="WorkspaceOverflow"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="HorizontalOnly"
                  Focusable="False"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch">
    <Grid x:Name="WorkspaceContentRoot"
          Width="{Binding ViewportWidth, ElementName=WorkspaceOverflow}"
          MinWidth="560"
          Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="33"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1Brush}"
                BorderThickness="0,0,0,1" Padding="9,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="QS3D" FontWeight="Bold" FontSize="14"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                            Padding="7,1" Margin="7,0,0,0">
                        <TextBlock Text="V25" Foreground="White" FontWeight="SemiBold" FontSize="9"/>
                    </Border>
                    <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="7,1" Margin="5,0,0,0">
                        <TextBlock Text="BIM WORKSPACE" Style="{StaticResource Caption}"/>
                    </Border>
                    <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="7,1" Margin="5,0,0,0">
                        <TextBlock Text="SEMANTIC MODEL" Foreground="{StaticResource LuxuryBrush}"
                                   FontWeight="SemiBold" FontSize="9"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Status}"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                           Margin="10,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="3D" ToolTip="Góc nhìn 3D isometric"
                            Click="OnViewModel3DClick" Style="{StaticResource DenseButton}"/>
                    <Button Content="Xoay 3D" ToolTip="Orbit mô hình BricsCAD thật"
                            Click="OnOrbitClick" Style="{StaticResource DenseButton}"/>
                    <Button Content="Zoom chọn" ToolTip="Zoom tới đối tượng đang chọn"
                            Click="OnZoomSelectionClick" Style="{StaticResource DenseButton}"/>
                    <Button Content="Lưu" ToolTip="Lưu project QS3D"
                            Click="OnSaveClick" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" MinWidth="135"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="245" MinWidth="220"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg1Brush}"
                    BorderThickness="0,0,1,0" Padding="7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Style="{StaticResource WorkspaceCard}" Background="{StaticResource Bg2Brush}"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock Text="PHẠM VI LÀM VIỆC" Style="{StaticResource PanelTitle}" Margin="0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="ACTIVE"
                                               Foreground="{StaticResource SuccessBrush}" FontSize="8.5"
                                               FontWeight="SemiBold"/>
                                </DockPanel>
                                <TextBlock Text="Zone" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ZoneCombo" ItemsSource="{Binding Zones}"
                                          SelectionChanged="OnZoneChanged"/>
                                <TextBlock Text="Tầng" Style="{StaticResource Caption}" Margin="0,7,0,2"/>
                                <ComboBox x:Name="FloorCombo" ItemsSource="{Binding Floors}"
                                          SelectionChanged="OnFloorChanged"/>
                            </StackPanel>
                        </Border>

                        <DockPanel Margin="0,0,0,5">
                            <StackPanel>
                                <TextBlock Text="MÔ HÌNH" Style="{StaticResource PanelTitle}" Margin="0"/>
                                <TextBlock Text="Category / hệ thống" Style="{StaticResource Caption}"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="Làm mới"
                                    ToolTip="Làm mới project, Xref và layer"
                                    Click="OnRefreshClick" Style="{StaticResource DenseButton}"/>
                        </DockPanel>
                    </StackPanel>

                    <TreeView x:Name="ModelTree" SelectedItemChanged="OnModelTreeSelectedItemChanged">
                        <TreeViewItem Header="Lưới Trục" Tag="Grid"/>
                        <TreeViewItem Header="HT_Phòng" IsExpanded="True">
                            <TreeViewItem Header="Phòng" Tag="Room" IsSelected="True"/>
                            <TreeViewItem Header="Sàn Hoàn Thiện" Tag="FloorFinish"/>
                            <TreeViewItem Header="Chống Thấm" Tag="Waterproofing"/>
                            <TreeViewItem Header="Chân Tường" Tag="Skirting"/>
                            <TreeViewItem Header="Hoàn Thiện Tường" Tag="WallFinish"/>
                            <TreeViewItem Header="Trần Hoàn Thiện" Tag="CeilingFinish"/>
                            <TreeViewItem Header="Lan Can" Tag="Railing"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Dầm" Tag="Beam"/>
                        <TreeViewItem Header="Sàn" Tag="Slab"/>
                        <TreeViewItem Header="Cột" Tag="Column"/>
                        <TreeViewItem Header="Vách" Tag="StructuralWall"/>
                        <TreeViewItem Header="Tường KT" IsExpanded="True">
                            <TreeViewItem Header="Tường Gạch" Tag="ArchitecturalWall"/>
                            <TreeViewItem Header="Vách Kính" Tag="GlassWall"/>
                            <TreeViewItem Header="Trụ Tường" Tag="WallPier"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Cửa" IsExpanded="True">
                            <TreeViewItem Header="Lỗ Mở Vách" Tag="WallOpening"/>
                            <TreeViewItem Header="Cửa Đi" Tag="Door"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Cầu Thang" Tag="Stair"/>
                        <TreeViewItem Header="Móng" Tag="Foundation"/>
                        <TreeViewItem Header="Đào đắp" Tag="Earthwork"/>
                        <TreeViewItem Header="KL Tùy chỉnh" Tag="CustomQuantity"/>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4"
                          Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Background="{StaticResource Bg1Brush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" MinHeight="160"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="0,0,1,1" Padding="7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="FAMILY / TYPE" Style="{StaticResource PanelTitle}" Margin="0"/>
                                    <TextBlock Text="Kiểu cấu kiện đang làm việc" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource WorkspaceBadge}">
                                    <TextBlock Text="{Binding Families.Count, StringFormat={}{0} mục}"
                                               Style="{StaticResource Caption}"/>
                                </Border>
                            </DockPanel>

                            <WrapPanel Margin="0,5,0,0">
                                <Button Content="+ Thêm" Style="{StaticResource AccentButton}"
                                        Click="OnAddClick" ToolTip="Tạo Family / Type mới"/>
                                <Button Content="Xóa" Style="{StaticResource DangerButton}"
                                        Click="OnDeleteClick" ToolTip="Xóa Family / Type đang chọn"/>
                                <Button Content="Bóc chọn" Click="OnCaptureSelectedClick"
                                        ToolTip="Ghi đối tượng CAD đang chọn vào đúng nhóm mô hình/Family hiện tại"/>
                                <Button Content="Vẽ 3D" Click="OnView3DClick"
                                        ToolTip="Tạo hoặc cập nhật hình học 3D native cho cấu kiện đang chọn"/>
                            </WrapPanel>

                            <Border Style="{StaticResource WorkspaceToolbarBand}">
                                <WrapPanel>
                                    <Button Content="Giao tường" Click="OnWallJunctionsClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Phân tích giao tim tường L / T / X trong selection"/>
                                    <Button Content="Snap xem" Click="OnWallSnapPreviewClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Xem trước kế hoạch làm sạch đầu mút tim tường; chưa sửa CAD"/>
                                    <Button Content="Snap áp" Click="OnWallSnapApplyClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Áp dụng đúng preview snap còn hợp lệ; từ chối preview cũ/stale"/>
                                    <Button Content="Auto Host" Click="OnAutoHostClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Tự ghép Cửa/Lỗ đang chọn với wall host an toàn; không tự khoét solid"/>
                                </WrapPanel>
                            </Border>

                            <TextBlock Text="Tìm Family / Type" Style="{StaticResource Caption}"
                                       Margin="1,6,1,2"/>
                            <TextBox x:Name="FamilySearch"
                                     ToolTip="Tìm theo tên Family hoặc loại cấu kiện"
                                     TextChanged="OnFamilySearchChanged"/>
                        </StackPanel>

                        <ListBox x:Name="FamilyList" ItemsSource="{Binding Families}"
                                 SelectionChanged="OnFamilySelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource WorkspaceStatePill}"
                                                VerticalAlignment="Center" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Properties.Count, StringFormat={}{0} thuộc tính}"
                                                       Style="{StaticResource Caption}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4"
                              Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch"/>

                <Border Grid.Row="2" BorderThickness="0,1,1,0" Padding="7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel Margin="0,0,0,5">
                                <StackPanel>
                                    <TextBlock Text="THUỘC TÍNH" Style="{StaticResource PanelTitle}" Margin="0"/>
                                    <TextBlock Text="{Binding SelectedFamilyName}"
                                               Style="{StaticResource Caption}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedFamilyName}"
                                               MaxWidth="145"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource WorkspaceBadge}">
                                    <TextBlock Text="{Binding Properties.Count, StringFormat={}{0} dòng}"
                                               Style="{StaticResource Caption}"/>
                                </Border>
                            </DockPanel>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Phạm vi sửa" Style="{StaticResource Caption}"/>
                                <ComboBox Grid.Column="1" MinHeight="24"
                                          ItemsSource="{Binding PropertyScopes}"
                                          SelectedItem="{Binding SelectedPropertyScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Chọn sửa Family/Type hoặc override của cấu kiện đang chọn"/>
                            </Grid>

                            <TextBlock Text="Tìm thuộc tính" Style="{StaticResource Caption}" Margin="1,0,1,2"/>
                            <Border Style="{StaticResource WorkspaceSearchBand}" Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PropertySearch" BorderThickness="0"
                                             Background="Transparent" MinHeight="22"
                                             Padding="4,1"
                                             ToolTip="Lọc theo nhóm, tên, đơn vị, giá trị hoặc trạng thái thuộc tính"
                                             TextChanged="OnPropertySearchChanged"/>
                                    <Button Grid.Column="1" Content="×"
                                            Style="{StaticResource DenseButton}"
                                            Padding="5,0" MinHeight="20"
                                            ToolTip="Xóa bộ lọc thuộc tính"
                                            Click="OnClearPropertySearchClick"/>
                                </Grid>
                            </Border>

                            <Border Background="{StaticResource Bg2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="4"
                                    Padding="5,3" Margin="0,0,0,4">
                                <TextBlock Text="Family • Kế thừa • Override • CAD/đo • Hệ thống • Selection"
                                           Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                        </StackPanel>

                        <ListView x:Name="PropertyList" ItemsSource="{Binding Properties}">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Bg2Brush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="5,3" Margin="0,5,0,1">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource GroupHeader}"
                                                               Margin="0"/>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding ItemCount, StringFormat={}{0}}"
                                                               Style="{StaticResource Caption}"/>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource WorkspacePropertyRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center" Margin="0,0,5,0">
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <Border Style="{StaticResource WorkspaceStatePill}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="8.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Cad">
                                                                        <Setter Property="Foreground" Value="{StaticResource LuxuryBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Override">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Selection">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Multi">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>

                                            <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate"
                                                                Value="{StaticResource PropertyTextEditor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EditorKind}" Value="Boolean">
                                                                <Setter Property="ContentTemplate"
                                                                        Value="{StaticResource PropertyBooleanEditor}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding EditorKind}" Value="Choice">
                                                                <Setter Property="ContentTemplate"
                                                                        Value="{StaticResource PropertyChoiceEditor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>

                                            <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                       Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Center"
                                                       Margin="3,0,0,0"/>

                                            <Button Grid.Column="3" Content="↺"
                                                    CommandParameter="{Binding}"
                                                    Click="OnResetPropertyClick"
                                                    ToolTip="Reset override về giá trị Family">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource DenseButton}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Padding" Value="4,1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanReset}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4"
                          Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="4" Background="{StaticResource Bg1Brush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="218" MinHeight="135"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="HT_PHÒNG" Style="{StaticResource PanelTitle}" Margin="0"/>
                                    <TextBlock Text="Hoàn thiện theo phòng" Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource WorkspaceBadge}">
                                    <TextBlock x:Name="SelectionCount" Text="0 chọn"
                                               Style="{StaticResource Caption}"/>
                                </Border>
                            </DockPanel>
                            <WrapPanel Margin="0,5,0,0">
                                <Button Content="+ Thêm" Style="{StaticResource AccentButton}"
                                        Click="OnAddFinishClick"
                                        ToolTip="Tạo/cập nhật hoàn thiện cho phòng đang chọn"/>
                                <Button Content="Bỏ HT" Style="{StaticResource DangerButton}"
                                        Click="OnRemoveFinishClick"
                                        ToolTip="Chỉ bỏ theo dõi cấu kiện hoàn thiện; giữ nguyên CAD"/>
                                <Button Content="Chọn phòng" Click="OnPickRoomClick"
                                        ToolTip="Chọn phòng trực tiếp trong BricsCAD"/>
                            </WrapPanel>
                        </StackPanel>

                        <TreeView>
                            <TreeViewItem Header="Sàn Hoàn Thiện" Tag="FloorFinish"/>
                            <TreeViewItem Header="Chống Thấm" Tag="Waterproofing"/>
                            <TreeViewItem Header="Chân Tường" Tag="Skirting"/>
                            <TreeViewItem Header="Hoàn Thiện Tường" Tag="WallFinish"/>
                            <TreeViewItem Header="Trần Hoàn Thiện" Tag="CeilingFinish"/>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4"
                              Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch"/>

                <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="ĐỐI TƯỢNG ĐANG CHỌN"
                                               Style="{StaticResource PanelTitle}" Margin="0"/>
                                    <TextBlock Text="Handle • loại • layer • kích thước"
                                               Style="{StaticResource Caption}"/>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Right" Text="CAD + SEMANTIC"
                                           Foreground="{StaticResource LuxuryBrush}"
                                           FontWeight="SemiBold" FontSize="9"
                                           Margin="5,0,0,6"/>
                            </DockPanel>

                            <Border Style="{StaticResource WorkspaceToolbarBand}" Margin="0,5,0,5">
                                <WrapPanel>
                                    <Button Content="Focus" Click="OnFocusSelectedClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Zoom và highlight đối tượng đang chọn"/>
                                    <Button Content="Cô lập" Click="OnIsolateSelectedClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Tạm ẩn các đối tượng khác"/>
                                    <Button Content="Khôi phục" Click="OnUnisolateClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Khôi phục các đối tượng bị isolate"/>
                                    <Button Content="Định vị" Click="OnLocateSelectedClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Định vị đối tượng đang chọn trong bản vẽ"/>
                                    <Button Content="Mặt bằng" Click="OnTopViewClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Chuyển về góc nhìn mặt bằng"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>

                        <ListView x:Name="InspectionList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Handle" Width="62"
                                                    DisplayMemberBinding="{Binding Handle}"/>
                                    <GridViewColumn Header="Loại" Width="82"
                                                    DisplayMemberBinding="{Binding EntityType}"/>
                                    <GridViewColumn Header="Layer" Width="105"
                                                    DisplayMemberBinding="{Binding Layer}"/>
                                    <GridViewColumn Header="Dài" Width="60"
                                                    DisplayMemberBinding="{Binding LengthDrawingUnits}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}"
                BorderThickness="0,1,0,0" Padding="6,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Mô hình" Style="{StaticResource AccentButton}"
                            Click="OnViewModel3DClick"/>
                    <Button Content="BQ" Click="OnQuantityClick"
                            ToolTip="Bảng tổng hợp khối lượng"/>
                    <Button Content="Kiểm tra" Click="OnHealthClick"
                            ToolTip="Kiểm tra tính toàn vẹn mô hình"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LIVE SEMANTIC" Foreground="{StaticResource SuccessBrush}"
                               FontWeight="SemiBold" FontSize="8.5" Margin="0,0,8,0"/>
                    <TextBlock Text="VIEWPORT BRICSCAD • PAN • ZOOM • ORBIT • PICK"
                               Style="{StaticResource Caption}" Margin="0,0,5,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
