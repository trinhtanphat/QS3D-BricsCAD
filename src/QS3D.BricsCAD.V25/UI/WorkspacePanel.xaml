<UserControl x:Class="QS3D.BricsCAD.V25.UI.WorkspacePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="620" MinHeight="560">
<UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
<Grid Background="{StaticResource Bg0Brush}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Grid.Row="0"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="5"/><ColumnDefinition Width="225"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource Bg1Brush}" BorderThickness="0,0,1,0" Padding="7"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="▌ Zone làm việc" FontWeight="SemiBold"/><ComboBox SelectedIndex="0" Margin="0,5,0,8"><ComboBoxItem Content="Vùng-1"/></ComboBox><TextBlock Text="▌ Tầng làm việc" FontWeight="SemiBold"/><ComboBox SelectedIndex="0" Margin="0,5,0,6"><ComboBoxItem Content="Tầng trệt"/><ComboBoxItem Content="Nền 0.00"/></ComboBox></StackPanel>
<TreeView Margin="0,5,0,0"><TreeViewItem Header="⌖  Lưới Trục"/><TreeViewItem Header="▣  HT_Phòng" IsExpanded="True"><TreeViewItem Header="▱  Phòng" IsSelected="True"/><TreeViewItem Header="▧  Sàn Hoàn Thiện"/><TreeViewItem Header="≋  Chống Thấm"/><TreeViewItem Header="⌞  Chân Tường"/><TreeViewItem Header="▨  Hoàn Thiện Tường"/><TreeViewItem Header="⊞  Trần Hoàn Thiện"/><TreeViewItem Header="▥  Lan Can"/></TreeViewItem><TreeViewItem Header="▰  Dầm"/><TreeViewItem Header="▬  Sàn"/><TreeViewItem Header="▯  Cột"/><TreeViewItem Header="▥  Vách"/><TreeViewItem Header="▣  Tường KT" IsExpanded="True"><TreeViewItem Header="▤  Tường Gạch"/><TreeViewItem Header="▥  Vách Kính"/><TreeViewItem Header="✚  Trụ Tường"/></TreeViewItem><TreeViewItem Header="⌑  Cửa" IsExpanded="True"><TreeViewItem Header="▣  Lỗ Mở Vách"/><TreeViewItem Header="⌜  Cửa Đi"/></TreeViewItem><TreeViewItem Header="⌁  Cầu Thang"/><TreeViewItem Header="▰  Móng"/><TreeViewItem Header="▱  Đào đắp"/><TreeViewItem Header="▥  KL Tùy chỉnh"/></TreeView></DockPanel></Border>
<GridSplitter Grid.Column="1" Width="5" Background="{StaticResource BorderBrush}"/>
<Grid Grid.Column="2" Background="{StaticResource Bg1Brush}"><Grid.RowDefinitions><RowDefinition Height="245"/><RowDefinition Height="5"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Grid.Row="0" Padding="7" BorderThickness="0,0,1,1"><DockPanel><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal"><Button Content="✚ Add" Click="OnAddClick"/><Button Content="▱ Delete" Click="OnDeleteClick" Background="{StaticResource DangerBrush}"/><Button Content="◩ Vẽ 3D" Click="OnView3DClick"/></StackPanel><TextBox ToolTip="Tìm family/cấu kiện" Margin="2,5"/></StackPanel><ListView x:Name="ElementList"><ListViewItem Content="▣  Phòng-1                         0 cấu kiện"/></ListView></DockPanel></Border>
<GridSplitter Grid.Row="1" Height="5" Background="{StaticResource BorderBrush}"/>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><Border Padding="8" BorderThickness="0,1,1,0"><StackPanel><DockPanel><TextBlock Text="Thuộc tính" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" Text="Phòng-1" FontStyle="Italic" Foreground="{StaticResource MutedBrush}"/></DockPanel><TextBlock Text="Information" Style="{StaticResource SectionLabel}"/>
<Grid Style="{StaticResource PropertyGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Tên Family"/><TextBox Grid.Column="1" Text="Phòng-1"/><TextBlock Grid.Row="1" Text="Loại cấu kiện"/><TextBox Grid.Row="1" Grid.Column="1" Text="Phòng"/><TextBlock Grid.Row="2" Text="Tầng"/><TextBox Grid.Row="2" Grid.Column="1" Text="Tầng trệt"/></Grid>
<TextBlock Text="Cao độ" Style="{StaticResource SectionLabel}"/><Grid Style="{StaticResource PropertyGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Cao độ đầu"/><ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="bottom_level"/></ComboBox><TextBlock Grid.Row="1" Text="Cao độ đáy"/><ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="bottom_level"/></ComboBox></Grid>
<TextBlock Text="Display" Style="{StaticResource SectionLabel}"/><Grid Style="{StaticResource PropertyGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Màu sắc"/><ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Theo loại (mặc định)"/></ComboBox><TextBlock Grid.Row="1" Text="Độ trong suốt"/><ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="70%"/></ComboBox></Grid>
<TextBlock Text="Metadata" Style="{StaticResource SectionLabel}"/><Grid Style="{StaticResource PropertyGrid}"><Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Mark"/><TextBox Grid.Column="1"/><TextBlock Grid.Row="1" Text="Comment"/><TextBox Grid.Row="1" Grid.Column="1"/><TextBlock Grid.Row="2" Text="WBS"/><TextBox Grid.Row="2" Grid.Column="1"/><TextBlock Grid.Row="3" Text="Vật liệu"/><ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="Khác"/><ComboBoxItem Content="Gạch"/></ComboBox></Grid></StackPanel></Border></ScrollViewer></Grid>
<GridSplitter Grid.Column="3" Width="5" Background="{StaticResource BorderBrush}"/>
<Border Grid.Column="4" Background="{StaticResource Bg1Brush}" Padding="8"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="Ngoài nhà" FontWeight="Bold"/><TextBlock DockPanel.Dock="Right" x:Name="SelectionCount" Text="0" Foreground="{StaticResource MutedBrush}"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,6"><Button Content="✚ Thêm"/><Button Content="▱ Bỏ" Background="{StaticResource DangerBrush}"/><Button Content="▦ Tạo hoàn thiện"/></StackPanel><TreeView Height="120"><TreeViewItem Header="▱ Sàn Hoàn Thiện"/><TreeViewItem Header="≋ Chống Thấm"/><TreeViewItem Header="⌞ Chân Tường"/><TreeViewItem Header="▨ Hoàn Thiện Tường"/><TreeViewItem Header="⊞ Trần Hoàn Thiện"/></TreeView><TextBlock Text="Thuộc tính đối tượng đang chọn" FontWeight="SemiBold" Margin="0,9,0,5"/></StackPanel><ListView x:Name="InspectionList"><ListView.View><GridView><GridViewColumn Header="Handle" Width="72" DisplayMemberBinding="{Binding Handle}"/><GridViewColumn Header="Loại" Width="95" DisplayMemberBinding="{Binding EntityType}"/><GridViewColumn Header="Layer" Width="120" DisplayMemberBinding="{Binding Layer}"/><GridViewColumn Header="Length" Width="75" DisplayMemberBinding="{Binding LengthDrawingUnits}"/></GridView></ListView.View></ListView></DockPanel></Border>
</Grid><Border Grid.Row="1" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="5"><DockPanel><Button Content="Mô hình" Background="{StaticResource AccentBrush}"/><Button Content="BQ" Click="OnQuantityClick"/><TextBlock DockPanel.Dock="Right" Text="○ Nền sáng   ◐ Tương phản   ⊥ Vuông góc   ⌁ Bắt điểm" Foreground="{StaticResource MutedBrush}"/></DockPanel></Border></Grid></UserControl>
