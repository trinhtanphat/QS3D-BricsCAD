<UserControl x:Class="QS3D.BricsCAD.V25.UI.WorkspacePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="485" MinHeight="520">
<UserControl.Resources>
<ResourceDictionary>
<ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
<DataTemplate x:Key="PropertyTextEditor"><TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly}" MinHeight="21" Padding="4,2"/></DataTemplate>
<DataTemplate x:Key="PropertyBooleanEditor"><CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="Bật / Tắt"/></DataTemplate>
<DataTemplate x:Key="PropertyChoiceEditor"><ComboBox ItemsSource="{Binding Choices}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" IsEditable="True" IsEnabled="{Binding IsEditable}" MinHeight="21" Padding="2,0" ToolTip="Chọn giá trị đã dùng hoặc nhập giá trị mới"/></DataTemplate>
</ResourceDictionary>
</UserControl.Resources>
<Grid Background="{StaticResource Bg0Brush}"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="{StaticResource Bg1Brush}" BorderThickness="0,0,0,1" Padding="6,4"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><TextBlock Text="QS3D" FontWeight="Bold" FontSize="13"/><Border Background="{StaticResource AccentBrush}" CornerRadius="2" Padding="5,1" Margin="6,0,0,0"><TextBlock Text="V25" FontSize="9"/></Border></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="3D" ToolTip="Góc nhìn 3D isometric" Click="OnViewModel3DClick" Style="{StaticResource DenseButton}"/><Button Content="Xoay 3D" ToolTip="Orbit mô hình BricsCAD thật" Click="OnOrbitClick" Style="{StaticResource DenseButton}"/><Button Content="Zoom chọn" ToolTip="Zoom tới đối tượng đang chọn" Click="OnZoomSelectionClick" Style="{StaticResource DenseButton}"/><Button Content="Lưu" ToolTip="Lưu project QS3D" Click="OnSaveClick" Style="{StaticResource AccentButton}"/></StackPanel><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Margin="8,0"/></DockPanel></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="150" MinWidth="125"/><ColumnDefinition Width="4"/><ColumnDefinition Width="180" MinWidth="150"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*" MinWidth="145"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource Bg1Brush}" BorderThickness="0,0,1,0" Padding="6"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Zone làm việc" Style="{StaticResource SectionLabel}" Margin="0,0,0,3"/><ComboBox x:Name="ZoneCombo" ItemsSource="{Binding Zones}" SelectionChanged="OnZoneChanged"/><TextBlock Text="Tầng làm việc" Style="{StaticResource SectionLabel}"/><ComboBox x:Name="FloorCombo" ItemsSource="{Binding Floors}" SelectionChanged="OnFloorChanged"/><DockPanel Margin="0,8,0,3"><TextBlock Text="MÔ HÌNH" Style="{StaticResource SectionLabel}" Margin="0"/><Button DockPanel.Dock="Right" Content="Làm mới" ToolTip="Làm mới project, Xref và layer" Click="OnRefreshClick" Style="{StaticResource DenseButton}"/></DockPanel></StackPanel><TreeView x:Name="ModelTree" SelectedItemChanged="OnModelTreeSelectedItemChanged"><TreeViewItem Header="Lưới Trục" Tag="Grid"/><TreeViewItem Header="HT_Phòng" IsExpanded="True"><TreeViewItem Header="Phòng" Tag="Room" IsSelected="True"/><TreeViewItem Header="Sàn Hoàn Thiện" Tag="FloorFinish"/><TreeViewItem Header="Chống Thấm" Tag="Waterproofing"/><TreeViewItem Header="Chân Tường" Tag="Skirting"/><TreeViewItem Header="Hoàn Thiện Tường" Tag="WallFinish"/><TreeViewItem Header="Trần Hoàn Thiện" Tag="CeilingFinish"/><TreeViewItem Header="Lan Can" Tag="Railing"/></TreeViewItem><TreeViewItem Header="Dầm" Tag="Beam"/><TreeViewItem Header="Sàn" Tag="Slab"/><TreeViewItem Header="Cột" Tag="Column"/><TreeViewItem Header="Vách" Tag="StructuralWall"/><TreeViewItem Header="Tường KT" IsExpanded="True"><TreeViewItem Header="Tường Gạch" Tag="ArchitecturalWall"/><TreeViewItem Header="Vách Kính" Tag="GlassWall"/><TreeViewItem Header="Trụ Tường" Tag="WallPier"/></TreeViewItem><TreeViewItem Header="Cửa" IsExpanded="True"><TreeViewItem Header="Lỗ Mở Vách" Tag="WallOpening"/><TreeViewItem Header="Cửa Đi" Tag="Door"/></TreeViewItem><TreeViewItem Header="Cầu Thang" Tag="Stair"/><TreeViewItem Header="Móng" Tag="Foundation"/><TreeViewItem Header="Đào đắp" Tag="Earthwork"/><TreeViewItem Header="KL Tùy chỉnh" Tag="CustomQuantity"/></TreeView></DockPanel></Border>
<GridSplitter Grid.Column="1" Width="4" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch"/>
<Grid Grid.Column="2" Background="{StaticResource Bg1Brush}"><Grid.RowDefinitions><RowDefinition Height="235" MinHeight="145"/><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" BorderThickness="0,0,1,1" Padding="6"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="FAMILY / TYPE" Style="{StaticResource PanelTitle}"/><TextBlock DockPanel.Dock="Right" Text="{Binding Families.Count, StringFormat={}{0} mục}" Style="{StaticResource Caption}"/></DockPanel><WrapPanel><Button Content="+ Thêm" Style="{StaticResource AccentButton}" Click="OnAddClick"/><Button Content="Xóa" Style="{StaticResource DangerButton}" Click="OnDeleteClick"/><Button Content="Bóc chọn" Click="OnCaptureSelectedClick" ToolTip="Ghi đối tượng CAD đang chọn vào đúng nhóm mô hình/Family hiện tại"/><Button Content="Vẽ 3D" Click="OnView3DClick" ToolTip="Tạo hoặc cập nhật hình học 3D native cho cấu kiện đang chọn"/><Button Content="Giao tường" Click="OnWallJunctionsClick" ToolTip="Phân tích giao tim tường L / T / X trong selection"/></WrapPanel><TextBox x:Name="FamilySearch" Margin="1,5,1,4" ToolTip="Tìm theo tên Family hoặc loại cấu kiện" TextChanged="OnFamilySearchChanged"/></StackPanel><ListBox x:Name="FamilyList" ItemsSource="{Binding Families}" SelectionChanged="OnFamilySelectionChanged" DisplayMemberPath="Name"/></DockPanel></Border><GridSplitter Grid.Row="1" Height="4" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch"/><Border Grid.Row="2" BorderThickness="0,1,1,0" Padding="6"><DockPanel><DockPanel DockPanel.Dock="Top"><TextBlock Text="THUỘC TÍNH" Style="{StaticResource PanelTitle}"/><TextBlock DockPanel.Dock="Right" Text="{Binding SelectedFamilyName}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFamilyName}"/></DockPanel><ListView x:Name="PropertyList" ItemsSource="{Binding Properties}"><ListView.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Style="{StaticResource GroupHeader}"/></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle><ListView.ItemTemplate><DataTemplate><Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/><ContentControl Grid.Column="1" Content="{Binding}"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource PropertyTextEditor}"/><Style.Triggers><DataTrigger Binding="{Binding EditorKind}" Value="Boolean"><Setter Property="ContentTemplate" Value="{StaticResource PropertyBooleanEditor}"/></DataTrigger><DataTrigger Binding="{Binding EditorKind}" Value="Choice"><Setter Property="ContentTemplate" Value="{StaticResource PropertyChoiceEditor}"/></DataTrigger></Style.Triggers></Style></ContentControl.Style></ContentControl><TextBlock Grid.Column="2" Text="{Binding Unit}" Style="{StaticResource Caption}" Margin="3,0,0,0"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></DockPanel></Border></Grid>
<GridSplitter Grid.Column="3" Width="4" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch"/>
<Grid Grid.Column="4" Background="{StaticResource Bg1Brush}"><Grid.RowDefinitions><RowDefinition Height="210" MinHeight="130"/><RowDefinition Height="4"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="6"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="HT_PHÒNG" Style="{StaticResource PanelTitle}"/><TextBlock DockPanel.Dock="Right" x:Name="SelectionCount" Text="0 chọn" Style="{StaticResource Caption}"/></DockPanel><StackPanel Orientation="Horizontal"><Button Content="+ Thêm" Style="{StaticResource AccentButton}" Click="OnAddFinishClick" ToolTip="Tạo/cập nhật hoàn thiện cho phòng đang chọn"/><Button Content="Bỏ HT" Style="{StaticResource DangerButton}" Click="OnRemoveFinishClick" ToolTip="Chỉ bỏ theo dõi cấu kiện hoàn thiện; giữ nguyên CAD"/><Button Content="Chọn phòng" Click="OnPickRoomClick"/></StackPanel></StackPanel><TreeView><TreeViewItem Header="Sàn Hoàn Thiện" Tag="FloorFinish"/><TreeViewItem Header="Chống Thấm" Tag="Waterproofing"/><TreeViewItem Header="Chân Tường" Tag="Skirting"/><TreeViewItem Header="Hoàn Thiện Tường" Tag="WallFinish"/><TreeViewItem Header="Trần Hoàn Thiện" Tag="CeilingFinish"/></TreeView></DockPanel></Border><GridSplitter Grid.Row="1" Height="4" Background="{StaticResource BorderBrush}" HorizontalAlignment="Stretch"/><Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="6"><DockPanel><DockPanel DockPanel.Dock="Top"><TextBlock Text="ĐỐI TƯỢNG ĐANG CHỌN" Style="{StaticResource PanelTitle}"/><WrapPanel DockPanel.Dock="Right"><Button Content="Focus" Click="OnFocusSelectedClick" Style="{StaticResource DenseButton}" ToolTip="Zoom và highlight đối tượng đang chọn"/><Button Content="Cô lập" Click="OnIsolateSelectedClick" Style="{StaticResource DenseButton}" ToolTip="Tạm ẩn các đối tượng khác"/><Button Content="Khôi phục" Click="OnUnisolateClick" Style="{StaticResource DenseButton}" ToolTip="Khôi phục các đối tượng bị isolate"/><Button Content="Định vị" Click="OnLocateSelectedClick" Style="{StaticResource DenseButton}"/><Button Content="Mặt bằng" Click="OnTopViewClick" Style="{StaticResource DenseButton}"/></WrapPanel></DockPanel><ListView x:Name="InspectionList"><ListView.View><GridView><GridViewColumn Header="Handle" Width="62" DisplayMemberBinding="{Binding Handle}"/><GridViewColumn Header="Loại" Width="82" DisplayMemberBinding="{Binding EntityType}"/><GridViewColumn Header="Layer" Width="105" DisplayMemberBinding="{Binding Layer}"/><GridViewColumn Header="Dài" Width="60" DisplayMemberBinding="{Binding LengthDrawingUnits}"/></GridView></ListView.View></ListView></DockPanel></Border></Grid></Grid>
<Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="5,2"><DockPanel><StackPanel Orientation="Horizontal"><Button Content="Mô hình" Style="{StaticResource AccentButton}" Click="OnViewModel3DClick"/><Button Content="BQ" Click="OnQuantityClick" ToolTip="Bảng tổng hợp khối lượng"/><Button Content="Kiểm tra" Click="OnHealthClick" ToolTip="Kiểm tra tính toàn vẹn mô hình"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="VIEWPORT BRICSCAD • PAN • ZOOM • ORBIT • PICK" Style="{StaticResource Caption}" Margin="0,0,4,0"/></DockPanel></Border></Grid>
</UserControl>
