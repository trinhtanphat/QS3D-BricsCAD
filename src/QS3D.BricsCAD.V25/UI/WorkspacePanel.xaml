<UserControl x:Class="QS3D.BricsCAD.V25.UI.WorkspacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="485" MinHeight="520">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="PropertyTextEditor">
                <TextBox Text="{Binding Value, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         MinHeight="22" Padding="5,2"/>
            </DataTemplate>
            <DataTemplate x:Key="PropertyBooleanEditor">
                <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsEditable}"
                          VerticalAlignment="Center" HorizontalAlignment="Left"
                          ToolTip="Bật / Tắt"/>
            </DataTemplate>
            <DataTemplate x:Key="PropertyChoiceEditor">
                <ComboBox ItemsSource="{Binding Choices}"
                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                          IsEditable="True" IsEnabled="{Binding IsEditable}"
                          MinHeight="22" Padding="3,0"
                          ToolTip="Chọn giá trị đã dùng hoặc nhập giá trị mới"/>
            </DataTemplate>

            <Style x:Key="WorkspaceCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="7"/>
            </Style>
            <Style x:Key="WorkspaceBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="6,1"/>
                <Setter Property="Margin" Value="4,0,0,0"/>
            </Style>
            <Style x:Key="WorkspaceToolbarBand" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Bg2Brush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="31"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1Brush}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="QS3D" FontWeight="Bold" FontSize="13.5"/>
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                            Padding="6,1" Margin="7,0,0,0">
                        <TextBlock Text="V25" Foreground="White" FontWeight="SemiBold" FontSize="9"/>
                    </Border>
                    <Border Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="5,0,0,0">
                        <TextBlock Text="BIM WORKSPACE" Style="{StaticResource Caption}"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Status}"
                           Style="{StaticResource Caption}" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"
                           Margin="10,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="3D" ToolTip="Góc nhìn 3D isometric"
                            Click="OnViewModel3DClick" Style="{StaticResource DenseButton}"/>
                    <Button Content="Xoay 3D" ToolTip="Orbit mô hình BricsCAD thật"
                            Click="OnOrbitClick" Style="{StaticResource DenseButton}"/>
                    <Button Content="Zoom chọn" ToolTip="Zoom tới đối tượng đang chọn"
                            Click="OnZoomSelectionClick" Style="{StaticResource DenseButton}"/>
                    <Button Content="Lưu" ToolTip="Lưu project QS3D"
                            Click="OnSaveClick" Style="{StaticResource AccentButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" MinWidth="125"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="188" MinWidth="150"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="145"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Bg1Brush}"
                    BorderThickness="0,0,1,0" Padding="7">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Border Style="{StaticResource WorkspaceCard}" Background="{StaticResource Bg2Brush}"
                                Margin="0,0,0,7">
                            <StackPanel>
                                <TextBlock Text="PHẠM VI LÀM VIỆC" Style="{StaticResource PanelTitle}"/>
                                <TextBlock Text="Zone" Style="{StaticResource Caption}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="ZoneCombo" ItemsSource="{Binding Zones}"
                                          SelectionChanged="OnZoneChanged"/>
                                <TextBlock Text="Tầng" Style="{StaticResource Caption}" Margin="0,6,0,2"/>
                                <ComboBox x:Name="FloorCombo" ItemsSource="{Binding Floors}"
                                          SelectionChanged="OnFloorChanged"/>
                            </StackPanel>
                        </Border>
                        <DockPanel Margin="0,0,0,5">
                            <TextBlock Text="MÔ HÌNH" Style="{StaticResource PanelTitle}" Margin="0"/>
                            <Button DockPanel.Dock="Right" Content="Làm mới"
                                    ToolTip="Làm mới project, Xref và layer"
                                    Click="OnRefreshClick" Style="{StaticResource DenseButton}"/>
                        </DockPanel>
                    </StackPanel>

                    <TreeView x:Name="ModelTree" SelectedItemChanged="OnModelTreeSelectedItemChanged">
                        <TreeViewItem Header="Lưới Trục" Tag="Grid"/>
                        <TreeViewItem Header="HT_Phòng" IsExpanded="True">
                            <TreeViewItem Header="Phòng" Tag="Room" IsSelected="True"/>
                            <TreeViewItem Header="Sàn Hoàn Thiện" Tag="FloorFinish"/>
                            <TreeViewItem Header="Chống Thấm" Tag="Waterproofing"/>
                            <TreeViewItem Header="Chân Tường" Tag="Skirting"/>
                            <TreeViewItem Header="Hoàn Thiện Tường" Tag="WallFinish"/>
                            <TreeViewItem Header="Trần Hoàn Thiện" Tag="CeilingFinish"/>
                            <TreeViewItem Header="Lan Can" Tag="Railing"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Dầm" Tag="Beam"/>
                        <TreeViewItem Header="Sàn" Tag="Slab"/>
                        <TreeViewItem Header="Cột" Tag="Column"/>
                        <TreeViewItem Header="Vách" Tag="StructuralWall"/>
                        <TreeViewItem Header="Tường KT" IsExpanded="True">
                            <TreeViewItem Header="Tường Gạch" Tag="ArchitecturalWall"/>
                            <TreeViewItem Header="Vách Kính" Tag="GlassWall"/>
                            <TreeViewItem Header="Trụ Tường" Tag="WallPier"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Cửa" IsExpanded="True">
                            <TreeViewItem Header="Lỗ Mở Vách" Tag="WallOpening"/>
                            <TreeViewItem Header="Cửa Đi" Tag="Door"/>
                        </TreeViewItem>
                        <TreeViewItem Header="Cầu Thang" Tag="Stair"/>
                        <TreeViewItem Header="Móng" Tag="Foundation"/>
                        <TreeViewItem Header="Đào đắp" Tag="Earthwork"/>
                        <TreeViewItem Header="KL Tùy chỉnh" Tag="CustomQuantity"/>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4"
                          Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Background="{StaticResource Bg1Brush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" MinHeight="155"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="0,0,1,1" Padding="7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock Text="FAMILY / TYPE" Style="{StaticResource PanelTitle}"/>
                                <Border DockPanel.Dock="Right" Style="{StaticResource WorkspaceBadge}">
                                    <TextBlock Text="{Binding Families.Count, StringFormat={}{0} mục}"
                                               Style="{StaticResource Caption}"/>
                                </Border>
                            </DockPanel>

                            <WrapPanel>
                                <Button Content="+ Thêm" Style="{StaticResource AccentButton}"
                                        Click="OnAddClick" ToolTip="Tạo Family / Type mới"/>
                                <Button Content="Xóa" Style="{StaticResource DangerButton}"
                                        Click="OnDeleteClick" ToolTip="Xóa Family / Type đang chọn"/>
                                <Button Content="Bóc chọn" Click="OnCaptureSelectedClick"
                                        ToolTip="Ghi đối tượng CAD đang chọn vào đúng nhóm mô hình/Family hiện tại"/>
                                <Button Content="Vẽ 3D" Click="OnView3DClick"
                                        ToolTip="Tạo hoặc cập nhật hình học 3D native cho cấu kiện đang chọn"/>
                            </WrapPanel>

                            <Border Style="{StaticResource WorkspaceToolbarBand}">
                                <WrapPanel>
                                    <Button Content="Giao tường" Click="OnWallJunctionsClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Phân tích giao tim tường L / T / X trong selection"/>
                                    <Button Content="Snap xem" Click="OnWallSnapPreviewClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Xem trước kế hoạch làm sạch đầu mút tim tường; chưa sửa CAD"/>
                                    <Button Content="Snap áp" Click="OnWallSnapApplyClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Áp dụng đúng preview snap còn hợp lệ; từ chối preview cũ/stale"/>
                                    <Button Content="Auto Host" Click="OnAutoHostClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Tự ghép Cửa/Lỗ đang chọn với wall host an toàn; không tự khoét solid"/>
                                </WrapPanel>
                            </Border>

                            <TextBlock Text="Tìm Family / Type" Style="{StaticResource Caption}"
                                       Margin="1,6,1,2"/>
                            <TextBox x:Name="FamilySearch"
                                     ToolTip="Tìm theo tên Family hoặc loại cấu kiện"
                                     TextChanged="OnFamilySearchChanged"/>
                        </StackPanel>

                        <ListBox x:Name="FamilyList" ItemsSource="{Binding Families}"
                                 SelectionChanged="OnFamilySelectionChanged"
                                 DisplayMemberPath="Name"/>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4"
                              Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch"/>

                <Border Grid.Row="2" BorderThickness="0,1,1,0" Padding="7">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="THUỘC TÍNH" Style="{StaticResource PanelTitle}" Margin="0"/>
                                <TextBlock Text="{Binding SelectedFamilyName}"
                                           Style="{StaticResource Caption}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedFamilyName}"
                                           MaxWidth="126"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right">
                                <TextBlock Text="Phạm vi sửa" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                <ComboBox Width="116" MinHeight="22"
                                          ItemsSource="{Binding PropertyScopes}"
                                          SelectedItem="{Binding SelectedPropertyScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="Chọn sửa Family/Type hoặc override của cấu kiện đang chọn"/>
                            </StackPanel>
                        </DockPanel>

                        <ListView x:Name="PropertyList" ItemsSource="{Binding Properties}">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource Bg2Brush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="4,2" Margin="0,4,0,2">
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource GroupHeader}"
                                                           Margin="0"/>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="82"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="29"/>
                                            <ColumnDefinition Width="25"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                        <ContentControl Grid.Column="1" Content="{Binding}">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="ContentTemplate"
                                                            Value="{StaticResource PropertyTextEditor}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="Boolean">
                                                            <Setter Property="ContentTemplate"
                                                                    Value="{StaticResource PropertyBooleanEditor}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EditorKind}" Value="Choice">
                                                            <Setter Property="ContentTemplate"
                                                                    Value="{StaticResource PropertyChoiceEditor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                        <TextBlock Grid.Column="2" Text="{Binding Unit}"
                                                   Style="{StaticResource Caption}"
                                                   Margin="3,0,0,0"/>
                                        <Button Grid.Column="3" Content="↺"
                                                CommandParameter="{Binding}"
                                                Click="OnResetPropertyClick"
                                                ToolTip="Reset override về giá trị Family">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource DenseButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Padding" Value="3,1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanReset}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4"
                          Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="4" Background="{StaticResource Bg1Brush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="218" MinHeight="135"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock Text="HT_PHÒNG" Style="{StaticResource PanelTitle}"/>
                                <Border DockPanel.Dock="Right" Style="{StaticResource WorkspaceBadge}">
                                    <TextBlock x:Name="SelectionCount" Text="0 chọn"
                                               Style="{StaticResource Caption}"/>
                                </Border>
                            </DockPanel>
                            <TextBlock Text="Hoàn thiện theo phòng"
                                       Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                            <WrapPanel>
                                <Button Content="+ Thêm" Style="{StaticResource AccentButton}"
                                        Click="OnAddFinishClick"
                                        ToolTip="Tạo/cập nhật hoàn thiện cho phòng đang chọn"/>
                                <Button Content="Bỏ HT" Style="{StaticResource DangerButton}"
                                        Click="OnRemoveFinishClick"
                                        ToolTip="Chỉ bỏ theo dõi cấu kiện hoàn thiện; giữ nguyên CAD"/>
                                <Button Content="Chọn phòng" Click="OnPickRoomClick"
                                        ToolTip="Chọn phòng trực tiếp trong BricsCAD"/>
                            </WrapPanel>
                        </StackPanel>

                        <TreeView>
                            <TreeViewItem Header="Sàn Hoàn Thiện" Tag="FloorFinish"/>
                            <TreeViewItem Header="Chống Thấm" Tag="Waterproofing"/>
                            <TreeViewItem Header="Chân Tường" Tag="Skirting"/>
                            <TreeViewItem Header="Hoàn Thiện Tường" Tag="WallFinish"/>
                            <TreeViewItem Header="Trần Hoàn Thiện" Tag="CeilingFinish"/>
                        </TreeView>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="4"
                              Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch"/>

                <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="7">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel>
                                <TextBlock Text="ĐỐI TƯỢNG ĐANG CHỌN"
                                           Style="{StaticResource PanelTitle}"/>
                                <TextBlock DockPanel.Dock="Right" Text="CAD + SEMANTIC"
                                           Foreground="{StaticResource LuxuryBrush}"
                                           FontWeight="SemiBold" FontSize="9"
                                           Margin="5,0,0,6"/>
                            </DockPanel>

                            <Border Style="{StaticResource WorkspaceToolbarBand}" Margin="0,0,0,5">
                                <WrapPanel>
                                    <Button Content="Focus" Click="OnFocusSelectedClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Zoom và highlight đối tượng đang chọn"/>
                                    <Button Content="Cô lập" Click="OnIsolateSelectedClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Tạm ẩn các đối tượng khác"/>
                                    <Button Content="Khôi phục" Click="OnUnisolateClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Khôi phục các đối tượng bị isolate"/>
                                    <Button Content="Định vị" Click="OnLocateSelectedClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Định vị đối tượng đang chọn trong bản vẽ"/>
                                    <Button Content="Mặt bằng" Click="OnTopViewClick"
                                            Style="{StaticResource DenseButton}"
                                            ToolTip="Chuyển về góc nhìn mặt bằng"/>
                                </WrapPanel>
                            </Border>
                        </StackPanel>

                        <ListView x:Name="InspectionList">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Handle" Width="62"
                                                    DisplayMemberBinding="{Binding Handle}"/>
                                    <GridViewColumn Header="Loại" Width="82"
                                                    DisplayMemberBinding="{Binding EntityType}"/>
                                    <GridViewColumn Header="Layer" Width="105"
                                                    DisplayMemberBinding="{Binding Layer}"/>
                                    <GridViewColumn Header="Dài" Width="60"
                                                    DisplayMemberBinding="{Binding LengthDrawingUnits}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}"
                BorderThickness="0,1,0,0" Padding="6,3">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Mô hình" Style="{StaticResource AccentButton}"
                            Click="OnViewModel3DClick"/>
                    <Button Content="BQ" Click="OnQuantityClick"
                            ToolTip="Bảng tổng hợp khối lượng"/>
                    <Button Content="Kiểm tra" Click="OnHealthClick"
                            ToolTip="Kiểm tra tính toàn vẹn mô hình"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Text="VIEWPORT BRICSCAD • PAN • ZOOM • ORBIT • PICK"
                           Style="{StaticResource Caption}" Margin="0,0,5,0"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>