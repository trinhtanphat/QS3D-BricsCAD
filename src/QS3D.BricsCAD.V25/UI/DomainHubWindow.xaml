<Window x:Class="QS3D.BricsCAD.V25.UI.DomainHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Trung tâm công việc" Height="720" Width="860"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="14" BorderThickness="0,0,0,1">
            <StackPanel><TextBlock Text="QS3D — TRUNG TÂM CÔNG VIỆC" FontWeight="Bold" FontSize="18"/><TextBlock Text="Mô hình • nhận dạng • cốt thép • khối lượng • revision • template • kiểm soát" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="TƯỜNG KT / CỬA / HT_PHÒNG" Style="{StaticResource SectionLabel}"/>
                    <Button Content="Tường Gạch" Tag="QS3DWALL" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Vách Kính" Tag="QS3DGLASSWALL" Click="OnCommandClick"/>
                    <Button Content="Trụ Tường" Tag="QS3DWALLPIER" Click="OnCommandClick"/>
                    <Button Content="Lỗ Mở Vách" Tag="QS3DOPENING" Click="OnCommandClick"/>
                    <Button Content="Cửa Đi" Tag="QS3DDOOR" Click="OnCommandClick"/>
                    <Button Content="Liên kết Cửa/Lỗ với host" Tag="QS3DLINKHOST" Click="OnCommandClick"/>
                    <Button Content="Khoét Cửa/Lỗ vào solid host" Tag="QS3DCUTOPENINGS" Click="OnCommandClick"/>
                    <Button Content="Tạo / cập nhật HT_Phòng" Tag="QS3DFINISH" Click="OnCommandClick"/>

                    <TextBlock Text="MÔ HÌNH / KẾT CẤU" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                    <Button Content="Phòng Auto từ mạng biên" Tag="QS3DROOMAUTO" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Dầm" Tag="QS3DBEAM" Click="OnCommandClick"/>
                    <Button Content="Sàn kết cấu" Tag="QS3DSLAB" Click="OnCommandClick"/>
                    <Button Content="Cột" Tag="QS3DCOLUMN" Click="OnCommandClick"/>
                    <Button Content="Vách kết cấu" Tag="QS3DSTRUCTWALL" Click="OnCommandClick"/>
                    <Button Content="Móng" Tag="QS3DFOUNDATION" Click="OnCommandClick"/>
                    <Button Content="Cầu thang" Tag="QS3DSTAIR" Click="OnCommandClick"/>
                    <Button Content="Lan can" Tag="QS3DRAILING" Click="OnCommandClick"/>
                    <Button Content="Đào đất" Tag="QS3DEARTHWORK" Click="OnCommandClick"/>
                    <Button Content="Tạo / cập nhật 3D từ đối tượng chọn" Tag="QS3DBUILD3D" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <TextBlock Text="Tường Gạch hỗ trợ LINE hoặc open POLYLINE tim tường (kể cả bulge). Kết cấu dùng LINE/closed POLYLINE theo loại. Phòng Auto dùng LINE/POLYLINE, tự xử lý cung, giao điểm và T-junction." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>

                    <TextBlock Text="DỰ ÁN &amp; TEMPLATE" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                    <Button Content="Lưu project QS3D" Tag="QS3DSAVE" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Nạp Template" Tag="QS3DTEMPLATEIMPORT" Click="OnCommandClick"/>
                    <Button Content="Xuất Template" Tag="QS3DTEMPLATEEXPORT" Click="OnCommandClick"/>
                    <Button Content="Nhật ký thay đổi" Tag="QS3DAUDIT" Click="OnCommandClick"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="NHẬN DẠNG" Style="{StaticResource SectionLabel}"/>
                    <Button Content="Nhận dạng + duyệt kết quả" Tag="QS3DRECOGNIZE" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Tự áp dụng kết quả chắc chắn" Tag="QS3DRECOGNIZEAUTO" Click="OnCommandClick"/>

                    <TextBlock Text="CỐT THÉP / KHỐI LƯỢNG" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"/>
                    <Button Content="Tạo / cập nhật cốt thép cột 3D" Tag="QS3DREBAR3D" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Kiểm tra solid cốt thép 3D" Tag="QS3DREBARHEALTH" Click="OnCommandClick"/>
                    <Button Content="Xem bảng cốt thép" Tag="QS3DBBSVIEW" Click="OnCommandClick"/>
                    <Button Content="Xuất BBS Excel" Tag="QS3DBBS" Click="OnCommandClick"/>
                    <Button Content="Xuất BBS CSV UTF-8" Tag="QS3DBBSCSV" Click="OnCommandClick"/>
                    <Button Content="Bảng tổng hợp khối lượng" Tag="QS3DBQ" Click="OnCommandClick"/>

                    <TextBlock Text="BẢN SỬA ĐỔI" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"/>
                    <Button Content="Chốt mốc so sánh" Tag="QS3DREVBASE" Click="OnCommandClick"/>
                    <Button Content="So sánh với mốc" Tag="QS3DREVDIFF" Click="OnCommandClick"/>

                    <TextBlock Text="KIỂM TRA" Style="{StaticResource SectionLabel}" Margin="0,14,0,4"/>
                    <Button Content="Kiểm tra sức khỏe mô hình" Tag="QS3DHEALTH" Click="OnCommandClick"/>
                    <Button Content="Kiểm tra runtime V25" Tag="QS3DRUNTIMEPROBE" Click="OnCommandClick"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0">
            <DockPanel><TextBlock x:Name="StatusText" Text="Chọn một thao tác để gửi lệnh sang BricsCAD." Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/><TextBlock DockPanel.Dock="Right" Text="3D native cần runtime gate V25 thật trước release." Style="{StaticResource Caption}" Margin="12,0,0,0"/></DockPanel>
        </Border>
    </Grid>
</Window>
