<Window x:Class="QS3D.BricsCAD.V25.UI.CommercialQsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Commercial QS" Height="760" Width="1180"
        MinWidth="960" MinHeight="620" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}" Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BgRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="COMMERCIAL QS" FontWeight="Bold" FontSize="20"/>
                    <TextBlock Text="Variation • IPC • Final Account — monetary authority stays in QS3D.Core.Commercial"
                               Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="EXPORT CSV" Padding="18,7" Margin="12,0,0,0"
                        Click="OnExportCommercialCsv" ToolTip="Export the currently validated Core results"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Margin="12,10,12,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SELECTED VARIATION" Style="{StaticResource Caption}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="SelectedVariationContext" Grid.Column="1"
                           Text="No variation selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Margin="12,10,12,10">
            <TabItem Header="VARIATION">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Currency" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="CurrencyBox" Grid.Column="1" Text="VND" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="2" Text="One row: id | description | proposed | approved | status | revision"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="BUILD REGISTER" Padding="14,6" Click="OnBuildVariationRegister"/>
                    </Grid>
                    <TextBox x:Name="VariationLinesBox" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                             Text="VO-001 | Approved additional scope | 120000000 | 120000000 | Approved | R1&#x0a;VO-002 | Pending proposal | 50000000 | 0 | Pending | R1"/>
                    <TextBlock x:Name="VariationSummary" Grid.Row="2" Margin="0,8,0,8" FontWeight="SemiBold"
                               Text="Build the register to validate variations through Core."/>
                    <DataGrid x:Name="VariationGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single"
                              SelectionChanged="OnVariationSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding VariationId}" Width="120"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="240"/>
                            <DataGridTextColumn Header="Proposed" Binding="{Binding ProposedAmount, StringFormat={}{0:N2}}" Width="130"/>
                            <DataGridTextColumn Header="Approved" Binding="{Binding ApprovedAmount, StringFormat={}{0:N2}}" Width="130"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Revision" Binding="{Binding Revision.RevisionId}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="IPC">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="120"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="90"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Certificate ID" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="IpcIdBox" Grid.Column="1" Text="IPC-001" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="2" Text="Progress retention %" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="ProgressRetentionPercentBox" Grid.Column="3" Text="10" Margin="0,0,16,0"/>
                            <Button Grid.Column="5" Content="CREATE IPC" Padding="18,6" Click="OnCreateIpc"/>
                        </Grid>
                        <TextBlock Grid.Row="1" Margin="0,10,0,4"
                                   Text="Progress rows: item id | unit | contract qty | unit rate | previous qty | this-period qty"
                                   Style="{StaticResource Caption}"/>
                        <TextBox x:Name="ProgressLinesBox" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                 Text="BASE | m | 100 | 1000000 | 20 | 30"/>
                        <TextBlock Grid.Row="3" Margin="0,8,0,4"
                                   Text="Variation certification rows: variation id | previous certified | certified this period"
                                   Style="{StaticResource Caption}"/>
                        <TextBox x:Name="IpcVariationLinesBox" Grid.Row="4" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                                 Text="VO-001 | 0 | 30000000"/>
                        <Grid Grid.Row="5" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Var retention" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="VariationRetentionBox" Grid.Column="1" Text="0" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="2" Text="Retention release" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="IpcRetentionReleaseBox" Grid.Column="3" Text="0" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="4" Text="Advance recovery" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="AdvanceRecoveryBox" Grid.Column="5" Text="0" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="6" Text="Other deductions" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="IpcOtherDeductionsBox" Grid.Column="7" Text="0" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="8" Text="Previous net" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="PreviousNetCertifiedBox" Grid.Column="9" Text="0"/>
                        </Grid>
                        <TextBlock x:Name="IpcSummary" Grid.Row="6" Margin="0,12,0,0" FontWeight="SemiBold"
                                   Text="Build a Variation register first, then create the IPC through Core." TextWrapping="Wrap"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="FINAL ACCOUNT">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Final Account ID" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FinalAccountIdBox" Grid.Column="1" Text="FA-001" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="Original contract" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="OriginalContractValueBox" Grid.Column="3" Text="1000000000" Margin="0,0,16,0"/>
                        <Button Grid.Column="5" Content="RECONCILE FINAL ACCOUNT" Padding="18,6" Click="OnReconcileFinalAccount"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Final adjustment" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FinalAdjustmentBox" Grid.Column="1" Text="0" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="Previous gross certified" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PreviousGrossCertifiedBox" Grid.Column="3" Text="0" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="4" Text="Final deductions" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FinalDeductionsBox" Grid.Column="5" Text="0"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Retention held" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="RetentionHeldBox" Grid.Column="1" Text="0" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="2" Text="Retention release" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="FinalRetentionReleaseBox" Grid.Column="3" Text="0"/>
                    </Grid>
                    <TextBlock x:Name="FinalAccountSummary" Grid.Row="3" Margin="0,18,0,0" FontWeight="SemiBold"
                               Text="Build a Variation register first, then reconcile through FinalAccountService." TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="{StaticResource BgRaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,7">
            <TextBlock x:Name="StatusText" Text="Commercial workspace ready. No commercial result has been calculated yet."
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
