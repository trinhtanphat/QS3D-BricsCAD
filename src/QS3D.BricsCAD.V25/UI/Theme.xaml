<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgCanvas">#14171A</Color><Color x:Key="BgPanel">#1B1F23</Color><Color x:Key="BgElevated">#23282E</Color><Color x:Key="BgHover">#2A3037</Color>
    <Color x:Key="BorderWeak">#30363D</Color><Color x:Key="BorderStrong">#414952</Color><Color x:Key="TextPrimary">#EEF1F4</Color><Color x:Key="TextSecondary">#9DA7B1</Color>
    <Color x:Key="Accent">#2F80ED</Color><Color x:Key="AccentHover">#4A94F3</Color><Color x:Key="Success">#2EA66F</Color><Color x:Key="Warning">#D69E2E</Color><Color x:Key="Danger">#D84A43</Color>
    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource BgCanvas}"/><SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource BgPanel}"/><SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource BgElevated}"/><SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHover}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderWeak}"/><SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrong}"/><SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimary}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/><SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/><SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/><SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/><SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>

    <Style TargetType="{x:Type UserControl}"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="SnapsToDevicePixels" Value="True"/></Style>
    <Style TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="{x:Type Border}"><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
    <Style TargetType="{x:Type Separator}"><Setter Property="Background" Value="{StaticResource BorderBrush}"/></Style>

    <Style x:Key="ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="1"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource BgHoverBrush}"/><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Setter Property="Foreground" Value="#FFE9E7"/><Setter Property="Background" Value="#442421"/><Setter Property="BorderBrush" Value="#713732"/></Style>
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ToolbarButton}"/>

    <Style TargetType="{x:Type ComboBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource BgElevated}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter Property="Padding" Value="5,3"/><Setter Property="MinHeight" Value="27"/></Style>
    <Style TargetType="{x:Type TextBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource BgCanvas}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="27"/></Style>
    <Style TargetType="{x:Type TreeView}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/></Style>
    <Style TargetType="{x:Type TreeViewItem}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="3,2"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style TargetType="{x:Type ListView}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/></Style>
    <Style TargetType="{x:Type ListBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="{x:Type CheckBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="3,2"/></Style>
    <Style TargetType="{x:Type DataGrid}"><Setter Property="RowBackground" Value="{StaticResource BgPanel}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource BgElevated}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,10,0,5"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="10.5"/></Style>
    <Style x:Key="PropertyGrid" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,3"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource BgPanel}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Padding" Value="8"/></Style>
</ResourceDictionary>
