<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Bg0">#17191C</Color><Color x:Key="Bg1">#1D2024</Color><Color x:Key="Bg2">#24282D</Color><Color x:Key="Border">#343A41</Color><Color x:Key="Text">#E7EAED</Color><Color x:Key="Muted">#98A1AA</Color><Color x:Key="Accent">#2E78D6</Color><Color x:Key="Danger">#CF3D31</Color>
    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}"/><SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}"/><SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}"/><SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/><SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}"/><SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/><SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}"/>
    <Style TargetType="{x:Type UserControl}"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    <Style TargetType="{x:Type TextBlock}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style TargetType="{x:Type Border}"><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
    <Style TargetType="{x:Type Button}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource Bg2Brush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="2"/></Style>
    <Style TargetType="{x:Type ComboBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource Bg2Brush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="3"/></Style>
    <Style TargetType="{x:Type TextBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource Bg0Brush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="4"/></Style>
    <Style TargetType="{x:Type TreeView}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource Bg1Brush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="{x:Type TreeViewItem}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Padding" Value="2"/></Style>
    <Style TargetType="{x:Type ListView}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource Bg1Brush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="{x:Type ListBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Background" Value="{StaticResource Bg1Brush}"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="{x:Type CheckBox}"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Margin" Value="2"/></Style>
    <Style TargetType="{x:Type DataGrid}"><Setter Property="RowBackground" Value="{StaticResource Bg1Brush}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource Bg2Brush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/></Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,9,0,4"/></Style>
    <Style x:Key="PropertyGrid" TargetType="Grid"><Setter Property="Margin" Value="0,0,0,2"/></Style>
</ResourceDictionary>
