<Window x:Class="QS3D.BricsCAD.V25.UI.RevisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Bản sửa đổi khối lượng" Height="650" Width="1120"
        MinHeight="500" MinWidth="860" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SO SÁNH BẢN SỬA ĐỔI" FontWeight="Bold" FontSize="18"/>
                        <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="QUANTITY DIFF" Foreground="{StaticResource LuxuryBrush}" FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="Header" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Định vị" Click="OnLocateClick"
                        Style="{StaticResource AccentButton}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="12,10">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" MouseDoubleClick="OnGridDoubleClick" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Cấu kiện" Binding="{Binding ElementId}" Width="170"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="Đại lượng" Binding="{Binding QuantityName}" Width="160"/>
                    <DataGridTextColumn Header="Thay đổi" Binding="{Binding Change}" Width="85"/>
                    <DataGridTextColumn Header="Trước" Binding="{Binding Before, StringFormat=0.###}" Width="90"/>
                    <DataGridTextColumn Header="Sau" Binding="{Binding After, StringFormat=0.###}" Width="90"/>
                    <DataGridTextColumn Header="Chênh lệch" Binding="{Binding Delta, StringFormat=0.###}" Width="90"/>
                    <DataGridTextColumn Header="Chênh lệch %" Binding="{Binding PercentChange, StringFormat=0.##}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="11,7">
            <DockPanel>
                <Border Background="{StaticResource AccentHoverBrush}" CornerRadius="5" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="Totals" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock DockPanel.Dock="Right" Text="DOUBLE-CLICK ROW TO LOCATE" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>