<Window x:Class="QS3D.BricsCAD.V25.UI.RevisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Bản sửa đổi ngữ nghĩa &amp; khối lượng" Height="690" Width="1160"
        MinHeight="520" MinWidth="900" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BgRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource LuxuryBrush}"
                        CornerRadius="2" Margin="0,2,0,2"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SO SÁNH BẢN SỬA ĐỔI" FontWeight="Bold" FontSize="18"/>
                        <Border Style="{StaticResource StatusPill}" Margin="8,0,0,0">
                            <TextBlock Text="SEMANTIC + QUANTITY"
                                       Foreground="{StaticResource LuxuryBrush}"
                                       FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="Header" Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Style="{StaticResource StatusPill}" Margin="0,0,7,0">
                        <TextBlock Text="READ-ONLY REVIEW" Style="{StaticResource Caption}"
                                   FontWeight="SemiBold"/>
                    </Border>
                    <Button Content="Định vị" Click="OnLocateClick"
                            Style="{StaticResource AccentButton}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PremiumCard}" Padding="0" Margin="12,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BgRaisedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,7">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource LuxuryBrush}" CornerRadius="2"
                                    Width="3" Height="15" Margin="0,0,7,0"/>
                            <TextBlock Text="REVISION REVIEW" Style="{StaticResource GroupHeader}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="COMPARE • INSPECT • LOCATE"
                                   Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <TabControl x:Name="Tabs" Grid.Row="1" BorderThickness="0" Background="Transparent">
                    <TabItem Header="Khối lượng">
                        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" MouseDoubleClick="OnGridDoubleClick" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cấu kiện" Binding="{Binding ElementId}" Width="170"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="120"/>
                                <DataGridTextColumn Header="Đại lượng" Binding="{Binding QuantityName}" Width="160"/>
                                <DataGridTextColumn Header="Thay đổi" Binding="{Binding Change}" Width="85"/>
                                <DataGridTextColumn Header="Trước" Binding="{Binding Before, StringFormat=0.###}" Width="90"/>
                                <DataGridTextColumn Header="Sau" Binding="{Binding After, StringFormat=0.###}" Width="90"/>
                                <DataGridTextColumn Header="Chênh lệch" Binding="{Binding Delta, StringFormat=0.###}" Width="90"/>
                                <DataGridTextColumn Header="Chênh lệch %" Binding="{Binding PercentChange, StringFormat=0.##}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Ngữ nghĩa">
                        <DataGrid x:Name="SemanticGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" MouseDoubleClick="OnSemanticGridDoubleClick" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Cấu kiện" Binding="{Binding ElementId}" Width="180"/>
                                <DataGridTextColumn Header="Loại" Binding="{Binding Category}" Width="135"/>
                                <DataGridTextColumn Header="Thay đổi" Binding="{Binding Change}" Width="95"/>
                                <DataGridTextColumn Header="Identity" Binding="{Binding IdentityChangeCount}" Width="85"/>
                                <DataGridTextColumn Header="Property" Binding="{Binding PropertyChangeCount}" Width="85"/>
                                <DataGridTextColumn Header="Quantity" Binding="{Binding QuantityChangeCount}" Width="85"/>
                                <DataGridTextColumn Header="Source ref (ẩn)" Binding="{Binding OmittedSourceReferenceChangeCount}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource BgRaisedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="11,7">
            <DockPanel LastChildFill="True">
                <Border Background="{StaticResource AccentHoverBrush}" CornerRadius="5"
                        Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <Border DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                    <TextBlock Text="DOUBLE-CLICK ROW TO LOCATE" Style="{StaticResource Caption}"
                               FontWeight="SemiBold"/>
                </Border>
                <TextBlock x:Name="Totals" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
