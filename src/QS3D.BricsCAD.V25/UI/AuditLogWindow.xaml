<Window x:Class="QS3D.BricsCAD.V25.UI.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Nhật ký thay đổi" Height="600" Width="1020"
        MinWidth="820" MinHeight="480" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="NHẬT KÝ THAY ĐỔI" FontWeight="Bold" FontSize="18"/>
                    <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                        <TextBlock Text="AUDIT TRAIL" Foreground="{StaticResource LuxuryBrush}" FontWeight="SemiBold" FontSize="9"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Theo dõi thao tác project, template và workflow QS3D"
                           Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8" Margin="12,10,12,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="Tìm nhật ký" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBox x:Name="SearchBox" Grid.Column="1"
                         ToolTip="Tìm action, element, nội dung, actor hoặc correlation id"
                         TextChanged="OnSearchChanged"/>
                <TextBlock Grid.Column="2" Text="Action • Element • Detail • Actor • Correlation"
                           Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" Margin="12,10">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Thời gian UTC" Binding="{Binding Utc, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145"/>
                    <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="150"/>
                    <DataGridTextColumn Header="Element" Binding="{Binding ElementId}" Width="120"/>
                    <DataGridTextColumn Header="Nội dung" Binding="{Binding Detail}" Width="*" MinWidth="240"/>
                    <DataGridTextColumn Header="Người thực hiện" Binding="{Binding Actor}" Width="120"/>
                    <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="135"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource Bg1Brush}" BorderThickness="0,1,0,0" Padding="11,7">
            <DockPanel>
                <Border Background="{StaticResource AccentHoverBrush}" CornerRadius="5" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="Summary" FontWeight="SemiBold"/>
                <TextBlock DockPanel.Dock="Right" Text="MỚI NHẤT HIỂN THỊ TRƯỚC" Style="{StaticResource Caption}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>