<Window x:Class="QS3D.BricsCAD.V25.UI.ProjectToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Thiết lập dự án" Width="720" Height="690"
        WindowStartupLocation="CenterOwner" Background="#17191C">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource Bg1Brush}" Padding="16" BorderThickness="0,0,0,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="THIẾT LẬP DỰ ÁN" FontSize="20" FontWeight="Bold"/><TextBlock Text="Tầng • Zone • Family • vật liệu • template • module chuyên ngành • sức khỏe mô hình" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Tag="QS3DREFRESH" Click="OnCommandClick" Margin="8,0,0,0"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="PROJECT SNAPSHOT" Style="{StaticResource SectionLabel}"/>
                <Border Background="{StaticResource Bg1Brush}" Padding="12" Margin="0,0,0,14">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock Text="Dự án" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ProjectNameText" Text="—" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Tầng active" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="FloorText" Text="—" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Family" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="FamilyCountText" Text="0" FontWeight="SemiBold"/></StackPanel>
                        <StackPanel Grid.Column="3"><TextBlock Text="Cấu kiện" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ElementCountText" Text="0" FontWeight="SemiBold"/></StackPanel>
                    </Grid>
                </Border>
                <TextBlock Text="DỮ LIỆU DỰ ÁN" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="Tầng / Cao độ" Tag="QS3DLEVELS" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Khu vực / Zone" Tag="QS3DZONES" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Family Manager" Tag="QS3DFAMILIES" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Material Catalog" Tag="QS3DMATERIALS" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Xuất bảng vật liệu" Tag="QS3DMATERIALXLSX" Click="OnCommandClick"/>
                    <Button Content="Xuất Template" Tag="QS3DTEMPLATEEXPORT" Click="OnCommandClick"/>
                    <Button Content="Nạp Template" Tag="QS3DTEMPLATEIMPORT" Click="OnCommandClick"/>
                    <Button Content="Lưu project" Tag="QS3DSAVE" Click="OnCommandClick"/>
                    <Button Content="Nạp lại project" Tag="QS3DRELOAD" Click="OnCommandClick"/>
                </UniformGrid>
                <TextBlock Text="MODULE CHUYÊN NGÀNH" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2" Margin="0,0,0,14">
                    <Button Content="Schedule / Bóc khối lượng" Tag="QS3DSCHEDULES" Style="{StaticResource AccentButton}" Click="OnCommandClick"/>
                    <Button Content="Vách Kính / Curtain" Tag="QS3DCURTAIN" Click="OnCommandClick"/>
                    <Button Content="Geometry Extensions" Tag="QS3DGEOMETRYEXT" Click="OnCommandClick"/>
                    <Button Content="Rebar 3D Hub" Tag="QS3DREBARHUB" Click="OnCommandClick"/>
                    <Button Content="Bảng khối lượng" Tag="QS3DBQ" Click="OnCommandClick"/>
                </UniformGrid>
                <TextBlock Text="KIỂM TRA / BẢO TRÌ" Style="{StaticResource SectionLabel}"/>
                <UniformGrid Columns="2"><Button Content="Regenerate dirty" Tag="QS3DREGEN" Click="OnCommandClick"/><Button Content="Health All" Tag="QS3DHEALTHALL" Style="{StaticResource AccentButton}" Click="OnCommandClick"/><Button Content="Audit log" Tag="QS3DAUDIT" Click="OnCommandClick"/><Button Content="Workspace" Tag="QS3D" Click="OnCommandClick"/></UniformGrid>
                <TextBlock Text="Cửa sổ này khóa theo bản vẽ đã mở. Nếu chuyển sang DWG khác, các nút command sẽ từ chối chạy. Tầng/Zone/Family/Material sửa semantic/project data; generated geometry liên quan được đánh stale thay vì âm thầm sửa CAD source." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="10" BorderThickness="0,1,0,0"><TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/></Border>
    </Grid>
</Window>
