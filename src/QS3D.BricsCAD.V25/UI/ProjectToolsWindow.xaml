<Window x:Class="QS3D.BricsCAD.V25.UI.ProjectToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QS3D • Thiết lập dự án" Width="900" Height="760"
        MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProjectCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
            <Style x:Key="ProjectMetric" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Padding" Value="9,7"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
            <Style x:Key="ProjectCommand" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
            <Style x:Key="ProjectAccentCommand" TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="29"/>
                <Setter Property="Margin" Value="3"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Bg1Brush}" Padding="16,12" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="THIẾT LẬP DỰ ÁN" FontSize="18" FontWeight="Bold"/>
                        <Border Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="7,1" Margin="8,0,0,0">
                            <TextBlock Text="PROJECT CONTROL" Foreground="{StaticResource LuxuryBrush}"
                                       FontWeight="SemiBold" FontSize="9"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tầng • Zone • Family • vật liệu • trạng thái semantic • module • sức khỏe mô hình"
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Làm mới" Tag="QS3DREFRESH"
                        Click="OnCommandClick" Style="{StaticResource DenseButton}"
                        VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">
                <Border Style="{StaticResource ProjectCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="PROJECT SNAPSHOT" Style="{StaticResource PanelTitle}" Margin="0"/>
                            <TextBlock DockPanel.Dock="Right" Text="LIVE • READ-ONLY"
                                       Foreground="{StaticResource LuxuryBrush}" FontSize="9" FontWeight="SemiBold"/>
                        </DockPanel>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="DỰ ÁN" Style="{StaticResource Caption}"/><TextBlock x:Name="ProjectNameText" Text="—" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="ZONE ACTIVE" Style="{StaticResource Caption}"/><TextBlock x:Name="ZoneText" Text="—" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="TẦNG ACTIVE" Style="{StaticResource Caption}"/><TextBlock x:Name="FloorText" Text="—" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="DRAWING UNIT" Style="{StaticResource Caption}"/><TextBlock x:Name="UnitText" Text="—" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
                        </UniformGrid>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="ZONE" Style="{StaticResource Caption}"/><TextBlock x:Name="ZoneCountText" Text="0" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="TẦNG" Style="{StaticResource Caption}"/><TextBlock x:Name="FloorCountText" Text="0" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="FAMILY" Style="{StaticResource Caption}"/><TextBlock x:Name="FamilyCountText" Text="0" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource AccentHoverBrush}" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="CẤU KIỆN" Style="{StaticResource Caption}"/><TextBlock x:Name="ElementCountText" Text="0" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0"/></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProjectCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="PROJECT READINESS" Style="{StaticResource PanelTitle}" Margin="0"/>
                                <TextBlock x:Name="ReadinessText" Text="Đang đọc trạng thái project…" Style="{StaticResource Caption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Top">
                                <TextBlock x:Name="ReadinessBadgeText" Text="READ-ONLY" Foreground="{StaticResource LuxuryBrush}" FontSize="9" FontWeight="SemiBold"/>
                            </Border>
                        </DockPanel>
                        <UniformGrid Columns="5">
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="DIRTY" Style="{StaticResource Caption}"/><TextBlock x:Name="DirtyCountText" Text="0" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="HÌNH HỌC" Style="{StaticResource Caption}"/><TextBlock x:Name="GeometryDirtyCountText" Text="0" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="KHỐI LƯỢNG" Style="{StaticResource Caption}"/><TextBlock x:Name="QuantityDirtyCountText" Text="0" FontWeight="SemiBold" FontSize="16" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="CHANGE VERSION" Style="{StaticResource Caption}"/><TextBlock x:Name="ChangeVersionText" Text="0" FontWeight="SemiBold" FontSize="14" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource ProjectMetric}"><StackPanel><TextBlock Text="CẬP NHẬT" Style="{StaticResource Caption}"/><TextBlock x:Name="UpdatedText" Text="—" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <TextBlock Text="Các chỉ số trên chỉ đọc semantic state hiện hữu; mở/refresh Project Tools không tạo project, không regenerate và không thay đổi dirty state." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="3,6,3,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProjectCard}">
                    <StackPanel>
                        <TextBlock Text="DỮ LIỆU DỰ ÁN" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="Thiết lập dữ liệu nguồn cho toàn bộ workflow BIM/QS." Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                        <UniformGrid Columns="2">
                            <Button Content="Tầng / Cao độ" Tag="QS3DLEVELS" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Khu vực / Zone" Tag="QS3DZONES" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Family Manager" Tag="QS3DFAMILIES" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Material Catalog" Tag="QS3DMATERIALS" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Đồng bộ source CAD đã sửa" Tag="QS3DSYNCSOURCE" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Đơn vị bản vẽ / Drawing Unit" Tag="QS3DUNITS" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Xuất Semantic Snapshot JSON" Tag="QS3DINTERCHANGEJSON" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Kiểm tra Semantic Snapshot JSON" Tag="QS3DINTERCHANGEVALIDATE" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Nạp Snapshot (Chọn policy)" Tag="QS3DINTERCHANGEIMPORT" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick" ToolTip="Append-only khi không collision; khi có collision cho chọn KeepTarget, Replace ALL semantic, Replace Element semantic hoặc Replace Catalog semantic. Import As New là policy giữ cả hai namespace và dùng nút riêng bên dưới."/>
                            <Button Content="Nạp Snapshot (Field Merge)" Tag="QS3DINTERCHANGEFIELDMERGE" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick" ToolTip="Review KeepTarget/UseSource theo từng nhóm field cho same-ID collisions; source-only identity bị chặn. Apply qua một native CAD transaction, giữ target CAD ownership và yêu cầu rebuild explicit sau merge."/>
                            <Button Content="Nạp Snapshot (Append-only)" Tag="QS3DINTERCHANGEAPPEND" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Nạp Snapshot (Replace ALL semantic)" Tag="QS3DINTERCHANGEUSESOURCEALL" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick" ToolTip="Replace executable Zone/Floor/Family/Element collisions từ source trong một CAD transaction; giữ target source CAD ownership, invalidates union generated closure và rebuild explicit."/>
                            <Button Content="Nạp Snapshot (Replace Element semantic)" Tag="QS3DINTERCHANGEUSESOURCE" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick" ToolTip="Thay portable semantic state cho Element trùng ID; giữ source CAD ownership của target, xóa generated outputs bị ảnh hưởng và yêu cầu rebuild explicit."/>
                            <Button Content="Nạp Snapshot (Replace Catalog semantic)" Tag="QS3DINTERCHANGEUSESOURCECATALOG" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick" ToolTip="Dùng source semantic cho Zone/Floor/Family trùng ID; Element collision giữ target. Invalidate generated outputs của element bị ảnh hưởng trong CAD transaction và rebuild explicit."/>
                            <Button Content="Lưu provenance source handles" Tag="QS3DINTERCHANGEPROVENANCE" Style="{StaticResource ProjectCommand}" Click="OnCommandClick" ToolTip="Chỉ lưu source handles vào project metadata để truy vết; không nhận CAD ownership, không thay ProjectElement.SourceHandles và không import semantic."/>
                            <Button Content="Dry-run Import As New remap" Tag="QS3DINTERCHANGEREMAPPLAN" Style="{StaticResource ProjectCommand}" Click="OnCommandClick" ToolTip="Plan candidate ID/name + typed references; không mutate project/DWG. HostWallId được rewrite explicit; property-reference chưa có policy sẽ BLOCK."/>
                            <Button Content="Nạp Snapshot (Import As New)" Tag="QS3DINTERCHANGEREMAPAPPEND" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick" ToolTip="Giữ nguyên target identities; append source thành namespace semantic mới bằng deterministic remap. Semantic-only, re-plan trước apply, strip source handles/native ownership và BLOCK Family/Element ID/ref chưa có policy."/>
                            <Button Content="Xuất bảng vật liệu" Tag="QS3DMATERIALXLSX" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Xuất Template" Tag="QS3DTEMPLATEEXPORT" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Nạp Template" Tag="QS3DTEMPLATEIMPORT" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Lưu project" Tag="QS3DSAVE" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Nạp lại project" Tag="QS3DRELOAD" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProjectCard}">
                    <StackPanel>
                        <TextBlock Text="MODULE CHUYÊN NGÀNH" Style="{StaticResource PanelTitle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Schedule / Bóc khối lượng" Tag="QS3DSCHEDULES" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Vách Kính / Curtain" Tag="QS3DCURTAIN" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Geometry Extensions" Tag="QS3DGEOMETRYEXT" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Rebar 3D Hub" Tag="QS3DREBARHUB" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Bảng khối lượng" Tag="QS3DBQ" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ProjectCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="KIỂM TRA / BẢO TRÌ" Style="{StaticResource PanelTitle}"/>
                        <UniformGrid Columns="2">
                            <Button Content="Regenerate dirty" Tag="QS3DREGEN" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Health All" Tag="QS3DHEALTHALL" Style="{StaticResource ProjectAccentCommand}" Click="OnCommandClick"/>
                            <Button Content="Kiểm tra runtime BricsCAD" Tag="QS3DRUNTIMECHECK" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Audit log" Tag="QS3DAUDIT" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                            <Button Content="Workspace" Tag="QS3D" Style="{StaticResource ProjectCommand}" Click="OnCommandClick"/>
                        </UniformGrid>
                        <TextBlock Text="Cửa sổ khóa theo bản vẽ đã mở. Nếu chuyển DWG, command bị từ chối để tránh sửa nhầm context. Thay đổi Tầng/Zone/Family/Material chỉ cập nhật semantic/project data; generated geometry liên quan được đánh stale thay vì âm thầm sửa CAD source." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="3,8,3,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource Bg1Brush}" Padding="11,7" BorderThickness="0,1,0,0">
            <DockPanel>
                <Border Background="{StaticResource SuccessBrush}" CornerRadius="5" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="StatusText" Text="Sẵn sàng" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock DockPanel.Dock="Right" Text="PROJECT-SAFE • READ-ONLY SNAPSHOT • DWG CONTEXT LOCK" Style="{StaticResource Caption}" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>