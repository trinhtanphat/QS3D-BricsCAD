<UserControl x:Class="QS3D.BricsCAD.V25.UI.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="240" MinHeight="320"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="Qs3dPropertyTextEditor">
                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         IsReadOnly="{Binding IsReadOnly}"
                         MinHeight="24" Padding="5,2"
                         ToolTip="{Binding Value}"/>
            </DataTemplate>
            <DataTemplate x:Key="Qs3dPropertyBooleanEditor">
                <Border MinHeight="24" Padding="4,0" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding IsEditable}"
                              VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="Qs3dPropertyChoiceEditor">
                <ComboBox ItemsSource="{Binding Choices}"
                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                          IsEditable="True" IsEnabled="{Binding IsEditable}"
                          MinHeight="24" Padding="4,0"/>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource Bg0Brush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Bg1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,7">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="QS3D PROPERTIES" Style="{StaticResource PanelTitle}" Margin="0"/>
                    <TextBlock Text="Thuộc tính semantic của QS3D — không phải BricsCAD Properties"
                               Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource Bg2Brush}"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="6,2" Margin="6,0,0,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="QS3D" FontWeight="SemiBold" FontSize="9"/>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource Bg1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,6">
            <StackPanel>
                <TextBlock Text="{Binding SelectedFamilyName}"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SelectedFamilyName}"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Phạm vi sửa" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <ComboBox Grid.Column="1" MinHeight="24"
                              ItemsSource="{Binding PropertyScopes}"
                              SelectedItem="{Binding SelectedPropertyScope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Family/Type hoặc Instance đang chọn"/>
                </Grid>
            </StackPanel>
        </Border>

        <ListView Grid.Row="2" ItemsSource="{Binding Properties}"
                  BorderThickness="0" Background="{StaticResource Bg0Brush}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Bg2Brush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,1" Padding="7,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="10"/>
                            </Border>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="108"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" ToolTip="{Binding Name}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding StateLabel}" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding Unit}" Style="{StaticResource Caption}" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{StaticResource Qs3dPropertyTextEditor}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorKind}" Value="Boolean">
                                                <Setter Property="ContentTemplate" Value="{StaticResource Qs3dPropertyBooleanEditor}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EditorKind}" Value="Choice">
                                                <Setter Property="ContentTemplate" Value="{StaticResource Qs3dPropertyChoiceEditor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>

                            <Button Grid.Column="2" Content="↺" Margin="5,0,0,0" Padding="5,1"
                                    IsEnabled="{Binding CanReset}" Click="OnResetClick"
                                    ToolTip="Bỏ override và dùng lại giá trị Family"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="3" Background="{StaticResource Bg1Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="7,4">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
