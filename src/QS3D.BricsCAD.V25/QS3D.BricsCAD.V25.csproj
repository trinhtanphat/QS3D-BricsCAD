<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>Library</OutputType>
    <AssemblyName>QS3D.BricsCAD.V25</AssemblyName>
    <RootNamespace>QS3D.BricsCAD.V25</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0-preview.10078</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.10078</FileVersion>
    <InformationalVersion>0.1.0-preview.10078</InformationalVersion>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\QS3D.Core\QS3D.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Reference Include="BrxMgd"><HintPath>$(BRICSCAD_V25_DIR)\BrxMgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TD_Mgd"><HintPath>$(BRICSCAD_V25_DIR)\TD_Mgd.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TD_MgdBrep"><HintPath>$(BRICSCAD_V25_DIR)\TD_MgdBrep.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateBricsCadReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(BRICSCAD_V25_DIR)' == ''" Text="BRICSCAD_V25_DIR is not set. Point it to the licensed BricsCAD V25 installation directory." />
    <Error Condition="!Exists('$(BRICSCAD_V25_DIR)\BrxMgd.dll')" Text="BrxMgd.dll not found under BRICSCAD_V25_DIR." />
    <Error Condition="!Exists('$(BRICSCAD_V25_DIR)\TD_Mgd.dll')" Text="TD_Mgd.dll not found under BRICSCAD_V25_DIR." />
    <Error Condition="!Exists('$(BRICSCAD_V25_DIR)\TD_MgdBrep.dll')" Text="TD_MgdBrep.dll not found under BRICSCAD_V25_DIR; BREP quantity explanation requires the licensed V25 BREP API assembly." />
  </Target>
</Project>
